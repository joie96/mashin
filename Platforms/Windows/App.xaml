<maui:MauiWinUIApplication
    x:Class="mashin.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maui="using:Microsoft.Maui">

    <maui:MauiWinUIApplication.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- ============================================ -->
                <!-- DARK THEME                                   -->
                <!-- ============================================ -->
                <ResourceDictionary x:Key="Dark">
                    <!-- Theme-Farben für Dark Mode -->
                    <Color x:Key="BackgroundPrimary">#0a0a0a</Color>
                    <Color x:Key="BackgroundSecondary">#141414</Color>
                    <Color x:Key="TextPrimary">#ffffff</Color>
                    <Color x:Key="TextSecondary">#dddddd</Color>
                    <Color x:Key="HoverBackground">#2a2a2a</Color>
                    <Color x:Key="SelectionBackground">#3a3a3a</Color>
                    <Color x:Key="SeparatorColor">#2a2a2a</Color>

                    <!-- MenuFlyout Styles -->
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource BackgroundSecondary}"/>
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="Transparent"/>

                    <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="{StaticResource TextSecondary}"/>
                    <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="Transparent"/>

                    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="{StaticResource TextPrimary}"/>
                    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{StaticResource HoverBackground}"/>

                    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="{StaticResource TextPrimary}"/>
                    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="{StaticResource SelectionBackground}"/>

                    <SolidColorBrush x:Key="MenuFlyoutSeparatorBackground" Color="{StaticResource SeparatorColor}"/>
                </ResourceDictionary>

                <!-- ============================================ -->
                <!-- LIGHT THEME                                  -->
                <!-- ============================================ -->
                <ResourceDictionary x:Key="Light">
                    <!-- Theme-Farben für Light Mode -->
                    <Color x:Key="BackgroundPrimary">#ffffff</Color>
                    <Color x:Key="BackgroundSecondary">#f5f5f5</Color>
                    <Color x:Key="TextPrimary">#000000</Color>
                    <Color x:Key="TextSecondary">#666666</Color>
                    <Color x:Key="HoverBackground">#eeeeee</Color>
                    <Color x:Key="SelectionBackground">#e0e0e0</Color>
                    <Color x:Key="SeparatorColor">#dddddd</Color>

                    <!-- MenuFlyout Styles -->
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource BackgroundSecondary}"/>
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="Transparent"/>

                    <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="{StaticResource TextSecondary}"/>
                    <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="Transparent"/>

                    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="{StaticResource TextPrimary}"/>
                    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{StaticResource HoverBackground}"/>

                    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="{StaticResource TextPrimary}"/>
                    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="{StaticResource SelectionBackground}"/>

                    <SolidColorBrush x:Key="MenuFlyoutSeparatorBackground" Color="{StaticResource SeparatorColor}"/>
                </ResourceDictionary>

                <!-- ============================================ -->
                <!-- DEFAULT THEME (Fallback)                     -->
                <!-- ============================================ -->
                <ResourceDictionary x:Key="Default">
                    <!-- Verwendet Dark als Standard -->
                    <Color x:Key="BackgroundPrimary">#0a0a0a</Color>
                    <Color x:Key="BackgroundSecondary">#141414</Color>
                    <Color x:Key="TextPrimary">#ffffff</Color>
                    <Color x:Key="TextSecondary">#dddddd</Color>
                    <Color x:Key="HoverBackground">#2a2a2a</Color>
                    <Color x:Key="SelectionBackground">#3a3a3a</Color>
                    <Color x:Key="SeparatorColor">#2a2a2a</Color>

                    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource BackgroundSecondary}"/>
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="Transparent"/>

                    <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="{StaticResource TextSecondary}"/>
                    <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="Transparent"/>

                    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="{StaticResource TextPrimary}"/>
                    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{StaticResource HoverBackground}"/>

                    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="{StaticResource TextPrimary}"/>
                    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="{StaticResource SelectionBackground}"/>

                    <SolidColorBrush x:Key="MenuFlyoutSeparatorBackground" Color="{StaticResource SeparatorColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </maui:MauiWinUIApplication.Resources>
</maui:MauiWinUIApplication>
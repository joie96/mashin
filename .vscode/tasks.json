{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Rust Mashin Engine: Android arm64 Debug",
      "type": "shell",
      "command": "& '${workspaceFolder}/scripts/build_mashin_engine.ps1' -Profile Debug -PlatformSelection AndroidArm64",
      "problemMatcher": []
    },
    {
      "label": "Rust Mashin Engine: Windows x64 Debug",
      "type": "shell",
      "command": "& '${workspaceFolder}/scripts/build_mashin_engine.ps1' -Profile Debug -PlatformSelection WindowsX64",
      "problemMatcher": []
    },
    {
      "label": "Rust Mashin Engine: Windows arm64 Debug",
      "type": "shell",
      "command": "& '${workspaceFolder}/scripts/build_mashin_engine.ps1' -Profile Debug -PlatformSelection WindowsArm64",
      "problemMatcher": []
    },
    {
      "label": "Rust Mashin Engine: Windows x64 Release",
      "type": "shell",
      "command": "& '${workspaceFolder}/scripts/build_mashin_engine.ps1' -Profile Release -PlatformSelection WindowsX64",
      "problemMatcher": []
    },
    {
      "label": "Rust Mashin Engine: Windows arm64 Release",
      "type": "shell",
      "command": "& '${workspaceFolder}/scripts/build_mashin_engine.ps1' -Profile Release -PlatformSelection WindowsArm64",
      "problemMatcher": []
    },
    {
      "label": "Rust Mashin Engine: Android arm64 Release",
      "type": "shell",
      "command": "& '${workspaceFolder}/scripts/build_mashin_engine.ps1' -Profile Release -PlatformSelection AndroidArm64",
      "problemMatcher": []
    },
    {
      "label": "Release Build: Android APK",
      "type": "shell",
      "command": "flutter",
      "args": [
        "build",
        "apk",
        "--release"
      ],
      "dependsOn": "Rust Mashin Engine: Android arm64 Release",
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Release Build: Windows x64 EXE",
      "type": "shell",
      "command": "flutter",
      "args": [
        "build",
        "windows",
        "--release",
        "--target-platform=windows-x64"
      ],
      "dependsOn": "Rust Mashin Engine: Windows x64 Release",
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Release Build: Windows arm64 EXE",
      "type": "shell",
      "command": "flutter",
      "args": [
        "build",
        "windows",
        "--release",
        "--target-platform=windows-arm64"
      ],
      "dependsOn": "Rust Mashin Engine: Windows arm64 Release",
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": []
    }
  ]
}
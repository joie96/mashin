<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="mashin.Views.Mobile.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:mashin.Views.Mobile.Controls"
    xmlns:converters="clr-namespace:mashin.Converters"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:vm="clr-namespace:mashin.ViewModels"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    x:DataType="vm:MainViewModel"
    BackgroundColor="{DynamicResource BackgroundPrimary}">

    <ContentPage.Resources>
        <converters:PlayStateToBoolConverter x:Key="PlayStateToBoolConverter" />
    </ContentPage.Resources>

    <Grid x:Name="RootGrid" RowDefinitions="*,Auto,Auto">

        <Grid Grid.Row="0">
            <ContentView x:Name="ContentContainer"
                Margin="0">
                <ContentView.Triggers>
                    <DataTrigger Binding="{Binding CurrentSection}"
                        TargetType="ContentView"
                        Value="{x:Static vm:MainViewModel+NavigationSection.Search}">
                        <Setter Property="Margin"
                            Value="0,56,0,0" />
                    </DataTrigger>
                </ContentView.Triggers>
            </ContentView>

            <!--  Search Bar (Search Section Only)  -->
            <Border BackgroundColor="{DynamicResource BackgroundPrimary}"
                HeightRequest="64"
                IsVisible="False"
                StrokeThickness="0"
                VerticalOptions="Start"
                ZIndex="20">
                <Border.Triggers>
                    <DataTrigger Binding="{Binding CurrentSection}"
                        TargetType="Border"
                        Value="{x:Static vm:MainViewModel+NavigationSection.Search}">
                        <Setter Property="IsVisible"
                            Value="True" />
                    </DataTrigger>
                </Border.Triggers>

                <Border Margin="12,10,12,0"
                    Padding="12,0"
                    BackgroundColor="{DynamicResource BackgroundSecondary}"
                    HeightRequest="46"
                    HorizontalOptions="Fill"
                    Stroke="{DynamicResource BorderPrimary}"
                    StrokeThickness="1"
                    VerticalOptions="Start">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="23" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*"
                        ColumnSpacing="8">
                        <Label FontSize="18"
                            Text="{mi:Fluent Icon=Search12, FontOverride=True}"
                            TextColor="{DynamicResource IconSecondary}"
                            VerticalOptions="Center" />
                        <Entry Grid.Column="1"
                            Margin="0,8,0,0"
                            BackgroundColor="Transparent"
                            ClearButtonVisibility="WhileEditing"
                            FontFamily="PoppinsRegular"
                            FontSize="16"
                            HeightRequest="46"
                            Placeholder="Künstler:innen, Songs, Alben ..."
                            PlaceholderColor="{DynamicResource TextTertiary}"
                            ReturnCommand="{Binding SearchCommand}"
                            ReturnType="Search"
                            Text="{Binding SearchQuery}"
                            TextColor="{DynamicResource TextPrimary}"
                            VerticalOptions="Center"
                            VerticalTextAlignment="Center" />
                    </Grid>
                </Border>
            </Border>

            <Grid BackgroundColor="Transparent"
                IsVisible="{Binding IsNavigating}">
                <BoxView BackgroundColor="#80000000" />
                <ActivityIndicator HeightRequest="48"
                    HorizontalOptions="Center"
                    IsRunning="{Binding IsNavigating}"
                    VerticalOptions="Center"
                    WidthRequest="48"
                    Color="{DynamicResource AccentColor}" />
            </Grid>
        </Grid>

        <!--  Bottom Player Bar  -->
        <Border x:Name="PlayerBarBorder"
            Grid.Row="1"
            Margin="10,6,10,4"
            Padding="0"
            BackgroundColor="{DynamicResource PlayerBarBackground}"
            StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Border.Triggers>
                <DataTrigger TargetType="Border"
                    Binding="{Binding CurrentQueueItem}"
                    Value="{x:Null}">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </Border.Triggers>
            <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="0">
                <Border Grid.Column="0"
                    HeightRequest="{Binding Source={x:Reference PlayerBarBorder}, Path=Height}"
                    StrokeThickness="0"
                    VerticalOptions="Fill"
                    WidthRequest="{Binding Source={x:Reference PlayerBarBorder}, Path=Height}">
                    <Border.GestureRecognizers>
                        <PanGestureRecognizer PanUpdated="OnPlayerBarPanUpdated" />
                        <TapGestureRecognizer Tapped="OnPlayerBarTapped" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12,0,12,0" />
                    </Border.StrokeShape>
                    <ffimageloading:CachedImage Aspect="AspectFill"
                        FadeAnimationEnabled="True"
                        FadeAnimationForCachedImages="True"
                        FadeAnimationDuration="180"
                        Source="{Binding CurrentQueueItem.MediaItem.ImageUri}" />
                </Border>

                <Grid x:Name="PlayerBarProgressHost"
                    Grid.Column="1"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="10"
                    IsClippedToBounds="True">
                    <Border Grid.ColumnSpan="2"
                        BackgroundColor="{DynamicResource PlayerBarForeground}"
                        HeightRequest="{Binding Source={x:Reference PlayerBarProgressHost}, Path=Height}"
                        HorizontalOptions="Fill"
                        InputTransparent="True"
                        ScaleX="{Binding PlayerBarProgress}"
                        StrokeThickness="0"
                        VerticalOptions="Fill"
                        AnchorX="0"
                        WidthRequest="{Binding Source={x:Reference PlayerBarProgressHost}, Path=Width}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="0,12,0,12" />
                        </Border.StrokeShape>
                    </Border>

                    <Grid Grid.Column="0"
                        Margin="8,8,0,8"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="1"
                        VerticalOptions="Center">
                        <Grid.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnPlayerBarPanUpdated" />
                            <TapGestureRecognizer Tapped="OnPlayerBarTapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Row="0"
                            FontAttributes="None"
                            FontFamily="PoppinsRegular"
                            FontSize="13"
                            LineBreakMode="TailTruncation"
                            MaxLines="1"
                            Text="{Binding CurrentQueueItem.MediaItem.DisplayName}"
                            TextColor="{DynamicResource TextPrimary}" />
                        <Label Grid.Row="1"
                            FontFamily="PoppinsRegular"
                            FontSize="11"
                            LineBreakMode="TailTruncation"
                            MaxLines="1"
                            Text="{Binding CurrentQueueItem.MediaItem.ArtistName}"
                            TextColor="{DynamicResource TextSecondary}" />
                    </Grid>

                    <Border Grid.Column="1"
                        Margin="0,8,12,8"
                        BackgroundColor="{DynamicResource OverlayPlayButtonBackground}"
                        HeightRequest="38"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="38">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TogglePlayPauseCommand}" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="19" />
                        </Border.StrokeShape>
                        <Grid>
                            <Label FontSize="20"
                                HorizontalOptions="Center"
                                IsVisible="{Binding PlayState, Converter={StaticResource PlayStateToBoolConverter}, ConverterParameter=paused}"
                                Text="{mi:FluentFilled Icon=Play48Filled, FontOverride=True}"
                                TextColor="{DynamicResource OverlayPlayIconColor}"
                                VerticalOptions="Center" />
                            <Label FontSize="20"
                                HorizontalOptions="Center"
                                IsVisible="{Binding PlayState, Converter={StaticResource PlayStateToBoolConverter}, ConverterParameter=playing}"
                                Text="{mi:FluentFilled Icon=Pause48Filled, FontOverride=True}"
                                TextColor="{DynamicResource OverlayPlayIconColor}"
                                VerticalOptions="Center" />
                            <ActivityIndicator HeightRequest="16"
                                IsRunning="{Binding PlayState, Converter={StaticResource PlayStateToBoolConverter}, ConverterParameter=buffering}"
                                IsVisible="{Binding PlayState, Converter={StaticResource PlayStateToBoolConverter}, ConverterParameter=buffering}"
                                Scale="1.5"
                                WidthRequest="16"
                                Color="{DynamicResource OverlayPlayIconColor}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!--  Bottom Navigation Bar  -->
        <Border Grid.Row="2"
            Padding="12,10,12,14"
            BackgroundColor="{DynamicResource BackgroundSecondary}"
            StrokeThickness="0">
            
            <Grid ColumnDefinitions="*,*,*,*,*,*"
                ColumnSpacing="4">

                <Border Grid.Column="0"
                    WidthRequest="48"
                    HeightRequest="48"
                    Padding="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="Transparent"
                    StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToHomeCommand}" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border"
                            Binding="{Binding CurrentSection}"
                            Value="{x:Static vm:MainViewModel+NavigationSection.Home}">
                            <Setter Property="BackgroundColor" Value="{DynamicResource HoverBackground}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label FontSize="22"
                        HorizontalTextAlignment="Center"
                        Text="{mi:Fluent Icon=Home24, FontOverride=True}"
                        TextColor="{DynamicResource IconSecondary}"
                        VerticalTextAlignment="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                Binding="{Binding CurrentSection}"
                                Value="{x:Static vm:MainViewModel+NavigationSection.Home}">
                                <Setter Property="TextColor" Value="{DynamicResource AccentColor}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

                <Border Grid.Column="1"
                    WidthRequest="48"
                    HeightRequest="48"
                    Padding="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="Transparent"
                    StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToExploreCommand}" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border"
                            Binding="{Binding CurrentSection}"
                            Value="{x:Static vm:MainViewModel+NavigationSection.Explore}">
                            <Setter Property="BackgroundColor" Value="{DynamicResource HoverBackground}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label FontSize="22"
                        HorizontalTextAlignment="Center"
                        Text="{mi:Fluent Icon=CompassNorthwest24, FontOverride=True}"
                        TextColor="{DynamicResource IconSecondary}"
                        VerticalTextAlignment="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                Binding="{Binding CurrentSection}"
                                Value="{x:Static vm:MainViewModel+NavigationSection.Explore}">
                                <Setter Property="TextColor" Value="{DynamicResource AccentColor}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

                <Border Grid.Column="2"
                    WidthRequest="48"
                    HeightRequest="48"
                    Padding="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="Transparent"
                    StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToFavoritesCommand}" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border"
                            Binding="{Binding CurrentSection}"
                            Value="{x:Static vm:MainViewModel+NavigationSection.Favorites}">
                            <Setter Property="BackgroundColor" Value="{DynamicResource HoverBackground}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label FontSize="22"
                        HorizontalTextAlignment="Center"
                        Text="{mi:Fluent Icon=Heart24, FontOverride=True}"
                        TextColor="{DynamicResource IconSecondary}"
                        VerticalTextAlignment="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                Binding="{Binding CurrentSection}"
                                Value="{x:Static vm:MainViewModel+NavigationSection.Favorites}">
                                <Setter Property="TextColor" Value="{DynamicResource AccentColor}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

                <Border Grid.Column="3"
                    WidthRequest="48"
                    HeightRequest="48"
                    Padding="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="Transparent"
                    StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToPlaylistsCommand}" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border"
                            Binding="{Binding CurrentSection}"
                            Value="{x:Static vm:MainViewModel+NavigationSection.Playlists}">
                            <Setter Property="BackgroundColor" Value="{DynamicResource HoverBackground}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label FontSize="22"
                        HorizontalTextAlignment="Center"
                        Text="{mi:Fluent Icon=TextBulletListLtr24, FontOverride=True}"
                        TextColor="{DynamicResource IconSecondary}"
                        VerticalTextAlignment="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                Binding="{Binding CurrentSection}"
                                Value="{x:Static vm:MainViewModel+NavigationSection.Playlists}">
                                <Setter Property="TextColor" Value="{DynamicResource AccentColor}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

                <Border Grid.Column="4"
                    WidthRequest="48"
                    HeightRequest="48"
                    Padding="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="Transparent"
                    StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToSearchCommand}" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border"
                            Binding="{Binding CurrentSection}"
                            Value="{x:Static vm:MainViewModel+NavigationSection.Search}">
                            <Setter Property="BackgroundColor" Value="{DynamicResource HoverBackground}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label FontSize="22"
                        HorizontalTextAlignment="Center"
                        Text="{mi:Fluent Icon=Search24, FontOverride=True}"
                        TextColor="{DynamicResource IconSecondary}"
                        VerticalTextAlignment="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                Binding="{Binding CurrentSection}"
                                Value="{x:Static vm:MainViewModel+NavigationSection.Search}">
                                <Setter Property="TextColor" Value="{DynamicResource AccentColor}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

                <Border Grid.Column="5"
                    WidthRequest="48"
                    HeightRequest="48"
                    Padding="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="Transparent"
                    StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleThemeCommand}" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <Label FontSize="22"
                        HorizontalTextAlignment="Center"
                        Text="{mi:Fluent Icon=Settings24, FontOverride=True}"
                        TextColor="{DynamicResource IconSecondary}"
                        VerticalTextAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- Selection Indicator Host -->
        <Grid x:Name="SelectionIndicatorHost"
            Grid.Row="0"
            Grid.RowSpan="3"
            HorizontalOptions="End"
            InputTransparent="False"
            IsVisible="False"
            Margin="0,0,22,156"
            ZIndex="100"
            VerticalOptions="End">
            <ContentPresenter x:Name="SelectionIndicatorContent"
                HorizontalOptions="End"
                VerticalOptions="End" />
        </Grid>

        <!-- Context Menu Flyout Host -->
        <Grid x:Name="ContextMenuFlyoutHost"
            Grid.Row="0"
            Grid.RowSpan="3"
            BackgroundColor="Transparent"
            InputTransparent="False"
            IsVisible="False"
            ZIndex="129">
            <Grid>
                <BoxView BackgroundColor="#80000000">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnContextMenuFlyoutBackdropTapped" />
                    </BoxView.GestureRecognizers>
                </BoxView>
                <ContentPresenter x:Name="ContextMenuFlyoutContent"
                    HorizontalOptions="Fill"
                    VerticalOptions="End" />
            </Grid>
        </Grid>

        <!-- Player Bar Flyout Host -->
        <Grid x:Name="PlayerBarFlyoutHost"
            Grid.Row="0"
            Grid.RowSpan="3"
            BackgroundColor="Transparent"
            InputTransparent="False"
            IsVisible="False"
            ZIndex="123">
            <Grid>
                <BoxView BackgroundColor="#80000000">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPlayerBarFlyoutBackdropTapped" />
                    </BoxView.GestureRecognizers>
                </BoxView>
                <ContentPresenter x:Name="PlayerBarFlyoutContent"
                    HorizontalOptions="Fill"
                    VerticalOptions="End" />
            </Grid>
        </Grid>

        <!-- Queue Flyout Host -->
        <Grid x:Name="QueueFlyoutHost"
            Grid.Row="0"
            Grid.RowSpan="3"
            BackgroundColor="Transparent"
            InputTransparent="False"
            IsVisible="False"
            ZIndex="126">
            <Grid>
                <BoxView BackgroundColor="#80000000">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnQueueFlyoutBackdropTapped" />
                    </BoxView.GestureRecognizers>
                </BoxView>
                <ContentPresenter x:Name="QueueFlyoutContent"
                    HorizontalOptions="Fill"
                    VerticalOptions="End" />
            </Grid>
        </Grid>

        <!--! Overlay Host -->
        <Grid x:Name="OverlayHost"
            Grid.Row="0"
            Grid.RowSpan="3"
            BackgroundColor="Transparent"
            InputTransparent="False"
            IsVisible="False"
            ZIndex="130">
            <Grid>
                <BoxView BackgroundColor="#80000000">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOverlayBackdropTapped" />
                    </BoxView.GestureRecognizers>
                </BoxView>
                <ContentPresenter x:Name="OverlayContent"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Grid>
        </Grid>

    </Grid>
</ContentPage>



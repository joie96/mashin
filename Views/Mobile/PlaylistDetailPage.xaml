<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="mashin.Views.Mobile.PlaylistDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:mashin.Views.Mobile.Controls"
    xmlns:converters="clr-namespace:mashin.Converters"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:vm="clr-namespace:mashin.ViewModels"
    x:DataType="vm:PlaylistDetailViewModel"
    BackgroundColor="{DynamicResource BackgroundPrimary}">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <!--  Page Scroll  -->
    <ScrollView>
        <VerticalStackLayout Padding="0,0,0,12"
            Spacing="16">

            <!--  Header: Cover, Name, Meta  -->
            <Grid RowDefinitions="Auto,Auto,Auto"
                RowSpacing="10">

                <!--  Playlist Cover  -->
                <Border Grid.Row="0"
                    BackgroundColor="{DynamicResource BackgroundTertiary}"
                    HeightRequest="220"
                    HorizontalOptions="Fill"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="0,0,16,16" />
                    </Border.StrokeShape>
                    <ffimageloading:CachedImage Aspect="AspectFill"
                        Source="{Binding ImageUri}" />
                </Border>

                <!--  Playlist Name  -->
                <Label Grid.Row="1"
                    Margin="16,0"
                    FontFamily="PoppinsRegular"
                    FontSize="24"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap"
                    MaxLines="2"
                    Text="{Binding PlaylistName}"
                    TextColor="{DynamicResource TextPrimary}" />

                <!--  Playlist Meta  -->
                <HorizontalStackLayout Grid.Row="2"
                    HorizontalOptions="Center"
                    Spacing="8">
                    <Label FontFamily="PoppinsRegular"
                        FontSize="12"
                        Text="{Binding Tracks.Count, StringFormat='{0} Titel'}"
                        TextColor="{DynamicResource TextSecondary}" />
                    <Label FontFamily="PoppinsRegular"
                        FontSize="12"
                        Text="•"
                        TextColor="{DynamicResource TextSecondary}" />
                    <Label FontFamily="PoppinsRegular"
                        FontSize="12"
                        Text="{Binding PlaylistTotalDurationText}"
                        TextColor="{DynamicResource TextSecondary}" />
                </HorizontalStackLayout>
            </Grid>

            <!--  Header Actions  -->
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto"
                ColumnSpacing="14"
                HorizontalOptions="Center">

            <!--  Play  -->
            <Border Grid.Column="0"
                BackgroundColor="{DynamicResource ActionButtonsBackground}"
                HeightRequest="44"
                StrokeThickness="0"
                WidthRequest="44">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PlayPlaylistCommand}" />
                </Border.GestureRecognizers>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>
                <Label FontSize="18"
                    HorizontalOptions="Center"
                    Text="{mi:FluentFilled Icon=Play16Filled, FontOverride=True}"
                    TextColor="{DynamicResource IconPrimary}"
                    VerticalOptions="Center" />
            </Border>

            <!--  Shuffle  -->
            <Border Grid.Column="1"
                BackgroundColor="{DynamicResource ActionButtonsBackground}"
                HeightRequest="44"
                StrokeThickness="0"
                WidthRequest="44">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ShufflePlaylistCommand}" />
                </Border.GestureRecognizers>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>
                <Label FontSize="18"
                    HorizontalOptions="Center"
                    Text="{mi:FluentFilled Icon=ArrowShuffle16Filled, FontOverride=True}"
                    TextColor="{DynamicResource IconPrimary}"
                    VerticalOptions="Center" />
            </Border>

            <!--  Favorite Toggle  -->
            <Grid Grid.Column="2"
                HeightRequest="44"
                WidthRequest="44">
                <Border BackgroundColor="{DynamicResource ActionButtonsBackground}"
                    HeightRequest="44"
                    StrokeThickness="0"
                    WidthRequest="44">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                </Border>

                <Label FontSize="18"
                    HorizontalOptions="Center"
                    IsVisible="{Binding IsPlaylistFavorite, Converter={StaticResource InvertedBoolConverter}}"
                    Text="{mi:Fluent Icon=Heart48, FontOverride=True}"
                    TextColor="{DynamicResource IconPrimary}"
                    VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding TogglePlaylistFavoriteCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <Label FontSize="18"
                    HorizontalOptions="Center"
                    IsVisible="{Binding IsPlaylistFavorite}"
                    Text="{mi:FluentFilled Icon=Heart48Filled, FontOverride=True}"
                    TextColor="{DynamicResource IconPrimary}"
                    VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding TogglePlaylistFavoriteCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <!--  Header Context Menu  -->
            <Border x:Name="HeaderContextMenuButton"
                Grid.Column="3"
                BackgroundColor="{DynamicResource ActionButtonsBackground}"
                HeightRequest="44"
                StrokeThickness="0"
                WidthRequest="44">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ShowHeaderContextMenuAtAnchorCommand}"
                        CommandParameter="{x:Reference HeaderContextMenuButton}" />
                </Border.GestureRecognizers>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>
                <Label FontSize="18"
                    HorizontalOptions="Center"
                    Text="{mi:Fluent Icon=MoreHorizontal48, FontOverride=True}"
                    TextColor="{DynamicResource IconPrimary}"
                    VerticalOptions="Center" />
            </Border>
            </Grid>

            <!--  Track List  -->
            <VerticalStackLayout Padding="16,0,16,0"
                Spacing="8">
                <Border BackgroundColor="{DynamicResource BackgroundSecondary}"
                    Padding="0"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <!--  Tracks TableView  -->
                    <controls:TableView ItemsSource="{Binding TrackItems}"
                        ShowContextMenuAtAnchorCommand="{Binding ShowContentContextMenuAtAnchorCommand}" />
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

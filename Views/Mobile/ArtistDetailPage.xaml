<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="mashin.Views.Mobile.ArtistDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:mashin.Views.Mobile.Controls"
    xmlns:converters="clr-namespace:mashin.Converters"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:mashin.ViewModels"
    x:DataType="vm:ArtistDetailViewModel"
    BackgroundColor="{DynamicResource BackgroundPrimary}">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        <converters:RemoveBlankLinesConverter x:Key="RemoveBlankLinesConverter" />
    </ContentPage.Resources>

    <!--  Page Scroll  -->
    <ScrollView>
        <VerticalStackLayout Padding="0,0,0,12"
            Spacing="16">

            <!--  Header: Image, Name, Meta  -->
            <Grid RowDefinitions="Auto,Auto,Auto"
                RowSpacing="4">

                <!--  Artist Image  -->
                <Border Grid.Row="0"
                    BackgroundColor="{DynamicResource BackgroundTertiary}"
                    HeightRequest="220"
                    HorizontalOptions="Fill"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="0,0,16,16" />
                    </Border.StrokeShape>
                    <Grid>
                        <ffimageloading:CachedImage Aspect="AspectFill"
                            IsVisible="{Binding ImageUri, Converter={StaticResource StringNullOrWhiteSpaceToBoolConverter}, ConverterParameter=invert}"
                            Source="{Binding ImageUri}" />
                        <Image Aspect="AspectFill"
                            IsVisible="{Binding ImageUri, Converter={StaticResource StringNullOrWhiteSpaceToBoolConverter}}"
                            Source="{AppThemeBinding Light=placeholders/artist_light.png, Dark=placeholders/artist_dark.png}" />


                        <!--  Fade image into page background at the bottom  -->
                        <BoxView InputTransparent="True">
                            <BoxView.Background>
                                <LinearGradientBrush EndPoint="0,1"
                                    StartPoint="0,0">
                                    <GradientStop Color="#00FFFFFF"
                                        Offset="0.44" />
                                    <GradientStop Color="{DynamicResource BackgroundPrimary}"
                                        Offset="1.0" />
                                </LinearGradientBrush>
                            </BoxView.Background>
                        </BoxView>

                    </Grid>
                </Border>

                <!--  Artist Name + Provider Icon  -->
                <HorizontalStackLayout Grid.Row="1"
                    Margin="16,2,16,0"
                    HorizontalOptions="Center"
                    Spacing="8"
                    VerticalOptions="Center">
                    <Label FontFamily="PoppinsRegular"
                        FontSize="24"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        MaxLines="2"
                        Text="{Binding ArtistName}"
                        TextColor="{DynamicResource TextPrimary}"
                        VerticalOptions="Center" />

                    <ffimageloading:SvgCachedImage HeightRequest="20"
                        Source="{Binding Artist.ProviderManifest.IconSvg}"
                        VerticalOptions="Center"
                        WidthRequest="20">
                        <ffimageloading:SvgCachedImage.Triggers>
                            <DataTrigger Binding="{Binding Artist.ProviderManifest.IconSvg}"
                                TargetType="ffimageloading:SvgCachedImage"
                                Value="{x:Null}">
                                <Setter Property="IsVisible"
                                    Value="False" />
                            </DataTrigger>
                        </ffimageloading:SvgCachedImage.Triggers>
                    </ffimageloading:SvgCachedImage>
                </HorizontalStackLayout>

                <!--  Artist Meta  -->
                <HorizontalStackLayout Grid.Row="2"
                    HorizontalOptions="Center"
                    Spacing="8">
                    <Label FontFamily="PoppinsRegular"
                        FontSize="12"
                        Text="{Binding Albums.Count, StringFormat='{0} Alben'}"
                        TextColor="{DynamicResource TextSecondary}" />
                </HorizontalStackLayout>
            </Grid>

            <!--  Header Actions  -->
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto"
                ColumnSpacing="14"
                HorizontalOptions="Center">

                <!--  Play  -->
                <Border Grid.Column="0"
                    BackgroundColor="{DynamicResource ActionButtonsBackground}"
                    HeightRequest="44"
                    StrokeThickness="0"
                    WidthRequest="44">
                    <Border.Behaviors>
                        <toolkit:TouchBehavior PressedBackgroundColor="{StaticResource SelectionBackground}"
                            PressedAnimationDuration="250"
                            PressedAnimationEasing="SinOut" />
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PlayArtistCommand}" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Label FontSize="18"
                        HorizontalOptions="Center"
                        Text="{mi:FluentFilled Icon=Play48Filled, FontOverride=True}"
                        TextColor="{DynamicResource IconPrimary}"
                        VerticalOptions="Center" />
                </Border>

                <!--  Shuffle  -->
                <Border Grid.Column="1"
                    BackgroundColor="{DynamicResource ActionButtonsBackground}"
                    HeightRequest="44"
                    StrokeThickness="0"
                    WidthRequest="44">
                    <Border.Behaviors>
                        <toolkit:TouchBehavior PressedBackgroundColor="{StaticResource SelectionBackground}"
                            PressedAnimationDuration="250"
                            PressedAnimationEasing="CubicOut" />
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShuffleArtistCommand}" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Label FontSize="18"
                        HorizontalOptions="Center"
                        Text="{mi:FluentFilled Icon=ArrowShuffle48Filled, FontOverride=True}"
                        TextColor="{DynamicResource IconPrimary}"
                        VerticalOptions="Center" />
                </Border>

                <!--  Start Artist Radio  -->
                <Border Grid.Column="2"
                    BackgroundColor="{DynamicResource ActionButtonsBackground}"
                    HeightRequest="44"
                    StrokeThickness="0"
                    WidthRequest="44">
                    <Border.Behaviors>
                        <toolkit:TouchBehavior PressedBackgroundColor="{StaticResource SelectionBackground}"
                            PressedAnimationDuration="250"
                            PressedAnimationEasing="CubicOut" />
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding StartArtistRadioCommand}" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Label FontSize="18"
                        HorizontalOptions="Center"
                        Text="{mi:Fluent Icon=Album20, FontOverride=True}"
                        TextColor="{DynamicResource IconPrimary}"
                        VerticalOptions="Center" />
                </Border>

                <!--  Favorite Toggle  -->
                <Border Grid.Column="3"
                    BackgroundColor="{DynamicResource ActionButtonsBackground}"
                    HeightRequest="44"
                    StrokeThickness="0"
                    WidthRequest="44">
                    <Border.Behaviors>
                        <toolkit:TouchBehavior PressedBackgroundColor="{StaticResource SelectionBackground}"
                            PressedAnimationDuration="250"
                            PressedAnimationEasing="CubicOut" />
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleArtistFavoriteCommand}" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Grid>
                        <Label FontSize="18"
                            HorizontalOptions="Center"
                            IsVisible="{Binding IsArtistFavorite, Converter={StaticResource InvertedBoolConverter}}"
                            Text="{mi:Fluent Icon=Heart48, FontOverride=True}"
                            TextColor="{DynamicResource IconPrimary}"
                            VerticalOptions="Center" />

                        <Label FontSize="18"
                            HorizontalOptions="Center"
                            IsVisible="{Binding IsArtistFavorite}"
                            Text="{mi:FluentFilled Icon=Heart48Filled, FontOverride=True}"
                            TextColor="{DynamicResource IconPrimary}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!--  Header Context Menu  -->
                <Border x:Name="HeaderContextMenuButton"
                    Grid.Column="4"
                    BackgroundColor="{DynamicResource ActionButtonsBackground}"
                    HeightRequest="44"
                    StrokeThickness="0"
                    WidthRequest="44">
                    <Border.Behaviors>
                        <toolkit:TouchBehavior PressedBackgroundColor="{StaticResource SelectionBackground}"
                            PressedAnimationDuration="250"
                            PressedAnimationEasing="CubicOut" />
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowHeaderContextMenuAtAnchorCommand}"
                            CommandParameter="{x:Reference HeaderContextMenuButton}" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Label FontSize="18"
                        HorizontalOptions="Center"
                        Text="{mi:Fluent Icon=MoreVertical48, FontOverride=True}"
                        TextColor="{DynamicResource IconPrimary}"
                        VerticalOptions="Center" />
                </Border>
            </Grid>

            <!--  Artist Info Text  -->
            <VerticalStackLayout IsVisible="{Binding HasDescription}"
                Margin="16,4,16,0"
                Spacing="6">
                <Label FontFamily="PoppinsRegular"
                    FontSize="14"
                    Text="{Binding ArtistName, StringFormat='Über {0}'}"
                    TextColor="{DynamicResource TextPrimary}" />
                <Label FontFamily="PoppinsRegular"
                    FontSize="13"
                    LineBreakMode="TailTruncation"
                    MaxLines="{Binding MobileDescriptionMaxLines}"
                    Text="{Binding Artist.Metadata.Description, Converter={StaticResource RemoveBlankLinesConverter}}"
                    TextColor="{DynamicResource TextSecondary}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleDescriptionCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>

            <!--  Veröffentlichungen Section  -->
            <VerticalStackLayout Padding="{StaticResource MobileSectionPadding}"
                Margin="{StaticResource MobileSectionTopMargin}"
                Spacing="10">
                <Grid ColumnDefinitions="Auto,Auto,*"
                    ColumnSpacing="10">
                    <Label Grid.Column="0"
                        FontFamily="PoppinsRegular"
                        FontSize="22"
                        Text="Veröffentlichungen"
                        TextColor="{DynamicResource TextPrimary}"
                        VerticalOptions="Center" />
                    <Border Grid.Column="1"
                        BackgroundColor="Transparent"
                        HeightRequest="22"
                        Margin="0,0,0,0"
                        Padding="6,0"
                        Stroke="{DynamicResource BorderPrimary}"
                        StrokeThickness="1"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="3" />
                        </Border.StrokeShape>
                        <Label FontFamily="PoppinsRegular"
                            FontAttributes="Bold"
                            FontSize="10"
                            HorizontalOptions="Center"
                            Text="{Binding AlbumItems.Count}"
                            TextColor="{DynamicResource TextPrimary}"
                            VerticalOptions="Center" />
                    </Border>
                    <BoxView Grid.Column="2"
                        BackgroundColor="{DynamicResource BorderColor}"
                        HeightRequest="1"
                        HorizontalOptions="Fill"
                        Opacity="0.75"
                        VerticalOptions="Center" />
                </Grid>

                <controls:RowView CoverSize="145"
                    ItemCornerRadius="8"
                    ItemWidth="145"
                    ItemsSource="{Binding AlbumItems}"
                    MediaActions="{Binding MediaActions}"
                    PrimaryInfoTappedCommand="{Binding AlbumTappedCommand}"
                    SecondaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    ShowContextMenuAtAnchorCommand="{Binding ShowAlbumContextMenuAtAnchorCommand}"
                    ShowContextMenuAtPositionCommand="{Binding ShowAlbumContextMenuAtPositionCommand}" />
            </VerticalStackLayout>

            <!--  Ähnliche Interpreten Section  -->
            <VerticalStackLayout Padding="{StaticResource MobileSectionPadding}"
                Margin="{StaticResource MobileSectionTopMargin}"
                Spacing="10">
                <Grid ColumnDefinitions="Auto,Auto,*"
                    ColumnSpacing="10">
                    <Label Grid.Column="0"
                        FontFamily="PoppinsRegular"
                        FontSize="22"
                        Text="Ähnliche Interpreten"
                        TextColor="{DynamicResource TextPrimary}"
                        VerticalOptions="Center" />
                    <Border Grid.Column="1"
                        BackgroundColor="Transparent"
                        HeightRequest="22"
                        Margin="0,0,0,0"
                        Padding="6,0"
                        Stroke="{DynamicResource BorderPrimary}"
                        StrokeThickness="1"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="3" />
                        </Border.StrokeShape>
                        <Label FontFamily="PoppinsRegular"
                            FontAttributes="Bold"
                            FontSize="10"
                            HorizontalOptions="Center"
                            Text="{Binding SimilarArtistItems.Count}"
                            TextColor="{DynamicResource TextPrimary}"
                            VerticalOptions="Center" />
                    </Border>
                    <BoxView Grid.Column="2"
                        BackgroundColor="{DynamicResource BorderColor}"
                        HeightRequest="1"
                        HorizontalOptions="Fill"
                        Opacity="0.75"
                        VerticalOptions="Center" />
                </Grid>

                <controls:RowView CoverSize="145"
                    ItemCornerRadius="72.5"
                    ItemWidth="145"
                    ItemsSource="{Binding SimilarArtistItems}"
                    MediaActions="{Binding MediaActions}"
                    PrimaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    SecondaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    ShowContextMenuAtAnchorCommand="{Binding ShowArtistContextMenuAtAnchorCommand}"
                    ShowContextMenuAtPositionCommand="{Binding ShowArtistContextMenuAtPositionCommand}" />
            </VerticalStackLayout>

            <!--  Top Tracks Section  -->
            <VerticalStackLayout Padding="{StaticResource MobileSectionPadding}"
                Margin="{StaticResource MobileSectionTopMargin}"
                Spacing="10">
                <Grid ColumnDefinitions="Auto,Auto,*"
                    ColumnSpacing="10">
                    <Label Grid.Column="0"
                        FontFamily="PoppinsRegular"
                        FontSize="22"
                        Text="Top Tracks"
                        TextColor="{DynamicResource TextPrimary}"
                        VerticalOptions="Center" />
                    <Border Grid.Column="1"
                        BackgroundColor="Transparent"
                        HeightRequest="22"
                        Margin="0,0,0,0"
                        Padding="6,0"
                        Stroke="{DynamicResource BorderPrimary}"
                        StrokeThickness="1"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="3" />
                        </Border.StrokeShape>
                        <Label FontFamily="PoppinsRegular"
                            FontAttributes="Bold"
                            FontSize="10"
                            HorizontalOptions="Center"
                            Text="{Binding TopTrackItems.Count}"
                            TextColor="{DynamicResource TextPrimary}"
                            VerticalOptions="Center" />
                    </Border>
                    <BoxView Grid.Column="2"
                        BackgroundColor="{DynamicResource BorderColor}"
                        HeightRequest="1"
                        HorizontalOptions="Fill"
                        Opacity="0.75"
                        VerticalOptions="Center" />
                </Grid>

                <Border 
                    Padding="0"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <controls:TableView ItemsSource="{Binding TopTrackItems}"
                        PlaybackContextItem="{Binding Artist}"
                        ShowContextMenuAtAnchorCommand="{Binding ShowTrackContextMenuAtAnchorCommand}" />
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>



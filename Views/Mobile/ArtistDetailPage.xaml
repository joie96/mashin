<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="mashin.Views.Mobile.ArtistDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:mashin.Views.Mobile.Controls"
    xmlns:converters="clr-namespace:mashin.Converters"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:mashin.ViewModels"
    x:DataType="vm:ArtistDetailViewModel"
    BackgroundColor="{DynamicResource BackgroundPrimary}">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <!--  Page Scroll  -->
    <ScrollView>
        <VerticalStackLayout Padding="0,0,0,12"
            Spacing="16">

            <!--  Header: Image, Name, Meta  -->
            <Grid RowDefinitions="Auto,Auto,Auto"
                RowSpacing="4">

                <!--  Artist Image  -->
                <Border Grid.Row="0"
                    BackgroundColor="{DynamicResource BackgroundTertiary}"
                    HeightRequest="220"
                    HorizontalOptions="Fill"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="0,0,16,16" />
                    </Border.StrokeShape>
                    <Grid>
                        <ffimageloading:CachedImage Aspect="AspectFill"
                            Source="{Binding ImageUri}" />

                        <!--  Fade image into page background at the bottom  -->
                        <BoxView InputTransparent="True">
                            <BoxView.Background>
                                <LinearGradientBrush EndPoint="0,1"
                                    StartPoint="0,0">
                                    <GradientStop Color="#00FFFFFF"
                                        Offset="0.44" />
                                    <GradientStop Color="{DynamicResource BackgroundPrimary}"
                                        Offset="1.0" />
                                </LinearGradientBrush>
                            </BoxView.Background>
                        </BoxView>

                    </Grid>
                </Border>

                <!--  Artist Name  -->
                <Label Grid.Row="1"
                    Margin="16,2,16,0"
                    FontFamily="PoppinsRegular"
                    FontSize="24"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap"
                    MaxLines="2"
                    Text="{Binding ArtistName}"
                    TextColor="{DynamicResource TextPrimary}" />

                <!--  Artist Meta  -->
                <HorizontalStackLayout Grid.Row="2"
                    HorizontalOptions="Center"
                    Spacing="8">
                    <Label FontFamily="PoppinsRegular"
                        FontSize="12"
                        Text="{Binding Albums.Count, StringFormat='{0} Alben'}"
                        TextColor="{DynamicResource TextSecondary}" />
                    <Label FontFamily="PoppinsRegular"
                        FontSize="12"
                        Text="•"
                        TextColor="{DynamicResource TextSecondary}" />
                    <Label FontFamily="PoppinsRegular"
                        FontSize="12"
                        Text="{Binding Artist.ProviderName}"
                        TextColor="{DynamicResource TextSecondary}" />
                </HorizontalStackLayout>
            </Grid>

            <!--  Header Actions  -->
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto"
                ColumnSpacing="14"
                HorizontalOptions="Center">

                <!--  Play  -->
                <Border Grid.Column="0"
                    BackgroundColor="{DynamicResource ActionButtonsBackground}"
                    HeightRequest="44"
                    StrokeThickness="0"
                    WidthRequest="44">
                    <Border.Behaviors>
                        <toolkit:TouchBehavior PressedBackgroundColor="{DynamicResource SelectionBackground}" />
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PlayArtistCommand}" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Label FontSize="18"
                        HorizontalOptions="Center"
                        Text="{mi:FluentFilled Icon=Play48Filled, FontOverride=True}"
                        TextColor="{DynamicResource IconPrimary}"
                        VerticalOptions="Center" />
                </Border>

                <!--  Shuffle  -->
                <Border Grid.Column="1"
                    BackgroundColor="{DynamicResource ActionButtonsBackground}"
                    HeightRequest="44"
                    StrokeThickness="0"
                    WidthRequest="44">
                    <Border.Behaviors>
                        <toolkit:TouchBehavior PressedBackgroundColor="{DynamicResource SelectionBackground}" />
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShuffleArtistCommand}" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Label FontSize="18"
                        HorizontalOptions="Center"
                        Text="{mi:FluentFilled Icon=ArrowShuffle48Filled, FontOverride=True}"
                        TextColor="{DynamicResource IconPrimary}"
                        VerticalOptions="Center" />
                </Border>

                <!--  Favorite Toggle  -->
                <Grid Grid.Column="2"
                    HeightRequest="44"
                    WidthRequest="44">
                    <Grid.Behaviors>
                        <toolkit:TouchBehavior PressedBackgroundColor="{DynamicResource SelectionBackground}" />
                    </Grid.Behaviors>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleArtistFavoriteCommand}" />
                    </Grid.GestureRecognizers>
                    <Border BackgroundColor="{DynamicResource ActionButtonsBackground}"
                        HeightRequest="44"
                        StrokeThickness="0"
                        WidthRequest="44">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>
                    </Border>

                    <Label FontSize="18"
                        HorizontalOptions="Center"
                        IsVisible="{Binding IsArtistFavorite, Converter={StaticResource InvertedBoolConverter}}"
                        Text="{mi:Fluent Icon=Heart48, FontOverride=True}"
                        TextColor="{DynamicResource IconPrimary}"
                        VerticalOptions="Center" />

                    <Label FontSize="18"
                        HorizontalOptions="Center"
                        IsVisible="{Binding IsArtistFavorite}"
                        Text="{mi:FluentFilled Icon=Heart48Filled, FontOverride=True}"
                        TextColor="{DynamicResource IconPrimary}"
                        VerticalOptions="Center" />
                </Grid>

                <!--  Header Context Menu  -->
                <Border x:Name="HeaderContextMenuButton"
                    Grid.Column="3"
                    BackgroundColor="{DynamicResource ActionButtonsBackground}"
                    HeightRequest="44"
                    StrokeThickness="0"
                    WidthRequest="44">
                    <Border.Behaviors>
                        <toolkit:TouchBehavior PressedBackgroundColor="{DynamicResource SelectionBackground}" />
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowHeaderContextMenuAtAnchorCommand}"
                            CommandParameter="{x:Reference HeaderContextMenuButton}" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Label FontSize="18"
                        HorizontalOptions="Center"
                        Text="{mi:Fluent Icon=MoreVertical48, FontOverride=True}"
                        TextColor="{DynamicResource IconPrimary}"
                        VerticalOptions="Center" />
                </Border>
            </Grid>

            <!--  Veröffentlichungen Section  -->
            <VerticalStackLayout Padding="16,0,16,0"
                Margin="0,8,0,0"
                Spacing="10">
                <Label FontFamily="PoppinsRegular"
                    FontSize="22"
                    Text="Veröffentlichungen"
                    TextColor="{DynamicResource TextPrimary}" />

                <controls:RowView CoverSize="145"
                    ItemCornerRadius="8"
                    ItemWidth="145"
                    ItemsSource="{Binding AlbumItems}"
                    MediaActions="{Binding MediaActions}"
                    PrimaryInfoTappedCommand="{Binding AlbumTappedCommand}"
                    SecondaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    ShowContextMenuAtAnchorCommand="{Binding ShowAlbumContextMenuAtAnchorCommand}"
                    ShowContextMenuAtPositionCommand="{Binding ShowAlbumContextMenuAtPositionCommand}" />
            </VerticalStackLayout>

            <!--  Ähnliche Interpreten Section  -->
            <VerticalStackLayout Padding="16,0,16,0"
                Margin="0,8,0,0"
                Spacing="10">
                <Label FontFamily="PoppinsRegular"
                    FontSize="22"
                    Text="Ähnliche Interpreten"
                    TextColor="{DynamicResource TextPrimary}" />

                <controls:RowView CoverSize="145"
                    ItemCornerRadius="72.5"
                    ItemWidth="145"
                    ItemsSource="{Binding SimilarArtistItems}"
                    MediaActions="{Binding MediaActions}"
                    PrimaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    SecondaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    ShowContextMenuAtAnchorCommand="{Binding ShowArtistContextMenuAtAnchorCommand}"
                    ShowContextMenuAtPositionCommand="{Binding ShowArtistContextMenuAtPositionCommand}" />
            </VerticalStackLayout>

            <!--  Top Tracks Section  -->
            <VerticalStackLayout Padding="16,0,16,0"
                Margin="0,8,0,0"
                Spacing="10">
                <Label FontFamily="PoppinsRegular"
                    FontSize="22"
                    Text="Top Tracks"
                    TextColor="{DynamicResource TextPrimary}" />

                <Border BackgroundColor="{DynamicResource BackgroundSecondary}"
                    Padding="0"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <controls:TableView ItemsSource="{Binding TopTrackItems}"
                        ShowContextMenuAtAnchorCommand="{Binding ShowTrackContextMenuAtAnchorCommand}" />
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>


<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="mashin.Views.Mobile.Controls.TableView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:converters="clr-namespace:mashin.Converters"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:mashin.Views.Mobile.Controls"
    xmlns:desktopControls="clr-namespace:mashin.Views.Desktop.Controls"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:models="clr-namespace:mashin.Models"
    x:Name="self"
    Loaded="OnTableViewLoaded"
    Unloaded="OnTableViewUnloaded">

    <ContentView.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        <converters:MediaItemLoadingPriorityConverter x:Key="MediaItemLoadingPriorityConverter" />
        <converters:PlayStateToBoolConverter x:Key="PlayStateToBoolConverter" />
        <converters:StringEqualsConverter x:Key="StringEqualsConverter" />

        <!--  Playlist Row Template  -->
        <DataTemplate x:Key="PlaylistTemplate" x:DataType="models:Playlist">
            <Border Padding="8,6"
                BackgroundColor="Transparent"
                StrokeThickness="0">
                <!--  Row Touch + Pressed Area (full row)  -->
                <Border.Behaviors>
                    <toolkit:TouchBehavior PressedBackgroundColor="{StaticResource SelectionBackground}"
                        LongPressCompleted="OnRowLongPressCompleted"
                        LongPressDuration="420"
                        PressedAnimationDuration="250"
                        PressedAnimationEasing="CubicOut"
                        ShouldMakeChildrenInputTransparent="False"
                        TouchGestureCompleted="OnRowTouchCompleted" />
                </Border.Behaviors>
                <Border.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}"
                        TargetType="Border"
                        Value="True">
                        <Setter Property="BackgroundColor"
                            Value="{DynamicResource SelectionBackground}" />
                    </DataTrigger>
                </Border.Triggers>

                <Grid ColumnDefinitions="52,*,Auto,20,40"
                    ColumnSpacing="10">
                    <!--  Row Content Area  -->
                    <Grid Grid.ColumnSpan="2"
                        ColumnDefinitions="52,*"
                        ColumnSpacing="10">
                        <!--  Cover  -->
                        <Border Grid.Column="0"
                            BackgroundColor="{DynamicResource BackgroundTertiary}"
                            HeightRequest="52"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            WidthRequest="52">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid>
                                <ffimageloading:CachedImage Aspect="AspectFill"
                                    LoadingPriority="{Binding ., Converter={StaticResource MediaItemLoadingPriorityConverter}}"
                                    IsVisible="{Binding ImageUri, Converter={StaticResource StringNullOrWhiteSpaceToBoolConverter}, ConverterParameter=invert}"
                                    Source="{Binding ImageUri, Converter={StaticResource ImageUriSizeConverter}, ConverterParameter=80}" />
                                <Image Aspect="AspectFill"
                                    IsVisible="{Binding ImageUri, Converter={StaticResource StringNullOrWhiteSpaceToBoolConverter}}"
                                    Source="{AppThemeBinding Light=placeholders/playlist_light.png, Dark=placeholders/playlist_dark.png}" />
                            </Grid>
                        </Border>

                        <!--  Title + Owner  -->
                        <VerticalStackLayout Grid.Column="1"
                            Spacing="1"
                            VerticalOptions="Center">
                            <Label FontFamily="PoppinsRegular"
                                FontSize="14"
                                LineBreakMode="TailTruncation"
                                MaxLines="1"
                                Text="{Binding DisplayName}"
                                TextColor="{DynamicResource TextPrimary}" />
                            <Label FontFamily="PoppinsRegular"
                                FontSize="12"
                                LineBreakMode="TailTruncation"
                                MaxLines="1"
                                Text="{Binding MetadataText}"
                                TextColor="{DynamicResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Grid>

                    <!--  Spacer (matches track duration column)  -->
                    <Label Grid.Column="2"
                        FontFamily="PoppinsRegular"
                        FontSize="12"
                        HorizontalOptions="End"
                        Text=""
                        TextColor="{DynamicResource TextSecondary}"
                        VerticalOptions="Center" />

                    <!--  Provider (Icon)  -->
                    <ffimageloading:SvgCachedImage Grid.Column="3"
                        HeightRequest="16"
                        HorizontalOptions="Center"
                        Source="{Binding ProviderManifest.IconSvg}"
                        VerticalOptions="Center"
                        WidthRequest="16">
                        <ffimageloading:SvgCachedImage.Triggers>
                            <DataTrigger Binding="{Binding ProviderManifest.IconSvg}"
                                TargetType="ffimageloading:SvgCachedImage"
                                Value="{x:Null}">
                                <Setter Property="IsVisible"
                                    Value="False" />
                            </DataTrigger>
                        </ffimageloading:SvgCachedImage.Triggers>
                    </ffimageloading:SvgCachedImage>

                    <!--  Selection checkbox   -->
                    <Border Grid.Column="4"
                        BackgroundColor="Transparent"
                        HeightRequest="20"
                        HorizontalOptions="Center"
                        IsVisible="{Binding Source={x:Reference self}, Path=HasSelection}"
                        InputTransparent="True"
                        Margin="0"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Border BackgroundColor="Transparent"
                            HeightRequest="20"
                            HorizontalOptions="Center"
                            Stroke="{DynamicResource IconSecondary}"
                            StrokeThickness="1"
                            VerticalOptions="Center"
                            WidthRequest="20">
                            <Border.StrokeShape>
                                <Ellipse />
                            </Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}"
                                    TargetType="Border"
                                    Value="True">
                                    <Setter Property="BackgroundColor"
                                        Value="{DynamicResource AccentColor}" />
                                    <Setter Property="Stroke"
                                        Value="{DynamicResource AccentColor}" />
                                    <Setter Property="StrokeThickness"
                                        Value="1" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                IsVisible="{Binding IsSelected}"
                                Text="{mi:Fluent Icon=Checkmark16, FontOverride=True}"
                                TextColor="{DynamicResource IconPrimary}"
                                VerticalOptions="Center" />
                        </Border>
                    </Border>

                    <!--  Context Menu Button  -->
                    <Border x:Name="MoreButton"
                        Grid.Column="4"
                        WidthRequest="40"
                        HeightRequest="40"
                        Padding="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        IsVisible="{Binding Source={x:Reference self}, Path=HasSelection, Converter={StaticResource InvertedBoolConverter}}"
                        BackgroundColor="Transparent"
                        StrokeThickness="0">
                        <Border.Behaviors>
                            <toolkit:TouchBehavior
                                PressedBackgroundColor="{StaticResource SelectionBackground}"
                                PressedAnimationDuration="250"
                                PressedAnimationEasing="CubicOut" />
                        </Border.Behaviors>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMoreButtonTapped" />
                        </Border.GestureRecognizers>
                        <Label
                            FontSize="18"
                            HorizontalOptions="Center"
                            Text="{mi:Fluent Icon=MoreVertical48, FontOverride=True}"
                            TextColor="{DynamicResource IconSecondary}"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  Track Row Template  -->
        <DataTemplate x:Key="TrackTemplate" x:DataType="models:Track">
            <Border Padding="8,6"
                BackgroundColor="Transparent"
                StrokeThickness="0">
                <!--  Row Touch + Pressed Area (full row)  -->
                <Border.Behaviors>
                    <toolkit:TouchBehavior PressedBackgroundColor="{StaticResource SelectionBackground}"
                        LongPressCompleted="OnRowLongPressCompleted"
                        LongPressDuration="420"
                        PressedAnimationDuration="250"
                        PressedAnimationEasing="CubicOut"
                        ShouldMakeChildrenInputTransparent="False"
                        TouchGestureCompleted="OnRowTouchCompleted" />
                </Border.Behaviors>
                <Border.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}"
                        TargetType="Border"
                        Value="True">
                        <Setter Property="BackgroundColor"
                            Value="{DynamicResource SelectionBackground}" />
                    </DataTrigger>
                </Border.Triggers>

                <Grid ColumnDefinitions="52,*,Auto,20,40"
                    ColumnSpacing="10">
                    <!--  Row Content Area  -->
                    <Grid Grid.ColumnSpan="2"
                        ColumnDefinitions="52,*"
                        ColumnSpacing="10">
                        <!--  Cover  -->
                        <Border Grid.Column="0"
                            BackgroundColor="{DynamicResource BackgroundTertiary}"
                            HeightRequest="52"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            WidthRequest="52">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid>
                                <ffimageloading:CachedImage Aspect="AspectFill"
                                    LoadingPriority="{Binding ., Converter={StaticResource MediaItemLoadingPriorityConverter}}"
                                    IsVisible="{Binding ImageUri, Converter={StaticResource StringNullOrWhiteSpaceToBoolConverter}, ConverterParameter=invert}"
                                    Source="{Binding ImageUri, Converter={StaticResource ImageUriSizeConverter}, ConverterParameter=80}" />
                                <Image Aspect="AspectFill"
                                    IsVisible="{Binding ImageUri, Converter={StaticResource StringNullOrWhiteSpaceToBoolConverter}}"
                                    Source="{AppThemeBinding Light=placeholders/track_light.png, Dark=placeholders/track_dark.png}" />
                            </Grid>
                        </Border>

                        <!--  Title + Artist  -->
                        <VerticalStackLayout Grid.Column="1"
                            Spacing="1"
                            VerticalOptions="Center">
                            <Grid ColumnDefinitions="Auto,*"
                                ColumnSpacing="6"
                                HorizontalOptions="Fill"
                                VerticalOptions="Center">
                                <Grid IsVisible="False"
                                    Grid.Column="0"
                                    VerticalOptions="Center">
                                    <Grid.Triggers>
                                        <DataTrigger TargetType="Grid"
                                            Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource StringEqualsConverter}">
                                                    <Binding Path="Uri" />
                                                    <Binding Path="CurrentTrackUri"
                                                        Source="{x:Reference self}" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter Property="IsVisible"
                                                Value="True" />
                                        </DataTrigger>
                                    </Grid.Triggers>

                                    <Label FontSize="12"
                                        HorizontalOptions="Center"
                                        IsVisible="{Binding Path=CurrentPlayState, Source={x:Reference self}, Converter={StaticResource PlayStateToBoolConverter}, ConverterParameter=show-play-icon}"
                                        Text="{mi:FluentFilled Icon=Play12Filled, FontOverride=True}"
                                        TextColor="{DynamicResource AccentColor}"
                                        VerticalOptions="Center" />

                                    <Label FontSize="12"
                                        HorizontalOptions="Center"
                                        IsVisible="{Binding Path=CurrentPlayState, Source={x:Reference self}, Converter={StaticResource PlayStateToBoolConverter}, ConverterParameter=show-pause-icon}"
                                        Text="{mi:FluentFilled Icon=Pause12Filled, FontOverride=True}"
                                        TextColor="{DynamicResource AccentColor}"
                                        VerticalOptions="Center" />

                                    <ActivityIndicator Color="{DynamicResource AccentColor}"
                                        HeightRequest="12"
                                        HorizontalOptions="Center"
                                        IsRunning="{Binding Path=CurrentPlayState, Source={x:Reference self}, Converter={StaticResource PlayStateToBoolConverter}, ConverterParameter=buffering}"
                                        IsVisible="{Binding Path=CurrentPlayState, Source={x:Reference self}, Converter={StaticResource PlayStateToBoolConverter}, ConverterParameter=buffering}"
                                        VerticalOptions="Center"
                                        WidthRequest="12" />
                                </Grid>

                                <Label FontFamily="PoppinsRegular"
                                    Grid.Column="1"
                                    FontSize="14"
                                    HorizontalOptions="Fill"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1"
                                    Text="{Binding DisplayName}"
                                    TextColor="{DynamicResource TextPrimary}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                            Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource StringEqualsConverter}">
                                                    <Binding Path="Uri" />
                                                    <Binding Path="CurrentTrackUri"
                                                        Source="{x:Reference self}" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter Property="TextColor"
                                                Value="{DynamicResource AccentColor}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                            <Label FontFamily="PoppinsRegular"
                                FontSize="12"
                                LineBreakMode="TailTruncation"
                                MaxLines="1"
                                Text="{Binding ArtistName}"
                                TextColor="{DynamicResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Grid>

                    <!--  Duration  -->
                    <Label Grid.Column="2"
                        FontFamily="PoppinsRegular"
                        FontSize="12"
                        HorizontalOptions="End"
                        Text="{Binding DurationTimeSpan, StringFormat='{0:mm\\:ss}'}"
                        TextColor="{DynamicResource TextSecondary}"
                        VerticalOptions="Center" />

                    <!--  Provider (Icon)  -->
                    <ffimageloading:SvgCachedImage Grid.Column="3"
                        HeightRequest="16"
                        HorizontalOptions="Center"
                        Source="{Binding ProviderManifest.IconSvg}"
                        VerticalOptions="Center"
                        WidthRequest="16">
                        <ffimageloading:SvgCachedImage.Triggers>
                            <DataTrigger Binding="{Binding ProviderManifest.IconSvg}"
                                TargetType="ffimageloading:SvgCachedImage"
                                Value="{x:Null}">
                                <Setter Property="IsVisible"
                                    Value="False" />
                            </DataTrigger>
                        </ffimageloading:SvgCachedImage.Triggers>
                    </ffimageloading:SvgCachedImage>

                    <!--  Selection checkbox  -->
                    <Border Grid.Column="4"
                        BackgroundColor="Transparent"
                        HeightRequest="20"
                        HorizontalOptions="Center"
                        IsVisible="{Binding Source={x:Reference self}, Path=HasSelection}"
                        InputTransparent="True"
                        Margin="0"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Border BackgroundColor="Transparent"
                            HeightRequest="20"
                            HorizontalOptions="Center"
                            Stroke="{DynamicResource IconSecondary}"
                            StrokeThickness="1"
                            VerticalOptions="Center"
                            WidthRequest="20">
                            <Border.StrokeShape>
                                <Ellipse />
                            </Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}"
                                    TargetType="Border"
                                    Value="True">
                                    <Setter Property="BackgroundColor"
                                        Value="{DynamicResource AccentColor}" />
                                    <Setter Property="Stroke"
                                        Value="{DynamicResource AccentColor}" />
                                    <Setter Property="StrokeThickness"
                                        Value="1" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                IsVisible="{Binding IsSelected}"
                                Text="{mi:Fluent Icon=Checkmark16, FontOverride=True}"
                                TextColor="{DynamicResource IconPrimary}"
                                VerticalOptions="Center" />
                        </Border>
                    </Border>

                    <!--  Context Menu Button  -->
                    <Border x:Name="TrackMoreButton"
                        Grid.Column="4"
                        WidthRequest="40"
                        HeightRequest="40"
                        Padding="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        IsVisible="{Binding Source={x:Reference self}, Path=HasSelection, Converter={StaticResource InvertedBoolConverter}}"
                        BackgroundColor="Transparent"
                        StrokeThickness="0">
                        <Border.Behaviors>
                            <toolkit:TouchBehavior
                                PressedBackgroundColor="{StaticResource SelectionBackground}"
                                PressedAnimationDuration="250"
                                PressedAnimationEasing="CubicOut" />
                        </Border.Behaviors>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMoreButtonTapped" />
                        </Border.GestureRecognizers>
                        <Label
                            FontSize="18"
                            HorizontalOptions="Center"
                            Text="{mi:Fluent Icon=MoreVertical48, FontOverride=True}"
                            TextColor="{DynamicResource IconSecondary}"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  Queue Item Row Template  -->
        <DataTemplate x:Key="QueueItemTemplate" x:DataType="models:QueueItem">
            <Border Padding="8,6"
                BackgroundColor="Transparent"
                StrokeThickness="0">
                <Border.Behaviors>
                    <toolkit:TouchBehavior PressedBackgroundColor="{StaticResource SelectionBackground}"
                        LongPressCompleted="OnRowLongPressCompleted"
                        LongPressDuration="420"
                        PressedAnimationDuration="250"
                        PressedAnimationEasing="CubicOut"
                        ShouldMakeChildrenInputTransparent="False"
                        TouchGestureCompleted="OnRowTouchCompleted" />
                </Border.Behaviors>
                <Border.Triggers>
                    <DataTrigger Binding="{Binding MediaItem.IsSelected}"
                        TargetType="Border"
                        Value="True">
                        <Setter Property="BackgroundColor"
                            Value="{DynamicResource SelectionBackground}" />
                    </DataTrigger>
                </Border.Triggers>

                <Grid ColumnDefinitions="52,*,Auto,20,40"
                    ColumnSpacing="10">
                    <Grid Grid.ColumnSpan="2"
                        ColumnDefinitions="52,*"
                        ColumnSpacing="10">
                        <Border Grid.Column="0"
                            BackgroundColor="{DynamicResource BackgroundTertiary}"
                            HeightRequest="52"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            WidthRequest="52">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid>
                                <ffimageloading:CachedImage Aspect="AspectFill"
                                    LoadingPriority="{Binding MediaItem, Converter={StaticResource MediaItemLoadingPriorityConverter}}"
                                    IsVisible="{Binding MediaItem.ImageUri, Converter={StaticResource StringNullOrWhiteSpaceToBoolConverter}, ConverterParameter=invert}"
                                    Source="{Binding MediaItem.ImageUri, Converter={StaticResource ImageUriSizeConverter}, ConverterParameter=80}" />
                                <Image Aspect="AspectFill"
                                    IsVisible="{Binding MediaItem.ImageUri, Converter={StaticResource StringNullOrWhiteSpaceToBoolConverter}}"
                                    Source="{AppThemeBinding Light=placeholders/track_light.png, Dark=placeholders/track_dark.png}" />
                            </Grid>
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                            Spacing="1"
                            VerticalOptions="Center">
                            <Grid ColumnDefinitions="Auto,*"
                                ColumnSpacing="6"
                                HorizontalOptions="Fill"
                                VerticalOptions="Center">
                                <Grid IsVisible="False"
                                    Grid.Column="0"
                                    VerticalOptions="Center">
                                    <Grid.Triggers>
                                        <DataTrigger TargetType="Grid"
                                            Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource StringEqualsConverter}">
                                                    <Binding Path="MediaItem.Uri" />
                                                    <Binding Path="CurrentTrackUri"
                                                        Source="{x:Reference self}" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter Property="IsVisible"
                                                Value="True" />
                                        </DataTrigger>
                                    </Grid.Triggers>

                                    <Label FontSize="12"
                                        HorizontalOptions="Center"
                                        IsVisible="{Binding Path=CurrentPlayState, Source={x:Reference self}, Converter={StaticResource PlayStateToBoolConverter}, ConverterParameter=show-play-icon}"
                                        Text="{mi:FluentFilled Icon=Play12Filled, FontOverride=True}"
                                        TextColor="{DynamicResource AccentColor}"
                                        VerticalOptions="Center" />

                                    <Label FontSize="12"
                                        HorizontalOptions="Center"
                                        IsVisible="{Binding Path=CurrentPlayState, Source={x:Reference self}, Converter={StaticResource PlayStateToBoolConverter}, ConverterParameter=show-pause-icon}"
                                        Text="{mi:FluentFilled Icon=Pause12Filled, FontOverride=True}"
                                        TextColor="{DynamicResource AccentColor}"
                                        VerticalOptions="Center" />

                                    <ActivityIndicator Color="{DynamicResource AccentColor}"
                                        HeightRequest="12"
                                        HorizontalOptions="Center"
                                        IsRunning="{Binding Path=CurrentPlayState, Source={x:Reference self}, Converter={StaticResource PlayStateToBoolConverter}, ConverterParameter=buffering}"
                                        IsVisible="{Binding Path=CurrentPlayState, Source={x:Reference self}, Converter={StaticResource PlayStateToBoolConverter}, ConverterParameter=buffering}"
                                        VerticalOptions="Center"
                                        WidthRequest="12" />
                                </Grid>

                                <Label FontFamily="PoppinsRegular"
                                    Grid.Column="1"
                                    FontSize="14"
                                    HorizontalOptions="Fill"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1"
                                    Text="{Binding MediaItem.DisplayName}"
                                    TextColor="{DynamicResource TextPrimary}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                            Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource StringEqualsConverter}">
                                                    <Binding Path="MediaItem.Uri" />
                                                    <Binding Path="CurrentTrackUri"
                                                        Source="{x:Reference self}" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter Property="TextColor"
                                                Value="{DynamicResource AccentColor}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                            <Label FontFamily="PoppinsRegular"
                                FontSize="12"
                                LineBreakMode="TailTruncation"
                                MaxLines="1"
                                Text="{Binding MediaItem.ArtistName}"
                                TextColor="{DynamicResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Grid.Column="2"
                        FontFamily="PoppinsRegular"
                        FontSize="12"
                        HorizontalOptions="End"
                        Text="{Binding DurationTimeSpan, StringFormat='{0:mm\\:ss}'}"
                        TextColor="{DynamicResource TextSecondary}"
                        VerticalOptions="Center" />

                    <ffimageloading:SvgCachedImage Grid.Column="3"
                        HeightRequest="16"
                        HorizontalOptions="Center"
                        Source="{Binding MediaItem.ProviderManifest.IconSvg}"
                        VerticalOptions="Center"
                        WidthRequest="16">
                        <ffimageloading:SvgCachedImage.Triggers>
                            <DataTrigger Binding="{Binding MediaItem.ProviderManifest.IconSvg}"
                                TargetType="ffimageloading:SvgCachedImage"
                                Value="{x:Null}">
                                <Setter Property="IsVisible"
                                    Value="False" />
                            </DataTrigger>
                        </ffimageloading:SvgCachedImage.Triggers>
                    </ffimageloading:SvgCachedImage>

                    <Border Grid.Column="4"
                        BackgroundColor="Transparent"
                        HeightRequest="20"
                        HorizontalOptions="Center"
                        IsVisible="{Binding Source={x:Reference self}, Path=HasSelection}"
                        InputTransparent="True"
                        Margin="0"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Border BackgroundColor="Transparent"
                            HeightRequest="20"
                            HorizontalOptions="Center"
                            Stroke="{DynamicResource IconSecondary}"
                            StrokeThickness="1"
                            VerticalOptions="Center"
                            WidthRequest="20">
                            <Border.StrokeShape>
                                <Ellipse />
                            </Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding MediaItem.IsSelected}"
                                    TargetType="Border"
                                    Value="True">
                                    <Setter Property="BackgroundColor"
                                        Value="{DynamicResource AccentColor}" />
                                    <Setter Property="Stroke"
                                        Value="{DynamicResource AccentColor}" />
                                    <Setter Property="StrokeThickness"
                                        Value="1" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                IsVisible="{Binding MediaItem.IsSelected}"
                                Text="{mi:Fluent Icon=Checkmark16, FontOverride=True}"
                                TextColor="{DynamicResource IconPrimary}"
                                VerticalOptions="Center" />
                        </Border>
                    </Border>

                    <Border Grid.Column="4"
                        WidthRequest="40"
                        HeightRequest="40"
                        Padding="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        IsVisible="{Binding Source={x:Reference self}, Path=HasSelection, Converter={StaticResource InvertedBoolConverter}}"
                        BackgroundColor="Transparent"
                        StrokeThickness="0">
                        <Border.Behaviors>
                            <toolkit:TouchBehavior
                                PressedBackgroundColor="{StaticResource SelectionBackground}"
                                PressedAnimationDuration="250"
                                PressedAnimationEasing="CubicOut" />
                        </Border.Behaviors>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMoreButtonTapped" />
                        </Border.GestureRecognizers>
                        <Label
                            FontSize="18"
                            HorizontalOptions="Center"
                            Text="{mi:Fluent Icon=MoreVertical48, FontOverride=True}"
                            TextColor="{DynamicResource IconSecondary}"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  Skeleton Row Template  -->
        <DataTemplate x:Key="SkeletonTemplate" x:DataType="models:TableViewSkeleton">
            <Grid ColumnDefinitions="52,*,32,32"
                ColumnSpacing="10"
                HeightRequest="64"
                Padding="8,6">
                <desktopControls:SkeletonLoader Grid.Column="0"
                    CornerRadius="8"
                    HeightRequest="52"
                    WidthRequest="52" />
                <VerticalStackLayout Grid.Column="1"
                    Spacing="6"
                    VerticalOptions="Center">
                    <desktopControls:SkeletonLoader CornerRadius="6"
                        HeightRequest="16"
                        HorizontalOptions="Start"
                        WidthRequest="190" />
                    <desktopControls:SkeletonLoader CornerRadius="6"
                        HeightRequest="13"
                        HorizontalOptions="Start"
                        WidthRequest="140" />
                </VerticalStackLayout>
                <desktopControls:SkeletonLoader Grid.Column="2"
                    CornerRadius="4"
                    HeightRequest="20"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    WidthRequest="20" />
                <desktopControls:SkeletonLoader Grid.Column="3"
                    CornerRadius="4"
                    HeightRequest="18"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="18" />
            </Grid>
        </DataTemplate>

        <!--  Template Selector  -->
        <controls:MobileTableViewTemplateSelector x:Key="MobileTableViewTemplateSelector"
            PlaylistTemplate="{StaticResource PlaylistTemplate}"
            QueueItemTemplate="{StaticResource QueueItemTemplate}"
            TrackTemplate="{StaticResource TrackTemplate}"
            SkeletonTemplate="{StaticResource SkeletonTemplate}" />
    </ContentView.Resources>

    <!--  Items List  -->
    <CollectionView x:Name="ItemsCollectionView"
        ItemSizingStrategy="MeasureFirstItem"
        ItemsSource="{Binding Source={x:Reference self}, Path=VisibleItems}"
        ItemsUpdatingScrollMode="KeepScrollOffset"
        Scrolled="OnItemsCollectionScrolled"
        SelectionMode="None">
        <CollectionView.GestureRecognizers>
            <PanGestureRecognizer PanUpdated="OnItemsCollectionPanUpdated" />
        </CollectionView.GestureRecognizers>
        <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
            <StaticResource Key="MobileTableViewTemplateSelector" />
        </CollectionView.ItemTemplate>
        <!--  Footer for Load More  -->
        <CollectionView.Footer>
            <Grid HeightRequest="52"
                IsVisible="{Binding Source={x:Reference self}, Path=HasMoreItems}"
                Margin="0,0,0,0">
                <Border BackgroundColor="Transparent"
                    HeightRequest="40"
                    HorizontalOptions="Center"
                    Padding="0"
                    StrokeThickness="0"
                    VerticalOptions="Center"
                    WidthRequest="40">
                    <Border.Behaviors>
                        <toolkit:TouchBehavior PressedBackgroundColor="{StaticResource SelectionBackground}"
                            PressedAnimationDuration="100"
                            PressedAnimationEasing="CubicOut"
                            PressedScale="0.92" />
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLoadMoreTapped" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <Ellipse />
                    </Border.StrokeShape>
                    <Label FontSize="18"
                        HorizontalOptions="Center"
                        Text="{mi:Fluent Icon=ChevronDown16, FontOverride=True}"
                        TextColor="{DynamicResource IconPrimary}"
                        VerticalOptions="Center" />
                </Border>
            </Grid>
        </CollectionView.Footer>
    </CollectionView>
</ContentView>




                    FontSize="15"
                    HorizontalOptions="Fill"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="TailTruncation"
                    MaxLines="1"
                    Text="{Binding DisplayName}"
                    TextColor="{DynamicResource TextPrimary}" />

                <!--  Secondary Info  -->
                <Label Grid.Row="2"
                    FontFamily="PoppinsRegular"
                    FontSize="12"
                    HorizontalOptions="Fill"
                    HorizontalTextAlignment="Center"
                    IsVisible="{Binding Owner, Converter={StaticResource StringNullOrWhiteSpaceToBoolConverter}, ConverterParameter=invert}"
                    LineBreakMode="TailTruncation"
                    MaxLines="1"
                    Text="{Binding Owner}"
                    TextColor="{DynamicResource TextSecondary}" />
            </Grid>
        </DataTemplate>

        <!--  DataTemplate for Skeletons  -->
        <DataTemplate x:Key="SkeletonTemplate" x:DataType="models:RowViewSkeleton">
            <Grid RowDefinitions="Auto,Auto,Auto"
                RowSpacing="6"
                WidthRequest="{Binding Source={x:Reference self}, Path=ItemWidth}">
                <desktopControls:SkeletonLoader Grid.Row="0"
                    CornerRadius="{Binding Source={x:Reference self}, Path=ItemCornerRadius}"
                    HeightRequest="{Binding Source={x:Reference self}, Path=CoverSize}"
                    HorizontalOptions="Center"
                    WidthRequest="{Binding Source={x:Reference self}, Path=CoverSize}" />
                <desktopControls:SkeletonLoader Grid.Row="1"
                    CornerRadius="8"
                    HeightRequest="14"
                    HorizontalOptions="Center"
                    WidthRequest="110" />
                <desktopControls:SkeletonLoader Grid.Row="2"
                    CornerRadius="8"
                    HeightRequest="12"
                    HorizontalOptions="Center"
                    WidthRequest="90" />
            </Grid>
        </DataTemplate>

        <!--  TemplateSelector to choose between DataTemplates  -->
        <controls:MobileRowViewTemplateSelector x:Key="MobileRowViewTemplateSelector"
            AlbumTemplate="{StaticResource AlbumTemplate}"
            ArtistTemplate="{StaticResource ArtistTemplate}"
            PlaylistTemplate="{StaticResource PlaylistTemplate}"
            SkeletonTemplate="{StaticResource SkeletonTemplate}"
            TrackTemplate="{StaticResource TrackTemplate}" />
    </ContentView.Resources>

    <!--  Horizontal Items  -->
    <CollectionView x:Name="ItemsCollectionView"
        HorizontalScrollBarVisibility="Never"
        ItemSizingStrategy="MeasureAllItems"
        ItemsSource="{Binding Source={x:Reference self}, Path=VisibleItems}"
        ItemsUpdatingScrollMode="KeepScrollOffset"
        SelectionMode="None"
        VerticalScrollBarVisibility="Never">
        <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Horizontal"
                ItemSpacing="8" />
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
            <StaticResource Key="MobileRowViewTemplateSelector" />
        </CollectionView.ItemTemplate>
        <!--  Footer for loading more items  -->
        <CollectionView.Footer>
            <Grid HeightRequest="{Binding Source={x:Reference self}, Path=CoverSize}"
                IsVisible="{Binding Source={x:Reference self}, Path=HasMoreItems}"
                Margin="8,0,0,0"
                VerticalOptions="Start"
                WidthRequest="{Binding Source={x:Reference self}, Path=CoverSize}">
                <Border BackgroundColor="{DynamicResource HoverBackground}"
                    HorizontalOptions="Fill"
                    Padding="0"
                    StrokeThickness="0"
                    VerticalOptions="Fill">
                    <Border.Behaviors>
                        <toolkit:TouchBehavior PressedBackgroundColor="{StaticResource SelectionBackground}"
                            PressedAnimationDuration="100"
                            PressedAnimationEasing="CubicOut" />
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLoadMoreTapped" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{Binding Source={x:Reference self}, Path=ItemCornerRadius}" />
                    </Border.StrokeShape>
                    <VerticalStackLayout HorizontalOptions="Center"
                        Spacing="8"
                        VerticalOptions="Center">
                        <Label FontFamily="PoppinsRegular"
                            FontSize="30"
                            HorizontalOptions="Center"
                            Text="{mi:Fluent Icon=ChevronRight12, FontOverride=True}"
                            TextColor="{DynamicResource IconPrimary}" />
                        <Label FontFamily="PoppinsRegular"
                            FontSize="13"
                            HorizontalOptions="Center"
                            Text="Mehr"
                            TextColor="{DynamicResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </CollectionView.Footer>
    </CollectionView>
</ContentView>


<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="mashin.Views.Mobile.Controls.RowView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:mashin.Converters"
    xmlns:controls="clr-namespace:mashin.Views.Mobile.Controls"
    xmlns:desktopControls="clr-namespace:mashin.Views.Desktop.Controls"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:models="clr-namespace:mashin.Models"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="self">

    <ContentView.Resources>
        <converters:MediaItemLoadingPriorityConverter x:Key="MediaItemLoadingPriorityConverter" />

        <!--  DataTemplate for Albums  -->
        <DataTemplate x:Key="AlbumTemplate" x:DataType="models:Album">
            <Grid RowDefinitions="Auto,Auto,Auto,6"
                BackgroundColor="Transparent"
                RowSpacing="6"
                WidthRequest="{Binding Source={x:Reference self}, Path=ItemWidth}">
                <Border Grid.RowSpan="4"
                    BackgroundColor="{DynamicResource SelectionBackground}"
                    InputTransparent="True"
                    IsVisible="{Binding IsSelected}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                </Border>

                <Border Grid.RowSpan="4"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    ZIndex="0">
                    <Border.Behaviors>
                        <toolkit:TouchBehavior
                            LongPressCompleted="OnRowLongPressCompleted"
                            LongPressDuration="420"
                            TouchGestureCompleted="OnRowTouchCompleted" />
                    </Border.Behaviors>
                </Border>

                <!--  Cover + Play Overlay  -->
                <Border Grid.Row="0"
                    HeightRequest="{Binding Source={x:Reference self}, Path=CoverSize}"
                    HorizontalOptions="Center"
                    Scale="1"
                    StrokeThickness="0"
                    WidthRequest="{Binding Source={x:Reference self}, Path=CoverSize}">
                    <Border.Behaviors>
                        <toolkit:TouchBehavior LongPressCompleted="OnRowLongPressCompleted"
                            LongPressDuration="420"
                            PressedAnimationDuration="250"
                            PressedAnimationEasing="SinOut"
                            PressedScale="0.78"
                            TouchGestureCompleted="OnRowTouchCompleted" />
                    </Border.Behaviors>
                    <Border.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}"
                            TargetType="Border"
                            Value="True">
                            <Setter Property="Scale"
                                Value="0.8" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{Binding Source={x:Reference self}, Path=ItemCornerRadius}" />
                    </Border.StrokeShape>
                    <Grid>
                        <ffimageloading:CachedImage Aspect="AspectFill"
                            LoadingPriority="{Binding ., Converter={StaticResource MediaItemLoadingPriorityConverter}}"
                            IsVisible="{Binding ImageUri, Converter={StaticResource StringNullOrWhiteSpaceToBoolConverter}, ConverterParameter=invert}"
                            Source="{Binding ImageUri}" />
                        <Image Aspect="AspectFill"
                            IsVisible="{Binding ImageUri, Converter={StaticResource StringNullOrWhiteSpaceToBoolConverter}}"
                            Source="{AppThemeBinding Light=placeholders/album_light.png, Dark=placeholders/album_dark.png}" />

                    </Grid>
                </Border>

                <ffimageloading:SvgCachedImage Grid.Row="0"
                    Margin="6,6,0,0"
                    HeightRequest="18"
                    HorizontalOptions="Start"
                    Source="{Binding ProviderManifest.IconSvg}"
                    VerticalOptions="Start"
                    WidthRequest="18"
                    ZIndex="3">
                    <ffimageloading:SvgCachedImage.Triggers>
                        <DataTrigger Binding="{Binding ProviderManifest.IconSvg}"
                            TargetType="ffimageloading:SvgCachedImage"
                            Value="{x:Null}">
                            <Setter Property="IsVisible"
                                Value="False" />
                        </DataTrigger>
                    </ffimageloading:SvgCachedImage.Triggers>
                </ffimageloading:SvgCachedImage>

                <Border Grid.Row="0"
                    Margin="0,4,4,0"
                    BackgroundColor="Transparent"
                    HeightRequest="20"
                    HorizontalOptions="End"
                    IsVisible="{Binding Source={x:Reference self}, Path=HasSelection}"
                    StrokeThickness="0"
                    VerticalOptions="Start"
                    WidthRequest="20"
                    ZIndex="3">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource ShadowColorSoft}"
                            Offset="0,1"
                            Radius="3"
                            Opacity="{DynamicResource ShadowOpacitySoft}" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRowTapped" />
                    </Border.GestureRecognizers>
                    <Border BackgroundColor="Transparent"
                        HeightRequest="20"
                        HorizontalOptions="Center"
                        Stroke="{DynamicResource IconSecondary}"
                        StrokeThickness="1"
                        VerticalOptions="Center"
                        WidthRequest="20">
                        <Border.StrokeShape>
                            <Ellipse />
                        </Border.StrokeShape>
                        <Border.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}"
                                TargetType="Border"
                                Value="True">
                                <Setter Property="BackgroundColor"
                                    Value="{DynamicResource AccentColor}" />
                                <Setter Property="Stroke"
                                    Value="{DynamicResource AccentColor}" />
                                <Setter Property="StrokeThickness"
                                    Value="1" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label FontSize="14"
                            HorizontalOptions="Center"
                            IsVisible="{Binding IsSelected}"
                            Text="{mi:Fluent Icon=Checkmark16, FontOverride=True}"
                            TextColor="{DynamicResource IconPrimary}"
                            VerticalOptions="Center" />
                    </Border>
                </Border>

                <Border Grid.Row="0"
                    Margin="6"
                    BackgroundColor="{DynamicResource OverlayPlayButtonBackground}"
                    HeightRequest="40"
                    HorizontalOptions="Start"
                    StrokeThickness="0"
                    VerticalOptions="End"
                    WidthRequest="40"
                    ZIndex="2">
                    <Border.Behaviors>
                        <toolkit:TouchBehavior PressedBackgroundColor="{StaticResource SelectionBackground}"
                            PressedAnimationDuration="250"
                            PressedAnimationEasing="SinOut" />
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPlayOverlayClicked" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Label FontSize="20"
                        HorizontalOptions="Center"
                        Text="{mi:FluentFilled Icon=Play48Filled, FontOverride=True}"
                        TextColor="{DynamicResource OverlayPlayIconColor}"
                        VerticalOptions="Center" />
                </Border>

                <!--  Primary Info  -->
                <Label Grid.Row="1"
                    FontAttributes="None"
                    FontFamily="PoppinsRegular"
                    FontSize="15"
                    HorizontalOptions="Fill"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="TailTruncation"
                    MaxLines="1"
                    Text="{Binding DisplayName}"
                    TextColor="{DynamicResource TextPrimary}" />

                <!--  Secondary Info  -->
                <Label Grid.Row="2"
                    FontFamily="PoppinsRegular"
                    FontSize="12"
                    HorizontalOptions="Fill"
                    HorizontalTextAlignment="Center"
                    IsVisible="{Binding ArtistName, Converter={StaticResource StringNullOrWhiteSpaceToBoolConverter}, ConverterParameter=invert}"
                    LineBreakMode="TailTruncation"
                    MaxLines="1"
                    Text="{Binding ArtistName}"
                    TextColor="{DynamicResource TextSecondary}" />
            </Grid>
        </DataTemplate>


<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="mashin.Views.Mobile.Controls.SlideView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:mashin.Views.Mobile.Controls"
    xmlns:desktopControls="clr-namespace:mashin.Views.Desktop.Controls"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:models="clr-namespace:mashin.Models"
    x:Name="self">

    <ContentView.Resources>

        <!--  DataTemplate for Tracks  -->
        <DataTemplate x:Key="TrackTemplate" x:DataType="models:Track">
            <Border Padding="6"
                BackgroundColor="{DynamicResource BackgroundSecondary}"
                StrokeThickness="0"
                WidthRequest="{Binding Source={x:Reference self}, Path=ItemWidth}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Grid x:Name="TrackContentHost"
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="12"
                    IsClippedToBounds="True">

                    <!--  Blurred Card Background  -->
                    <Image Grid.ColumnSpan="2"
                        Aspect="AspectFill"
                        BindingContextChanged="OnTrackBackgroundBindingContextChanged"
                        HeightRequest="{Binding Source={x:Reference TrackContentHost}, Path=Height}"
                        InputTransparent="True"
                        Opacity="0.85"
                        Scale="1.18"
                        VerticalOptions="Center"
                        WidthRequest="{Binding Source={x:Reference TrackContentHost}, Path=Width}" />

                    <!--  Dark Tint for Readability  -->
                    <Border BackgroundColor="#7F141414"
                        Grid.ColumnSpan="2"
                        InputTransparent="True"
                        StrokeThickness="0" />

                    <!--  Cover + Play Overlay  -->
                    <Border Grid.Column="0"
                        HeightRequest="{Binding Source={x:Reference self}, Path=CoverSize}"
                        HorizontalOptions="Start"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="{Binding Source={x:Reference self}, Path=CoverSize}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{Binding Source={x:Reference self}, Path=ItemCornerRadius}" />
                        </Border.StrokeShape>

                        <Grid>
                            <!--  Cover Image  -->
                            <Image Aspect="AspectFill"
                                Source="{Binding ImageUrl}" />

                            <!--  Cover Shade  -->
                            <Border BackgroundColor="#26000000"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="{Binding Source={x:Reference self}, Path=ItemCornerRadius}" />
                                </Border.StrokeShape>
                            </Border>

                            <!--  Bottom-Left Play Button  -->
                            <Grid Padding="4,0,0,4"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill">
                                <Border BackgroundColor="{DynamicResource OverlayPlayButtonBackground}"
                                    HeightRequest="28"
                                    HorizontalOptions="Start"
                                    StrokeThickness="0"
                                    VerticalOptions="End"
                                    WidthRequest="28">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPlayOverlayClicked" />
                                    </Border.GestureRecognizers>
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="15" />
                                    </Border.StrokeShape>
                                    <Label FontSize="16"
                                        HorizontalOptions="Center"
                                        Text="{mi:FluentFilled Icon=Play48Filled, FontOverride=True}"
                                        TextColor="{DynamicResource OverlayPlayIconColor}"
                                        VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!--  Primary Infos  -->
                    <Grid Grid.Column="1"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="3"
                        VerticalOptions="Center">
                        <Label Grid.Row="0"
                            FontAttributes="Bold"
                            FontFamily="PoppinsSemibold"
                            FontSize="17"
                            LineBreakMode="TailTruncation"
                            MaxLines="1"
                            Text="{Binding DisplayName}"
                            TextColor="{DynamicResource TextPrimary}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference self}, Path=PrimaryInfoTappedCommand}"
                                    CommandParameter="{Binding Album}" />
                            </Label.GestureRecognizers>
                        </Label>

                        <Label Grid.Row="1"
                            FontFamily="PoppinsRegular"
                            FontSize="12"
                            LineBreakMode="TailTruncation"
                            MaxLines="1"
                            Text="{Binding ArtistName}"
                            TextColor="{DynamicResource TextSecondary}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference self}, Path=SecondaryInfoTappedCommand}"
                                    CommandParameter="{Binding Artists[0]}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  DataTemplate for Skeletons  -->
        <DataTemplate x:Key="SkeletonTemplate" x:DataType="models:SkeletonItem">
            <Border Padding="12"
                BackgroundColor="{DynamicResource BackgroundSecondary}"
                StrokeThickness="0"
                WidthRequest="{Binding Source={x:Reference self}, Path=ItemWidth}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="Auto,*"
                    ColumnSpacing="12">
                    <desktopControls:SkeletonLoader Grid.Column="0"
                        HeightRequest="{Binding Source={x:Reference self}, Path=CoverSize}"
                        WidthRequest="{Binding Source={x:Reference self}, Path=CoverSize}"
                        CornerRadius="{Binding Source={x:Reference self}, Path=ItemCornerRadius}" />

                    <Grid Grid.Column="1"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="8"
                        VerticalOptions="Center">
                        <desktopControls:SkeletonLoader Grid.Row="0"
                            HeightRequest="18"
                            WidthRequest="150"
                            HorizontalOptions="Start"
                            CornerRadius="8" />
                        <desktopControls:SkeletonLoader Grid.Row="1"
                            HeightRequest="14"
                            WidthRequest="110"
                            HorizontalOptions="Start"
                            CornerRadius="8" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  TemplateSelector to choose between DataTemplates  -->
        <controls:SlideViewTemplateSelector x:Key="SlideViewTemplateSelector"
            TrackTemplate="{StaticResource TrackTemplate}"
            SkeletonTemplate="{StaticResource SkeletonTemplate}" />

    </ContentView.Resources>

    <!--  Horizontal Items   -->
    <CollectionView x:Name="ItemsCollectionView"
        HorizontalScrollBarVisibility="Never"
        ItemSizingStrategy="MeasureAllItems"
        ItemsSource="{Binding Source={x:Reference self}, Path=ItemsSource}"
        SelectionMode="None"
        VerticalScrollBarVisibility="Never">
        <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Horizontal"
                ItemSpacing="10" />
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
            <StaticResource Key="SlideViewTemplateSelector" />
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentView>


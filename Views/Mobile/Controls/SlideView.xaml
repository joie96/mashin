<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="mashin.Views.Mobile.Controls.SlideView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:mashin.Views.Mobile.Controls"
    xmlns:desktopControls="clr-namespace:mashin.Views.Desktop.Controls"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:fftransformations="clr-namespace:FFImageLoading.Transformations;assembly=FFImageLoading.Maui"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:models="clr-namespace:mashin.Models"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="self">

    <ContentView.Resources>

        <!--  DataTemplate for Tracks  -->
        <DataTemplate x:Key="TrackTemplate" x:DataType="models:Track">
            <Grid BackgroundColor="Transparent"
                HeightRequest="{Binding Source={x:Reference self}, Path=ItemHeight}"
                WidthRequest="{Binding Source={x:Reference self}, Path=ItemWidth}">
                <Border
                    BackgroundColor="{DynamicResource SelectionBackground}"
                    InputTransparent="True"
                    IsVisible="{Binding IsSelected}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                </Border>

                <Border
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    ZIndex="0">
                    <Border.Behaviors>
                        <toolkit:TouchBehavior
                            LongPressCompleted="OnRowLongPressCompleted"
                            LongPressDuration="420"
                            TouchGestureCompleted="OnRowTouchCompleted" />
                    </Border.Behaviors>
                </Border>

                <Border Grid.Row="0"
                    HeightRequest="{Binding Source={x:Reference self}, Path=ItemHeight}"
                    HorizontalOptions="Fill"
                    Scale="1"
                    StrokeThickness="0"
                    VerticalOptions="Center">
                    <Border.Behaviors>
                        <toolkit:TouchBehavior LongPressCompleted="OnRowLongPressCompleted"
                            LongPressDuration="420"
                            PressedAnimationDuration="250"
                            PressedAnimationEasing="CubicOut"
                            PressedScale="0.78"
                            TouchGestureCompleted="OnRowTouchCompleted" />
                    </Border.Behaviors>
                    <Border.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}"
                            TargetType="Border"
                            Value="True">
                            <Setter Property="Scale"
                                Value="0.8" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <Grid x:Name="TrackContentHost"
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="12"
                        IsClippedToBounds="True">

                        <!--  Blurred Card Background  -->
                        <Border Grid.ColumnSpan="2"
                            InputTransparent="True"
                            Padding="0"
                            StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Grid>
                                <ffimageloading:CachedImage Aspect="AspectFill"
                                    Source="{Binding ImageUri}"
                                    HeightRequest="{Binding Source={x:Reference TrackContentHost}, Path=Height}"
                                    Opacity="0.85"
                                    VerticalOptions="Center"
                                    WidthRequest="{Binding Source={x:Reference TrackContentHost}, Path=Width}">
                                    <ffimageloading:CachedImage.Transformations>
                                        <fftransformations:CropTransformation ZoomFactor="1"
                                            XOffset="0"
                                            YOffset="0"
                                            CropWidthRatio="3"
                                            CropHeightRatio="1" />
                                        <fftransformations:BlurredTransformation Radius="50" />
                                    </ffimageloading:CachedImage.Transformations>
                                </ffimageloading:CachedImage>

                                <!--  Dark Tint for Readability  -->
                                <Border BackgroundColor="#7FA9A9A9"
                                    InputTransparent="True"
                                    StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                </Border>
                            </Grid>
                        </Border>

                        <!--  Cover + Play Overlay  -->
                        <Border Grid.Column="0"
                            HeightRequest="{Binding Source={x:Reference self}, Path=CoverSize}"
                            HorizontalOptions="Start"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            WidthRequest="{Binding Source={x:Reference self}, Path=CoverSize}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="{Binding Source={x:Reference self}, Path=ItemCornerRadius}" />
                            </Border.StrokeShape>

                            <Grid>
                                <!--  Cover Image  -->
                                <ffimageloading:CachedImage Aspect="AspectFill"
                                    Source="{Binding ImageUri}" />
                            </Grid>
                        </Border>

                        <!--  Primary Infos  -->
                        <Grid Grid.Column="1"
                            RowDefinitions="Auto,Auto"
                            RowSpacing="3"
                            VerticalOptions="Center">
                            <Label Grid.Row="0"
                                FontAttributes="None"
                                FontFamily="PoppinsRegular"
                                FontSize="17"
                                LineBreakMode="TailTruncation"
                                MaxLines="1"
                                Text="{Binding DisplayName}"
                                TextColor="{DynamicResource TextPrimary}" />

                            <Label Grid.Row="1"
                                FontFamily="PoppinsRegular"
                                FontSize="12"
                                LineBreakMode="TailTruncation"
                                MaxLines="1"
                                Text="{Binding ArtistName}"
                                TextColor="{DynamicResource TextSecondary}" />
                        </Grid>
                    </Grid>
                </Border>

                <ffimageloading:SvgCachedImage
                    Margin="6,6,0,0"
                    HeightRequest="18"
                    HorizontalOptions="Start"
                    Source="{Binding ProviderManifest.IconSvg}"
                    VerticalOptions="Start"
                    WidthRequest="18"
                    ZIndex="3">
                    <ffimageloading:SvgCachedImage.Triggers>
                        <DataTrigger Binding="{Binding ProviderManifest.IconSvg}"
                            TargetType="ffimageloading:SvgCachedImage"
                            Value="{x:Null}">
                            <Setter Property="IsVisible"
                                Value="False" />
                        </DataTrigger>
                    </ffimageloading:SvgCachedImage.Triggers>
                </ffimageloading:SvgCachedImage>

                <Border
                    Margin="6"
                    BackgroundColor="{DynamicResource OverlayPlayButtonBackground}"
                    HeightRequest="28"
                    HorizontalOptions="Start"
                    StrokeThickness="0"
                    VerticalOptions="End"
                    WidthRequest="28"
                    ZIndex="2">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPlayOverlayClicked" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Label FontSize="16"
                        HorizontalOptions="Center"
                        Text="{mi:FluentFilled Icon=Play48Filled, FontOverride=True}"
                        TextColor="{DynamicResource OverlayPlayIconColor}"
                        VerticalOptions="Center" />
                </Border>

                <Border
                    Margin="0,4,4,0"
                    BackgroundColor="Transparent"
                    HeightRequest="20"
                    HorizontalOptions="End"
                    IsVisible="{Binding Source={x:Reference self}, Path=HasSelection}"
                    StrokeThickness="0"
                    VerticalOptions="Start"
                    WidthRequest="20"
                    ZIndex="3">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource ShadowColorSoft}"
                            Offset="0,1"
                            Radius="3"
                            Opacity="{DynamicResource ShadowOpacitySoft}" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRowTapped" />
                    </Border.GestureRecognizers>
                    <Border BackgroundColor="Transparent"
                        HeightRequest="20"
                        HorizontalOptions="Center"
                        Stroke="{DynamicResource IconSecondary}"
                        StrokeThickness="1"
                        VerticalOptions="Center"
                        WidthRequest="20">
                        <Border.StrokeShape>
                            <Ellipse />
                        </Border.StrokeShape>
                        <Border.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}"
                                TargetType="Border"
                                Value="True">
                                <Setter Property="BackgroundColor"
                                    Value="{DynamicResource AccentColor}" />
                                <Setter Property="Stroke"
                                    Value="{DynamicResource AccentColor}" />
                                <Setter Property="StrokeThickness"
                                    Value="1" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label FontSize="14"
                            HorizontalOptions="Center"
                            IsVisible="{Binding IsSelected}"
                            Text="{mi:Fluent Icon=Checkmark16, FontOverride=True}"
                            TextColor="{DynamicResource IconPrimary}"
                            VerticalOptions="Center" />
                    </Border>
                </Border>
            </Grid>
        </DataTemplate>

        <!--  DataTemplate for Skeletons  -->
        <DataTemplate x:Key="SkeletonTemplate" x:DataType="models:SkeletonItem">
            <Border Padding="12"
                BackgroundColor="{DynamicResource BackgroundSecondary}"
                HeightRequest="{Binding Source={x:Reference self}, Path=ItemHeight}"
                StrokeThickness="0"
                WidthRequest="{Binding Source={x:Reference self}, Path=ItemWidth}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="Auto,*"
                    ColumnSpacing="12">
                    <desktopControls:SkeletonLoader Grid.Column="0"
                        HeightRequest="{Binding Source={x:Reference self}, Path=CoverSize}"
                        WidthRequest="{Binding Source={x:Reference self}, Path=CoverSize}"
                        CornerRadius="{Binding Source={x:Reference self}, Path=ItemCornerRadius}" />

                    <Grid Grid.Column="1"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="8"
                        VerticalOptions="Center">
                        <desktopControls:SkeletonLoader Grid.Row="0"
                            HeightRequest="18"
                            WidthRequest="150"
                            HorizontalOptions="Start"
                            CornerRadius="8" />
                        <desktopControls:SkeletonLoader Grid.Row="1"
                            HeightRequest="14"
                            WidthRequest="110"
                            HorizontalOptions="Start"
                            CornerRadius="8" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  TemplateSelector to choose between DataTemplates  -->
        <controls:SlideViewTemplateSelector x:Key="SlideViewTemplateSelector"
            TrackTemplate="{StaticResource TrackTemplate}"
            SkeletonTemplate="{StaticResource SkeletonTemplate}" />

    </ContentView.Resources>

    <!--  Horizontal Items   -->
    <CollectionView x:Name="ItemsCollectionView"
        HeightRequest="{Binding Source={x:Reference self}, Path=ItemHeight}"
        HorizontalScrollBarVisibility="Never"
        ItemSizingStrategy="MeasureFirstItem"
        ItemsSource="{Binding Source={x:Reference self}, Path=VisibleItems}"
        ItemsUpdatingScrollMode="KeepScrollOffset"
        SelectionMode="None"
        VerticalScrollBarVisibility="Never">
        <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Horizontal"
                ItemSpacing="8" />
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
            <StaticResource Key="SlideViewTemplateSelector" />
        </CollectionView.ItemTemplate>
        <CollectionView.Footer>
            <Grid HeightRequest="{Binding Source={x:Reference self}, Path=CoverSize}"
                IsVisible="{Binding Source={x:Reference self}, Path=HasMoreItems}"
                Margin="8,0,0,0"
                VerticalOptions="Start"
                WidthRequest="{Binding Source={x:Reference self}, Path=CoverSize}">
                <Border BackgroundColor="{DynamicResource HoverBackground}"
                    HorizontalOptions="Fill"
                    Padding="0"
                    StrokeThickness="0"
                    VerticalOptions="Fill">
                    <Border.Behaviors>
                        <toolkit:TouchBehavior PressedBackgroundColor="{StaticResource SelectionBackground}"
                            PressedAnimationDuration="100"
                            PressedAnimationEasing="CubicOut" />
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLoadMoreTapped" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{Binding Source={x:Reference self}, Path=ItemCornerRadius}" />
                    </Border.StrokeShape>
                    <VerticalStackLayout HorizontalOptions="Center"
                        Spacing="8"
                        VerticalOptions="Center">
                        <Label FontFamily="PoppinsRegular"
                            FontSize="30"
                            HorizontalOptions="Center"
                            Text="{mi:Fluent Icon=ChevronRight12, FontOverride=True}"
                            TextColor="{DynamicResource IconPrimary}" />
                        <Label FontFamily="PoppinsRegular"
                            FontSize="13"
                            HorizontalOptions="Center"
                            Text="Mehr"
                            TextColor="{DynamicResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </CollectionView.Footer>
    </CollectionView>
</ContentView>





<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="mashin.Views.Mobile.Controls.ListView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:mashin.Views.Mobile.Controls"
    xmlns:desktopControls="clr-namespace:mashin.Views.Desktop.Controls"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:models="clr-namespace:mashin.Models"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="self">

    <ContentView.Resources>
        <DataTemplate x:Key="PlaylistTemplate" x:DataType="models:Playlist">
            <Border
                BackgroundColor="{DynamicResource BackgroundSecondary}"
                HeightRequest="50"
                WidthRequest="{Binding Source={x:Reference self}, Path=ItemWidth}"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="10,*,32">
                    <Border Grid.Column="0"
                        BackgroundColor="{DynamicResource AccentColor}"
                        Loaded="OnAccentBarLoaded"
                        StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10,0,0,10" />
                        </Border.StrokeShape>
                    </Border>

                    <Label Grid.Column="1"
                        FontAttributes="Bold"
                        FontFamily="PoppinsRegular"
                        FontSize="14"
                        LineBreakMode="TailTruncation"
                        Margin="12,6,8,6"
                        MaxLines="1"
                        Text="{Binding DisplayName}"
                        TextColor="{DynamicResource TextSecondary}"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference self}, Path=PrimaryInfoTappedCommand}"
                                CommandParameter="{Binding .}" />
                        </Label.GestureRecognizers>
                    </Label>

                    <Border Grid.Column="2"
                        BackgroundColor="{DynamicResource OverlayPlayButtonBackground}"
                        HeightRequest="28"
                        HorizontalOptions="End"
                        Margin="0,0,2,0"
                        Padding="0"
                        Stroke="{DynamicResource IconSecondary}"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="1"
                        VerticalOptions="Center"
                        WidthRequest="28">
                        <Border.Behaviors>
                            <toolkit:TouchBehavior PressedBackgroundColor="{StaticResource SelectionBackground}"
                                PressedAnimationDuration="250"
                                PressedAnimationEasing="SinOut" />
                        </Border.Behaviors>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPlayOverlayClicked" />
                        </Border.GestureRecognizers>
                        <Label FontSize="16"
                            HorizontalOptions="Center"
                            Text="{mi:FluentFilled Icon=Play48Filled, FontOverride=True}"
                            TextColor="{DynamicResource OverlayPlayIconColor}"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SkeletonTemplate" x:DataType="models:ListViewSkeleton">
            <Border
                BackgroundColor="{DynamicResource BackgroundSecondary}"
                HeightRequest="50"
                WidthRequest="{Binding Source={x:Reference self}, Path=ItemWidth}"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="10,*">
                    <desktopControls:SkeletonLoader Grid.Column="0"
                        CornerRadius="8"
                        HeightRequest="74"
                        WidthRequest="10" />
                    <Grid Grid.Column="1"
                        Padding="12,6">
                        <desktopControls:SkeletonLoader
                            CornerRadius="8"
                            HeightRequest="26"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="180" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <controls:MobileListViewTemplateSelector x:Key="MobileListViewTemplateSelector"
            PlaylistTemplate="{StaticResource PlaylistTemplate}"
            SkeletonTemplate="{StaticResource SkeletonTemplate}" />
    </ContentView.Resources>

    <CollectionView x:Name="ItemsCollectionView"
        HorizontalOptions="Fill"
        HorizontalScrollBarVisibility="Never"
        ItemSizingStrategy="MeasureAllItems"
        SelectionMode="None"
        VerticalScrollBarVisibility="Never">
        <CollectionView.ItemsLayout>
            <GridItemsLayout HorizontalItemSpacing="8"
                Orientation="Horizontal"
                SnapPointsAlignment="Start"
                SnapPointsType="Mandatory"
                Span="3"
                VerticalItemSpacing="8" />
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
            <StaticResource Key="MobileListViewTemplateSelector" />
        </CollectionView.ItemTemplate>
        <CollectionView.Footer>
            <Grid HeightRequest="166"
                IsVisible="{Binding Source={x:Reference self}, Path=HasMoreItems}"
                Margin="8,0,0,0"
                WidthRequest="166">
                <Border BackgroundColor="{DynamicResource HoverBackground}"
                    HorizontalOptions="Fill"
                    Padding="0"
                    StrokeThickness="0"
                    VerticalOptions="Fill">
                    <Border.Behaviors>
                        <toolkit:TouchBehavior PressedBackgroundColor="{StaticResource SelectionBackground}"
                            PressedAnimationDuration="100"
                            PressedAnimationEasing="CubicOut" />
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLoadMoreTapped" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout HorizontalOptions="Center"
                        Spacing="8"
                        VerticalOptions="Center">
                        <Label FontFamily="PoppinsRegular"
                            FontSize="30"
                            HorizontalOptions="Center"
                            Text="{mi:Fluent Icon=ChevronRight12, FontOverride=True}"
                            TextColor="{DynamicResource IconPrimary}" />
                        <Label FontFamily="PoppinsRegular"
                            FontSize="13"
                            HorizontalOptions="Center"
                            Text="Mehr"
                            TextColor="{DynamicResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </CollectionView.Footer>
    </CollectionView>
</ContentView>

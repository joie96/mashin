<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="mashin.Views.Mobile.Controls.PlayerBarOverlay"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:mashin.Views.Desktop.Behaviors"
    xmlns:converters="clr-namespace:mashin.Converters"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:models="clr-namespace:mashin.Models"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="self">

    <ContentView.Resources>
        <!--  Playback State Converter  -->
        <converters:PlayStateToBoolConverter x:Key="PlayStateToBoolConverter" />
        <converters:StringEqualsConverter x:Key="StringEqualsConverter" />
    </ContentView.Resources>

    <Grid>
        <!--  Backdrop for tap-to-dismiss  -->
        <BoxView x:Name="Backdrop"
            BackgroundColor="#80000000"
            Opacity="0">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackdropTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!--  Fullscreen overlay sheet with swipe-down dismiss  -->
        <Border x:Name="OverlaySheet"
            BackgroundColor="{DynamicResource BackgroundSecondary}"
            Padding="0,20,0,20"
            StrokeThickness="0"
            TranslationY="1200"
            VerticalOptions="Fill">
            <Border.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnSheetPanUpdated" />
            </Border.GestureRecognizers>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0" />
            </Border.StrokeShape>

            <Grid RowDefinitions="Auto,*,Auto"
                RowSpacing="0">

                <VerticalStackLayout Grid.Row="0"
                    x:Name="TopContentLayout"
                    Spacing="14">

                    <!--  Cover  -->
                    <Border x:Name="CoverArtBorder"
                        Margin="16,0,16,0"
                        BackgroundColor="{DynamicResource BackgroundTertiary}"
                        HorizontalOptions="Fill"
                        StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnSheetPanUpdated" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Grid>
                            <ffimageloading:CachedImage Aspect="AspectFill"
                                IsVisible="{Binding CurrentQueueItem.MediaItem.ImageUri, Converter={StaticResource StringNullOrWhiteSpaceToBoolConverter}, ConverterParameter=invert}"
                                Source="{Binding CurrentQueueItem.MediaItem.ImageUri}" />
                            <Image Aspect="AspectFill"
                                IsVisible="{Binding CurrentQueueItem.MediaItem.ImageUri, Converter={StaticResource StringNullOrWhiteSpaceToBoolConverter}}"
                                Source="{AppThemeBinding Light=placeholders/track_light.png, Dark=placeholders/track_dark.png}" />
                        </Grid>
                    </Border>

                    <!--  Progress slider and time labels  -->
                    <VerticalStackLayout x:Name="ProgressSection"
                        Margin="16,8,16,0"
                        Spacing="6">
                        <Slider Maximum="{Binding Duration}"
                            MaximumTrackColor="{DynamicResource BackgroundTertiary}"
                            Minimum="0"
                            MinimumTrackColor="{DynamicResource IconSecondary}"
                            ThumbColor="{DynamicResource IconPrimary}"
                            Value="{Binding SliderPosition, Mode=TwoWay}">
                            <Slider.Behaviors>
                                <behaviors:SliderDragCompletedBehavior StartedCommand="{Binding BeginSeekCommand}" Command="{Binding SeekCommand}" />
                            </Slider.Behaviors>
                        </Slider>

                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label FontFamily="PoppinsRegular"
                                FontSize="12"
                                Text="{Binding PositionText}"
                                TextColor="{DynamicResource TextSecondary}" />
                            <Label Grid.Column="2"
                                FontFamily="PoppinsRegular"
                                FontSize="12"
                                HorizontalTextAlignment="End"
                                Text="{Binding DurationText}"
                                TextColor="{DynamicResource TextSecondary}" />
                        </Grid>
                    </VerticalStackLayout>

                    <!--  Track metadata  -->
                    <VerticalStackLayout x:Name="MetadataSection"
                        Margin="16,0,16,0"
                        HorizontalOptions="Fill"
                        Spacing="3"
                        VerticalOptions="Start">
                        <VerticalStackLayout.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnSheetPanUpdated" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Label FontFamily="PoppinsRegular"
                            FontSize="24"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="TailTruncation"
                            MaxLines="2"
                            Text="{Binding CurrentQueueItem.MediaItem.DisplayName}"
                            TextColor="{DynamicResource TextPrimary}" />
                        <Label FontFamily="PoppinsRegular"
                            FontSize="16"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="TailTruncation"
                            MaxLines="1"
                            Text="{Binding CurrentQueueItem.MediaItem.AlbumName}"
                            TextColor="{DynamicResource TextTertiary}" />
                        <Label FontFamily="PoppinsRegular"
                            FontSize="14"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="TailTruncation"
                            MaxLines="1"
                            Text="{Binding CurrentQueueItem.MediaItem.ArtistName}"
                            TextColor="{DynamicResource TextSecondary}" />
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <!--  Playback controls  -->
                <HorizontalStackLayout x:Name="PlaybackControlsRow"
                    Grid.Row="1"
                    HorizontalOptions="Center"
                    Spacing="18"
                    VerticalOptions="Center">
                    <Border BackgroundColor="{DynamicResource ActionButtonsBackground}"
                        HeightRequest="44"
                        StrokeThickness="0"
                        WidthRequest="44">
                        <Border.Behaviors>
                            <toolkit:TouchBehavior PressedBackgroundColor="{StaticResource SelectionBackground}"
                                PressedAnimationDuration="250"
                                PressedAnimationEasing="CubicOut" />
                        </Border.Behaviors>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleShuffleCommand}" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>
                        <Label FontSize="20"
                            HorizontalOptions="Center"
                            Text="{mi:Fluent Icon=ArrowShuffle24, FontOverride=True}"
                            TextColor="{DynamicResource IconSecondary}"
                            VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger Binding="{Binding IsShuffleActive}"
                                    TargetType="Label"
                                    Value="True">
                                    <Setter Property="TextColor" Value="{DynamicResource AccentColor}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>

                    <Border BackgroundColor="{DynamicResource ActionButtonsBackground}"
                        HeightRequest="44"
                        StrokeThickness="0"
                        WidthRequest="44">
                        <Border.Behaviors>
                            <toolkit:TouchBehavior PressedBackgroundColor="{StaticResource SelectionBackground}"
                                PressedAnimationDuration="250"
                                PressedAnimationEasing="CubicOut" />
                        </Border.Behaviors>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PreviousTrackCommand}" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>
                        <Label FontSize="22"
                            HorizontalOptions="Center"
                            Text="{mi:FluentFilled Icon=Previous48Filled, FontOverride=True}"
                            TextColor="{DynamicResource IconPrimary}"
                            VerticalOptions="Center" />
                    </Border>

                    <Border BackgroundColor="{DynamicResource IconPrimary}"
                        HeightRequest="60"
                        Margin="4,0"
                        StrokeThickness="0"
                        WidthRequest="60">
                        <Border.Behaviors>
                            <toolkit:TouchBehavior PressedBackgroundColor="{StaticResource SelectionBackground}"
                                PressedAnimationDuration="250"
                                PressedAnimationEasing="SinOut" />
                        </Border.Behaviors>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TogglePlayPauseCommand}" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="30" />
                        </Border.StrokeShape>
                        <Grid>
                            <Label FontSize="26"
                                HorizontalOptions="Center"
                                IsVisible="{Binding PlayState, Converter={StaticResource PlayStateToBoolConverter}, ConverterParameter=paused}"
                                Text="{mi:FluentFilled Icon=Play48Filled, FontOverride=True}"
                                TextColor="{DynamicResource BackgroundPrimary}"
                                VerticalOptions="Center" />
                            <Label FontSize="26"
                                HorizontalOptions="Center"
                                IsVisible="{Binding PlayState, Converter={StaticResource PlayStateToBoolConverter}, ConverterParameter=playing}"
                                Text="{mi:FluentFilled Icon=Pause48Filled, FontOverride=True}"
                                TextColor="{DynamicResource BackgroundPrimary}"
                                VerticalOptions="Center" />
                            <ActivityIndicator HeightRequest="20"
                                IsRunning="{Binding PlayState, Converter={StaticResource PlayStateToBoolConverter}, ConverterParameter=buffering}"
                                IsVisible="{Binding PlayState, Converter={StaticResource PlayStateToBoolConverter}, ConverterParameter=buffering}"
                                Scale="1.5"
                                WidthRequest="20"
                                Color="{DynamicResource BackgroundPrimary}" />
                        </Grid>
                    </Border>

                    <Border BackgroundColor="{DynamicResource ActionButtonsBackground}"
                        HeightRequest="44"
                        StrokeThickness="0"
                        WidthRequest="44">
                        <Border.Behaviors>
                            <toolkit:TouchBehavior PressedBackgroundColor="{StaticResource SelectionBackground}"
                                PressedAnimationDuration="250"
                                PressedAnimationEasing="CubicOut" />
                        </Border.Behaviors>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NextTrackCommand}" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>
                        <Label FontSize="22"
                            HorizontalOptions="Center"
                            Text="{mi:FluentFilled Icon=Next48Filled, FontOverride=True}"
                            TextColor="{DynamicResource IconPrimary}"
                            VerticalOptions="Center" />
                    </Border>

                    <Border BackgroundColor="{DynamicResource ActionButtonsBackground}"
                        HeightRequest="44"
                        StrokeThickness="0"
                        WidthRequest="44">
                        <Border.Behaviors>
                            <toolkit:TouchBehavior PressedBackgroundColor="{StaticResource SelectionBackground}"
                                PressedAnimationDuration="250"
                                PressedAnimationEasing="CubicOut" />
                        </Border.Behaviors>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleRepeatModeCommand}" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>
                        <Grid>
                            <Label FontSize="20"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ArrowRepeatAll24, FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger Binding="{Binding IsRepeatEnabled}"
                                        TargetType="Label"
                                        Value="True">
                                        <Setter Property="TextColor" Value="{DynamicResource AccentColor}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label FontAttributes="Bold"
                                FontSize="9"
                                HorizontalOptions="End"
                                IsVisible="{Binding IsRepeatOne}"
                                Margin="0,0,5,6"
                                Text="1"
                                TextColor="{DynamicResource AccentColor}"
                                VerticalOptions="End" />
                        </Grid>
                    </Border>
                </HorizontalStackLayout>

                <!--  Secondary action controls  -->
                <HorizontalStackLayout x:Name="SecondaryControlsRow"
                    Grid.Row="2"
                    HorizontalOptions="Center"
                    Spacing="18">
                    <Border x:Name="CurrentTrackAddToPlaylistButton"
                        BackgroundColor="{DynamicResource ActionButtonsBackground}"
                        HeightRequest="44"
                        StrokeThickness="0"
                        WidthRequest="44">
                        <Border.Behaviors>
                            <toolkit:TouchBehavior PressedBackgroundColor="{StaticResource SelectionBackground}"
                                PressedAnimationDuration="250"
                                PressedAnimationEasing="CubicOut" />
                        </Border.Behaviors>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowCurrentTrackContextMenuCommand}"
                                CommandParameter="{x:Reference CurrentTrackAddToPlaylistButton}" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>
                        <Label FontSize="20"
                            HorizontalOptions="Center"
                            Text="{mi:Fluent Icon=Add24, FontOverride=True}"
                            TextColor="{DynamicResource IconSecondary}"
                            VerticalOptions="Center" />
                    </Border>

                    <Border BackgroundColor="{DynamicResource ActionButtonsBackground}"
                        HeightRequest="44"
                        StrokeThickness="0"
                        WidthRequest="44">
                        <Border.Behaviors>
                            <toolkit:TouchBehavior PressedBackgroundColor="{StaticResource SelectionBackground}"
                                PressedAnimationDuration="250"
                                PressedAnimationEasing="CubicOut" />
                        </Border.Behaviors>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleCurrentTrackFavoriteCommand}" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>
                        <Grid>
                            <Label FontSize="20"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=Heart24, FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger Binding="{Binding CurrentQueueItem.MediaItem.Favorite}"
                                        TargetType="Label"
                                        Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label FontSize="20"
                                HorizontalOptions="Center"
                                IsVisible="False"
                                Text="{mi:FluentFilled Icon=Heart48Filled, FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger Binding="{Binding CurrentQueueItem.MediaItem.Favorite}"
                                        TargetType="Label"
                                        Value="True">
                                        <Setter Property="IsVisible" Value="True" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                    </Border>

                    <Border x:Name="QueueButton"
                        BackgroundColor="{DynamicResource ActionButtonsBackground}"
                        HeightRequest="44"
                        StrokeThickness="0"
                        WidthRequest="44">
                        <Border.Behaviors>
                            <toolkit:TouchBehavior PressedBackgroundColor="{StaticResource SelectionBackground}"
                                PressedAnimationDuration="250"
                                PressedAnimationEasing="CubicOut" />
                        </Border.Behaviors>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnQueueButtonTapped" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>
                        <Label FontSize="20"
                            HorizontalOptions="Center"
                            Text="{mi:Fluent Icon=RowTriple24, FontOverride=True}"
                            TextColor="{DynamicResource IconSecondary}"
                            VerticalOptions="Center" />
                    </Border>

                    <Border BackgroundColor="{DynamicResource ActionButtonsBackground}"
                        HeightRequest="44"
                        StrokeThickness="0"
                        WidthRequest="44">
                        <Border.Behaviors>
                            <toolkit:TouchBehavior PressedBackgroundColor="{StaticResource SelectionBackground}"
                                PressedAnimationDuration="250"
                                PressedAnimationEasing="CubicOut" />
                        </Border.Behaviors>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleDontStopTheMusicCommand}" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>
                        <Label FontSize="20"
                            HorizontalOptions="Center"
                            Text="{mi:Fluent Icon=Communication16, FontOverride=True}"
                            TextColor="{DynamicResource IconSecondary}"
                            VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger Binding="{Binding IsDontStopTheMusicEnabled}"
                                    TargetType="Label"
                                    Value="True">
                                    <Setter Property="TextColor" Value="{DynamicResource AccentColor}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>

                    <Border BackgroundColor="{DynamicResource ActionButtonsBackground}"
                        HeightRequest="44"
                        StrokeThickness="0"
                        WidthRequest="44">
                        <Border.Behaviors>
                            <toolkit:TouchBehavior PressedBackgroundColor="{StaticResource SelectionBackground}"
                                PressedAnimationDuration="250"
                                PressedAnimationEasing="CubicOut" />
                        </Border.Behaviors>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleDeviceSelectionFlyoutCommand}" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>
                        <Label FontSize="20"
                            HorizontalOptions="Center"
                            Text="{mi:Fluent Icon=PhoneDesktop24, FontOverride=True}"
                            TextColor="{DynamicResource IconSecondary}"
                            VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger Binding="{Binding IsDeviceSelectionFlyoutOpen}"
                                    TargetType="Label"
                                    Value="True">
                                    <Setter Property="TextColor" Value="{DynamicResource AccentColor}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>

                    <Border BackgroundColor="{DynamicResource ActionButtonsBackground}"
                        HeightRequest="44"
                        StrokeThickness="0"
                        WidthRequest="44">
                        <Border.Behaviors>
                            <toolkit:TouchBehavior PressedBackgroundColor="{StaticResource SelectionBackground}"
                                PressedAnimationDuration="250"
                                PressedAnimationEasing="CubicOut" />
                        </Border.Behaviors>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleAudioOptionsFlyoutCommand}" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>
                        <Label FontSize="20"
                            HorizontalOptions="Center"
                            Text="{mi:Fluent Icon=Options24, FontOverride=True}"
                            TextColor="{DynamicResource IconSecondary}"
                            VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger Binding="{Binding IsAudioOptionsFlyoutOpen}"
                                    TargetType="Label"
                                    Value="True">
                                    <Setter Property="TextColor" Value="{DynamicResource AccentColor}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!--  Device Selection Overlay  -->
        <Grid IsVisible="{Binding IsDeviceSelectionFlyoutOpen}"
            ZIndex="140">
            <BoxView BackgroundColor="#80000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseDeviceSelectionFlyoutCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border
                Padding="0"
                BackgroundColor="{DynamicResource BackgroundSecondary}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="340"
                MaximumWidthRequest="360"
                Stroke="{DynamicResource SeparatorColor}"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{DynamicResource ShadowColorStrong}"
                        Opacity="{DynamicResource ShadowOpacityStrong}"
                        Radius="20"
                        Offset="0,8" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="0">
                    <Label FontSize="14"
                        FontFamily="PoppinsSemibold"
                        Margin="16,14,16,10"
                        Text="Wiedergabegeraet"
                        TextColor="{DynamicResource TextPrimary}" />

                    <BoxView
                        Margin="0,0,0,4"
                        HeightRequest="1"
                        BackgroundColor="{DynamicResource SeparatorColor}" />

                    <VerticalStackLayout Padding="16,10,16,14"
                        Spacing="10">

                        <ActivityIndicator Color="{DynamicResource AccentColor}"
                            IsRunning="{Binding IsLoadingPlayers}"
                            IsVisible="{Binding IsLoadingPlayers}" />

                        <Label FontSize="12"
                            IsVisible="{Binding HasNoAvailablePlayers}"
                            Text="Keine Music-Assistant-Geraete gefunden."
                            TextColor="{DynamicResource TextSecondary}" />

                        <ScrollView MaximumHeightRequest="280">
                            <VerticalStackLayout
                                BindableLayout.ItemsSource="{Binding AvailablePlayers}"
                                RadioButtonGroup.GroupName="MobileDeviceSelection"
                                RadioButtonGroup.SelectedValue="{Binding SelectedPlayerId, Mode=TwoWay}"
                                Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:Player">
                                        <Border Padding="10,8"
                                            BackgroundColor="Transparent"
                                            StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>

                                            <Grid Padding="0,2"
                                                ColumnDefinitions="*,Auto"
                                                ColumnSpacing="10">
                                                <VerticalStackLayout Grid.Column="0"
                                                    Spacing="0">
                                                    <Label FontSize="14"
                                                        Text="{Binding Name}"
                                                        TextColor="{DynamicResource TextPrimary}" />
                                                </VerticalStackLayout>

                                                <RadioButton Grid.Column="1"
                                                    IsEnabled="{Binding Available}"
                                                    MinimumWidthRequest="0"
                                                    Value="{Binding PlayerId}"
                                                    VerticalOptions="Center">
                                                    <RadioButton.IsChecked>
                                                        <MultiBinding Mode="OneWay" Converter="{StaticResource StringEqualsConverter}">
                                                            <Binding Path="PlayerId" />
                                                            <Binding Path="BindingContext.SelectedPlayerId" Source="{x:Reference self}" />
                                                        </MultiBinding>
                                                    </RadioButton.IsChecked>
                                                </RadioButton>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!--  Audio Options Overlay  -->
        <Grid IsVisible="{Binding IsAudioOptionsFlyoutOpen}"
            ZIndex="141">
            <BoxView BackgroundColor="#80000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseAudioOptionsFlyoutCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border
                Padding="0"
                BackgroundColor="{DynamicResource BackgroundSecondary}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="340"
                MaximumWidthRequest="360"
                Stroke="{DynamicResource SeparatorColor}"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{DynamicResource ShadowColorStrong}"
                        Opacity="{DynamicResource ShadowOpacityStrong}"
                        Radius="20"
                        Offset="0,8" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="0">
                    <Label
                        FontSize="14"
                        FontFamily="PoppinsSemibold"
                        Margin="16,14,16,10"
                        Text="Klangqualitaet"
                        TextColor="{DynamicResource TextPrimary}" />

                    <BoxView
                        Margin="0,0,0,4"
                        HeightRequest="1"
                        BackgroundColor="{DynamicResource SeparatorColor}" />

                    <VerticalStackLayout Padding="16,10,16,14"
                        Spacing="12">
                        <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="10"
                            RowDefinitions="Auto,Auto">
                            <VerticalStackLayout Grid.Row="0"
                                Grid.Column="0"
                                Spacing="0">
                                <Label FontSize="14"
                                    Text="Standard"
                                    TextColor="{DynamicResource TextPrimary}" />
                                <Label FontSize="12"
                                    Text="Opus 256 kb/s"
                                    TextColor="{DynamicResource TextSecondary}" />
                            </VerticalStackLayout>

                            <RadioButton Grid.RowSpan="2"
                                Grid.Column="1"
                                GroupName="MobileAudioQuality"
                                HorizontalOptions="End"
                                IsChecked="{Binding IsAudioQualityOpus, Mode=TwoWay}"
                                VerticalOptions="Center"
                                MinimumWidthRequest="0" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="10"
                            RowDefinitions="Auto,Auto">
                            <Label Grid.Row="0"
                                Grid.Column="0"
                                FontSize="14"
                                Text="High Fidelity"
                                TextColor="{DynamicResource TextPrimary}" />
                            <Label Grid.Row="1"
                                Grid.Column="0"
                                FontSize="12"
                                Text="FLAC"
                                TextColor="{DynamicResource TextSecondary}" />
                            <RadioButton Grid.RowSpan="2"
                                Grid.Column="1"
                                GroupName="MobileAudioQuality"
                                HorizontalOptions="End"
                                IsChecked="{Binding IsAudioQualityFlac, Mode=TwoWay}"
                                VerticalOptions="Center"
                                MinimumWidthRequest="0" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="10"
                            RowDefinitions="Auto,Auto">
                            <Label Grid.Row="0"
                                Grid.Column="0"
                                FontSize="14"
                                Text="Studio"
                                TextColor="{DynamicResource TextPrimary}" />
                            <Label Grid.Row="1"
                                Grid.Column="0"
                                FontSize="12"
                                Text="PCM"
                                TextColor="{DynamicResource TextSecondary}" />
                            <RadioButton Grid.RowSpan="2"
                                Grid.Column="1"
                                GroupName="MobileAudioQuality"
                                HorizontalOptions="End"
                                IsChecked="{Binding IsAudioQualityPcm, Mode=TwoWay}"
                                VerticalOptions="Center"
                                MinimumWidthRequest="0" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentView>

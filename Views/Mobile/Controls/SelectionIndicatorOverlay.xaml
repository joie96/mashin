<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="mashin.Views.Mobile.Controls.SelectionIndicatorOverlay"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    BackgroundColor="Transparent"
    InputTransparent="False">

    <Border Padding="6"
        BackgroundColor="{DynamicResource BackgroundSecondary}"
        Stroke="{DynamicResource BorderColor}"
        StrokeThickness="1">
        <Border.Shadow>
            <Shadow
                Brush="{DynamicResource ShadowColorSoft}"
                Opacity="{DynamicResource ShadowOpacitySoft}"
                Radius="12"
                Offset="0,4" />
        </Border.Shadow>
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>
        <Grid ColumnDefinitions="Auto,Auto,Auto"
            ColumnSpacing="6">
            <Border Grid.Column="0"
                HeightRequest="40"
                Stroke="{DynamicResource BorderColor}"
                StrokeThickness="1"
                WidthRequest="40">
                <Border.Behaviors>
                    <toolkit:TouchBehavior
                        PressedBackgroundColor="{StaticResource SelectionBackground}"
                        PressedAnimationDuration="250"
                        PressedAnimationEasing="CubicOut" />
                </Border.Behaviors>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSelectAllTapped" />
                </Border.GestureRecognizers>
                <Label FontSize="16"
                    HorizontalTextAlignment="Center"
                    Text="{mi:Fluent Icon=ShapeSubtract16, FontOverride=True}"
                    TextColor="{DynamicResource IconPrimary}"
                    VerticalTextAlignment="Center" />
            </Border>

            <Border x:Name="MenuAnchorBorder"
                Grid.Column="1"
                HeightRequest="40"
                Stroke="{DynamicResource BorderColor}"
                StrokeThickness="1"
                WidthRequest="40">
                <Border.Behaviors>
                    <toolkit:TouchBehavior
                        PressedBackgroundColor="{StaticResource SelectionBackground}"
                        PressedAnimationDuration="250"
                        PressedAnimationEasing="CubicOut" />
                </Border.Behaviors>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMenuTapped" />
                </Border.GestureRecognizers>
                <Label FontSize="18"
                    HorizontalTextAlignment="Center"
                    Text="{mi:Fluent Icon=MoreVertical16, FontOverride=True}"
                    TextColor="{DynamicResource IconPrimary}"
                    VerticalTextAlignment="Center" />
            </Border>

            <Border Grid.Column="2"
                HeightRequest="40"
                Stroke="{DynamicResource BorderColor}"
                StrokeThickness="1"
                WidthRequest="40">
                <Border.Behaviors>
                    <toolkit:TouchBehavior
                        PressedBackgroundColor="{StaticResource SelectionBackground}"
                        PressedAnimationDuration="250"
                        PressedAnimationEasing="CubicOut" />
                </Border.Behaviors>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseTapped" />
                </Border.GestureRecognizers>
                <Label FontSize="18"
                    HorizontalTextAlignment="Center"
                    Text="{mi:Fluent Icon=Dismiss16, FontOverride=True}"
                    TextColor="{DynamicResource IconPrimary}"
                    VerticalTextAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</ContentView>



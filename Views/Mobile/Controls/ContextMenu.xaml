<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="mashin.Views.Mobile.Controls.ContextMenu"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:mashin.Converters"
    xmlns:models="clr-namespace:mashin.Models"
    x:Name="self">

    <ContentView.Resources>
        <ResourceDictionary>
            <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <Border
        Padding="0,10,0,12"
        BackgroundColor="{DynamicResource BackgroundSecondary}"
        StrokeThickness="0">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="18,18,0,0" />
        </Border.StrokeShape>

        <VerticalStackLayout Spacing="0">
            <Border
                WidthRequest="42"
                HeightRequest="5"
                Margin="0,0,0,8"
                HorizontalOptions="Center"
                StrokeThickness="0"
                BackgroundColor="{DynamicResource SeparatorColor}" />

            <ScrollView MaximumHeightRequest="{Binding MaxMenuHeight, Source={x:Reference self}}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding MenuItems, Source={x:Reference self}}" Spacing="0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ContextMenuItem">
                            <Grid>
                                <BoxView
                                    Margin="14,4"
                                    HeightRequest="1"
                                    BackgroundColor="{DynamicResource SeparatorColor}"
                                    IsVisible="{Binding IsSeparator}" />

                                <Grid
                                    Padding="18,14"
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="12"
                                    IsVisible="{Binding IsSeparator, Converter={StaticResource InvertedBoolConverter}}"
                                    Opacity="{Binding IsEnabled, Converter={StaticResource BoolToOpacityConverter}}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnMenuItemTapped" />
                                    </Grid.GestureRecognizers>

                                    <Label
                                        FontFamily="PoppinsRegular"
                                        FontSize="15"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1"
                                        Text="{Binding Text}"
                                        TextColor="{DynamicResource TextPrimary}"
                                        VerticalOptions="Center" />

                                    <Label
                                        Grid.Column="1"
                                        FontFamily="PoppinsRegular"
                                        FontSize="15"
                                        HorizontalTextAlignment="End"
                                        Text=">"
                                        TextColor="{DynamicResource TextSecondary}"
                                        VerticalOptions="Center"
                                        IsVisible="{Binding HasSubItems}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>
        </VerticalStackLayout>
    </Border>
</ContentView>

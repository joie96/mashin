<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="mashin.Views.Mobile.Controls.ContextMenu"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:mashin.Converters"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:models="clr-namespace:mashin.Models"
    x:Name="self">

    <ContentView.Resources>
        <ResourceDictionary>
            <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <Border
        x:Name="MenuSheet"
        Padding="0,10,0,12"
        BackgroundColor="{DynamicResource BackgroundSecondary}"
        StrokeThickness="0">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="18,18,0,0" />
        </Border.StrokeShape>

        <VerticalStackLayout Spacing="0">
            <Border
                Margin="0,0,0,8"
                HorizontalOptions="Center"
                BackgroundColor="{DynamicResource SeparatorColor}"
                Opacity="0.8"
                HeightRequest="4"
                WidthRequest="38"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="2" />
                </Border.StrokeShape>
            </Border>

            <CollectionView
                x:Name="MenuItemsList"
                ItemsSource="{Binding MenuItems, Source={x:Reference self}}"
                MaximumHeightRequest="{Binding MaxMenuHeight, Source={x:Reference self}}"
                SelectionMode="None"
                VerticalScrollBarVisibility="Never"
                Scrolled="OnMenuItemsScrolled">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ContextMenuItem">
                        <Grid BackgroundColor="Transparent">
                            <BoxView
                                Margin="14,4"
                                HeightRequest="1"
                                BackgroundColor="{DynamicResource SeparatorColor}"
                                IsVisible="{Binding IsSeparator}" />

                            <Grid
                                Padding="18,14"
                                ColumnDefinitions="24,*,Auto"
                                ColumnSpacing="12"
                                BackgroundColor="Transparent"
                                IsVisible="{Binding IsSeparator, Converter={StaticResource InvertedBoolConverter}}"
                                Opacity="{Binding IsEnabled, Converter={StaticResource BoolToOpacityConverter}}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnMenuItemTapped" />
                                </Grid.GestureRecognizers>

                                <Label
                                    Grid.Column="0"
                                    FontSize="18"
                                    IsVisible="{Binding HasFluentIcon}"
                                    Text="{mi:Fluent Icon={Binding FluentIcon},
                                                     FontOverride=True,
                                                     IconSize=18,
                                                     IconColor={DynamicResource IconSecondary}}"
                                    TextColor="{DynamicResource IconSecondary}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="0"
                                    FontSize="18"
                                    IsVisible="{Binding HasFluentFilledIcon}"
                                    Text="{mi:FluentFilled Icon={Binding FluentFilledIcon},
                                                           FontOverride=True,
                                                           IconSize=18,
                                                           IconColor={DynamicResource IconSecondary}}"
                                    TextColor="{DynamicResource IconSecondary}"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="1"
                                    FontFamily="PoppinsRegular"
                                    FontSize="15"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1"
                                    Text="{Binding Text}"
                                    TextColor="{DynamicResource TextPrimary}"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="2"
                                    FontFamily="PoppinsRegular"
                                    FontSize="15"
                                    HorizontalTextAlignment="End"
                                    Text=">"
                                    TextColor="{DynamicResource TextSecondary}"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding HasSubItems}" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </Border>
</ContentView>

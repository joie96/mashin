<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="mashin.Views.Desktop.AlbumDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:mashin.Views.Desktop.Behaviors"
    xmlns:controls="clr-namespace:mashin.Views.Desktop.Controls"
    xmlns:converters="clr-namespace:mashin.Converters"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:vm="clr-namespace:mashin.ViewModels"
    x:DataType="vm:AlbumDetailViewModel"
    BackgroundColor="{DynamicResource BackgroundPrimary}">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        <converters:RemoveBlankLinesConverter x:Key="RemoveBlankLinesConverter" />
    </ContentPage.Resources>

    <ScrollView>
            <Grid Padding="{StaticResource DesktopPagePadding}"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
            RowSpacing="0">

            <!--  Album Header  -->
            <Grid Grid.Row="0"
                ColumnDefinitions="200,*"
                ColumnSpacing="30">

                <!--  Album Cover - Loading State  -->
                <Border Grid.Column="0"
                    HeightRequest="200"
                    IsVisible="{Binding IsLoadingMetadata}"
                    StrokeThickness="0"
                    WidthRequest="200">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <controls:SkeletonLoader WidthRequest="200" HeightRequest="200" CornerRadius="8" />
                </Border>

                <!--  Album Cover - Actual  -->
                <Border Grid.Column="0"
                    BackgroundColor="Transparent"
                    HeightRequest="200"
                    IsVisible="{Binding IsLoadingMetadata, Converter={StaticResource InvertedBoolConverter}}"
                    StrokeThickness="0"
                    WidthRequest="200">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Grid>
                        <ffimageloading:CachedImage Aspect="AspectFill"
                            HeightRequest="200"
                            HorizontalOptions="Center"
                            IsVisible="{Binding ImageUri, Converter={StaticResource StringNullOrWhiteSpaceToBoolConverter}, ConverterParameter=invert}"
                            Source="{Binding ImageUri}"
                            VerticalOptions="Center"
                            WidthRequest="200" />
                        <Image Aspect="AspectFill"
                            HeightRequest="200"
                            HorizontalOptions="Center"
                            IsVisible="{Binding ImageUri, Converter={StaticResource StringNullOrWhiteSpaceToBoolConverter}}"
                            Source="{AppThemeBinding Light=placeholders/album_light.png, Dark=placeholders/album_dark.png}"
                            VerticalOptions="Center"
                            WidthRequest="200" />
                    </Grid>
                </Border>

                <!--  Album Info - Loading State  -->
                <VerticalStackLayout Grid.Column="1"
                    IsVisible="{Binding IsLoadingMetadata}"
                    Spacing="12"
                    VerticalOptions="Center">
                    <controls:SkeletonLoader WidthRequest="120" HeightRequest="12" HorizontalOptions="Start" />
                    <controls:SkeletonLoader WidthRequest="300" HeightRequest="32" HorizontalOptions="Start" />
                    <controls:SkeletonLoader WidthRequest="220" HeightRequest="14" HorizontalOptions="Start" />
                </VerticalStackLayout>

                <!--  Album Info - Actual  -->
                <Grid Grid.Column="1"
                    HeightRequest="200"
                    IsVisible="{Binding IsLoadingMetadata, Converter={StaticResource InvertedBoolConverter}}"
                    RowDefinitions="*,Auto,Auto,Auto,Auto"
                    VerticalOptions="Fill">

                    <Label Grid.Row="1"
                        Margin="0,0,0,8"
                        Style="{StaticResource LabelSecondary}"
                        FontAttributes="Bold"
                        FontSize="12"
                        Text="ALBUM" />

                    <HorizontalStackLayout Grid.Row="2"
                        Margin="0,0,0,8"
                        Spacing="16"
                        VerticalOptions="Center">
                        <Label FontAttributes="Bold"
                            FontSize="32"
                            LineBreakMode="WordWrap"
                            MaxLines="2"
                            Text="{Binding AlbumName}"
                            TextColor="{DynamicResource TextPrimary}" />
                        <ffimageloading:SvgCachedImage HeightRequest="28"
                            Source="{Binding Album.ProviderManifest.IconSvg}"
                            ToolTipProperties.Text="{Binding Album.ProviderName}"
                            VerticalOptions="Center"
                            WidthRequest="28">
                            <ffimageloading:SvgCachedImage.Triggers>
                                <DataTrigger Binding="{Binding Album.ProviderManifest.IconSvg}"
                                    TargetType="ffimageloading:SvgCachedImage"
                                    Value="{x:Null}">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </ffimageloading:SvgCachedImage.Triggers>
                        </ffimageloading:SvgCachedImage>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Grid.Row="3"
                        Margin="0,0,0,8"
                        Spacing="8">
                        <Label Style="{StaticResource LabelSecondary}"
                            Text="{Binding ArtistName}" />
                        <Label Style="{StaticResource LabelSecondary}"
                            Text="•" />
                        <Label Style="{StaticResource LabelSecondary}"
                            Text="{Binding AlbumYearText}" />
                        <Label Style="{StaticResource LabelSecondary}"
                            Text="•" />
                        <Label Style="{StaticResource LabelSecondary}"
                            Text="{Binding Tracks.Count, StringFormat='{0} Titel'}" />
                    </HorizontalStackLayout>

                    <Grid Grid.Row="4"
                        ColumnDefinitions="Auto,Auto,Auto,Auto"
                        ColumnSpacing="12">
                        <Border Grid.Column="0"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource ActionButtonsHoverBackground}"
                            Style="{StaticResource ActionButtonBorder}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PlayAlbumCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout HorizontalOptions="Center"
                                Spacing="8"
                                VerticalOptions="Center">
                                <Label Style="{StaticResource ActionButtonIconLabel}"
                                    Text="{mi:FluentFilled Icon=Play16Filled,
                                                     FontOverride=True}" />
                                <Label Style="{StaticResource ActionButtonTextLabel}"
                                    Text="Abspielen" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border Grid.Column="1"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource ActionButtonsHoverBackground}"
                            Style="{StaticResource ActionButtonBorder}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShuffleAlbumCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout HorizontalOptions="Center"
                                Spacing="8"
                                VerticalOptions="Center">
                                <Label Style="{StaticResource ActionButtonIconLabel}"
                                    Text="{mi:FluentFilled Icon=ArrowShuffle16Filled,
                                                     FontOverride=True}" />
                                <Label Style="{StaticResource ActionButtonTextLabel}"
                                    Text="Zufällig" />
                            </HorizontalStackLayout>
                        </Border>

                        <Label Grid.Column="2"
                            Margin="12,0,0,0"
                            behaviors:HoverBehavior.BaseTextColor="{DynamicResource IconSecondary}"
                            behaviors:HoverBehavior.EnableScaleHover="True"
                            behaviors:HoverBehavior.HoverTextColor="{DynamicResource IconPrimary}"
                            FontSize="18"
                            HorizontalOptions="Center"
                            IsVisible="{Binding IsAlbumFavorite, Converter={StaticResource InvertedBoolConverter}}"
                            Text="{mi:Fluent Icon=Heart48,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconSecondary}"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleAlbumFavoriteCommand}" />
                            </Label.GestureRecognizers>
                        </Label>

                        <Label Grid.Column="2"
                            Margin="12,0,0,0"
                            behaviors:HoverBehavior.BaseTextColor="{DynamicResource IconSecondary}"
                            behaviors:HoverBehavior.EnableScaleHover="True"
                            behaviors:HoverBehavior.HoverTextColor="{DynamicResource IconPrimary}"
                            FontSize="18"
                            HorizontalOptions="Center"
                            IsVisible="{Binding IsAlbumFavorite}"
                            Text="{mi:FluentFilled Icon=Heart48Filled,
                                           FontOverride=True}"
                            TextColor="{DynamicResource IconSecondary}"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleAlbumFavoriteCommand}" />
                            </Label.GestureRecognizers>
                        </Label>

                        <Label x:Name="AlbumHeaderMoreIconLabel"
                            Grid.Column="3"
                            Margin="6,0,0,0"
                            behaviors:HoverBehavior.BaseTextColor="{DynamicResource IconSecondary}"
                            behaviors:HoverBehavior.EnableScaleHover="True"
                            behaviors:HoverBehavior.HoverTextColor="{DynamicResource IconPrimary}"
                            FontSize="18"
                            HorizontalOptions="Center"
                            Text="{mi:Fluent Icon=MoreHorizontal48,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconSecondary}"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowHeaderContextMenuAtAnchorCommand}"
                                                      CommandParameter="{x:Reference AlbumHeaderMoreIconLabel}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Grid>
            </Grid>

            <!--  Description - Loading State  -->
            <Grid Grid.Row="1"
                Margin="{StaticResource DesktopSectionTopMargin}"
                IsVisible="{Binding IsLoadingMetadata}"
                RowDefinitions="Auto,Auto,Auto,Auto"
                RowSpacing="0">
                <controls:SkeletonLoader Grid.Row="0" WidthRequest="200" HeightRequest="18" HorizontalOptions="Start" />
                <controls:SkeletonLoader Grid.Row="1" Margin="0,16,0,0" HeightRequest="14" HorizontalOptions="Fill" />
                <controls:SkeletonLoader Grid.Row="2" Margin="0,16,0,0" HeightRequest="14" HorizontalOptions="Fill" />
                <controls:SkeletonLoader Grid.Row="3" Margin="0,16,0,0" HeightRequest="14" HorizontalOptions="Fill" />
            </Grid>

            <!--  Description - Actual  -->
            <Grid Grid.Row="2"
                Margin="{StaticResource DesktopSectionTopMargin}"
                IsVisible="{Binding HasDescription}"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="0">
                <Grid.Triggers>
                    <DataTrigger Binding="{Binding IsLoadingMetadata}"
                        TargetType="Grid"
                        Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Grid.Triggers>
                <Label Grid.Row="0"
                    Style="{StaticResource LabelSectionTitle}"
                    Text="{Binding AlbumName, StringFormat='Über {0}'}" />
                <Label Grid.Row="1"
                    Style="{StaticResource LabelSecondary}"
                    Margin="0,16,0,0"
                    LineBreakMode="WordWrap"
                    MaxLines="{Binding DescriptionMaxLines}"
                    Text="{Binding AlbumDescription, Converter={StaticResource RemoveBlankLinesConverter}}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleDescriptionCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Border Grid.Row="2"
                    Margin="0,8,0,0"
                    behaviors:HoverBehavior.EnableScaleHover="True"
                    behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                    BackgroundColor="Transparent"
                    HeightRequest="24"
                    HorizontalOptions="Center"
                    StrokeThickness="0"
                    WidthRequest="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleDescriptionCommand}" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Label FontSize="12"
                            HorizontalOptions="Center"
                            IsVisible="{Binding IsDescriptionExpanded, Converter={StaticResource InvertedBoolConverter}}"
                            Text="{mi:Fluent Icon=ChevronDown24,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconPrimary}"
                            VerticalOptions="Center" />
                        <Label FontSize="12"
                            HorizontalOptions="Center"
                            IsVisible="{Binding IsDescriptionExpanded}"
                            Text="{mi:Fluent Icon=ChevronUp24,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconPrimary}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>
            </Grid>

            <!--  Tracks Section  -->
            <Grid Grid.Row="3"
                Margin="{StaticResource DesktopSectionTopMargin}"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="0">
                <Grid Grid.Row="0"
                    ColumnDefinitions="Auto,Auto,*,Auto"
                    ColumnSpacing="16">
                    <Label Grid.Column="0"
                        Style="{StaticResource LabelSectionTitle}"
                        Text="Titel"
                        VerticalOptions="Center" />

                    <Border Grid.Column="1"
                        BackgroundColor="Transparent"
                        HeightRequest="22"
                        Margin="-6,0,0,0"
                        Padding="6,0"
                        Stroke="{DynamicResource BorderPrimary}"
                        StrokeThickness="1"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="3" />
                        </Border.StrokeShape>
                        <Label FontAttributes="Bold"
                            FontSize="10"
                            HorizontalOptions="Center"
                            Text="{Binding TrackItems.Count}"
                            TextColor="{DynamicResource TextPrimary}"
                            VerticalOptions="Center" />
                    </Border>

                    <BoxView Grid.Column="2"
                        HeightRequest="1"
                        HorizontalOptions="Fill"
                        Opacity="0.75"
                        VerticalOptions="Center" />

                    <Grid Grid.Column="3"
                        ColumnDefinitions="Auto,Auto,Auto,Auto,Auto"
                        ColumnSpacing="8"
                        VerticalOptions="Center">
                        <!--  Play button for tracks section  -->
                        <Border Grid.Column="0"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PlayTracksCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=Play16,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>

                        <!--  Shuffle button for tracks section  -->
                        <Border Grid.Column="1"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShuffleTracksCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ArrowShuffle16,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>

                        <!--  Separator between section actions and paging  -->
                        <BoxView Grid.Column="2"
                            HeightRequest="18"
                            Margin="4,0"
                            Opacity="0.75"
                            VerticalOptions="Center"
                            WidthRequest="1" />

                        <!--  Previous page in TableView  -->
                        <Border Grid.Column="3"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            InputTransparent="{Binding Source={x:Reference TracksTableView}, Path=CanGoPrev, Converter={StaticResource InvertedBoolConverter}}"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Reference TracksTableView}, Path=CanGoPrev}"
                                    TargetType="Border"
                                    Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference TracksTableView}, Path=PrevPageCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ChevronLeft24,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>

                        <!--  Next page in TableView  -->
                        <Border Grid.Column="4"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            InputTransparent="{Binding Source={x:Reference TracksTableView}, Path=CanGoNext, Converter={StaticResource InvertedBoolConverter}}"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Reference TracksTableView}, Path=CanGoNext}"
                                    TargetType="Border"
                                    Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference TracksTableView}, Path=NextPageCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ChevronRight24,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Grid>

                <controls:TableView x:Name="TracksTableView"
                    Grid.Row="1"
                    Margin="0,16,0,0"
                    PageSize="10"
                    ItemsSource="{Binding TrackItems}"
                    UserDataService="{Binding UserDataService}"
                    PlaybackContextItem="{Binding Album}"
                    PrimaryInfoTappedCommand="{Binding AlbumTappedCommand}"
                    SecondaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    ShowContextMenuAtAnchorCommand="{Binding ShowTrackContextMenuAtAnchorCommand}"
                    ShowContextMenuAtPositionCommand="{Binding ShowTrackContextMenuAtPositionCommand}" />

                <!--  Expand/collapse for tracks list  -->
                <Border Grid.Row="2"
                    Margin="0,8,0,0"
                    behaviors:HoverBehavior.EnableScaleHover="True"
                    behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                    BackgroundColor="Transparent"
                    HeightRequest="24"
                    HorizontalOptions="Center"
                    IsVisible="{Binding Source={x:Reference TracksTableView}, Path=CanToggleExpand}"
                    StrokeThickness="0"
                    WidthRequest="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={x:Reference TracksTableView}, Path=ToggleExpandCommand}" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Label FontSize="12"
                            HorizontalOptions="Center"
                            IsVisible="{Binding Source={x:Reference TracksTableView}, Path=IsExpanded, Converter={StaticResource InvertedBoolConverter}}"
                            Text="{mi:Fluent Icon=ChevronDown24,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconPrimary}"
                            VerticalOptions="Center" />
                        <Label FontSize="12"
                            HorizontalOptions="Center"
                            IsVisible="{Binding Source={x:Reference TracksTableView}, Path=IsExpanded}"
                            Text="{mi:Fluent Icon=ChevronUp24,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconPrimary}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>
            </Grid>

            <!--  Other Albums Section  -->
            <Grid Grid.Row="4"
                Margin="{StaticResource DesktopSectionTopMargin}"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="0">
                <Grid Grid.Row="0"
                    ColumnDefinitions="Auto,Auto,*,Auto"
                    ColumnSpacing="16">
                    <Label Grid.Column="0"
                        Style="{StaticResource LabelSectionTitle}"
                        Text="{Binding ArtistName, StringFormat='Weitere Alben von {0}'}"
                        VerticalOptions="Center" />

                    <Border Grid.Column="1"
                        BackgroundColor="Transparent"
                        HeightRequest="22"
                        Margin="-6,0,0,0"
                        Padding="6,0"
                        Stroke="{DynamicResource BorderPrimary}"
                        StrokeThickness="1"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="3" />
                        </Border.StrokeShape>
                        <Label FontAttributes="Bold"
                            FontSize="10"
                            HorizontalOptions="Center"
                            Text="{Binding OtherAlbumItems.Count}"
                            TextColor="{DynamicResource TextPrimary}"
                            VerticalOptions="Center" />
                    </Border>

                    <BoxView Grid.Column="2"
                        HeightRequest="1"
                        HorizontalOptions="Fill"
                        Opacity="0.75"
                        VerticalOptions="Center" />

                    <Grid Grid.Column="3"
                        ColumnDefinitions="Auto,Auto,Auto,Auto,Auto"
                        ColumnSpacing="8"
                        VerticalOptions="Center">
                        <!--  Play button for other albums section  -->
                        <Border Grid.Column="0"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PlayOtherAlbumsCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=Play16,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>

                        <!--  Shuffle button for other albums section  -->
                        <Border Grid.Column="1"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShuffleOtherAlbumsCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ArrowShuffle16,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>

                        <!--  Separator between section actions and paging  -->
                        <BoxView Grid.Column="2"
                            HeightRequest="18"
                            Margin="4,0"
                            Opacity="0.75"
                            VerticalOptions="Center"
                            WidthRequest="1" />

                        <!--  Previous page in RowView  -->
                        <Border Grid.Column="3"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            InputTransparent="{Binding Source={x:Reference OtherAlbumsRowView}, Path=CanGoPrev, Converter={StaticResource InvertedBoolConverter}}"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Reference OtherAlbumsRowView}, Path=CanGoPrev}"
                                    TargetType="Border"
                                    Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference OtherAlbumsRowView}, Path=PrevPageCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ChevronLeft24,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>

                        <!--  Next page in RowView  -->
                        <Border Grid.Column="4"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            InputTransparent="{Binding Source={x:Reference OtherAlbumsRowView}, Path=CanGoNext, Converter={StaticResource InvertedBoolConverter}}"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Reference OtherAlbumsRowView}, Path=CanGoNext}"
                                    TargetType="Border"
                                    Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference OtherAlbumsRowView}, Path=NextPageCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ChevronRight24,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Grid>

                <!--  Other Albums  -->
                <controls:RowView x:Name="OtherAlbumsRowView"
                    Grid.Row="1"
                    Margin="0,16,0,0"
                    ItemCornerRadius="8"
                    ItemsSource="{Binding OtherAlbumItems}"
                    UserDataService="{Binding UserDataService}"
                    PrimaryInfoTappedCommand="{Binding AlbumTappedCommand}"
                    SecondaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    ShowContextMenuAtAnchorCommand="{Binding ShowAlbumContextMenuAtAnchorCommand}"
                    ShowContextMenuAtPositionCommand="{Binding ShowAlbumContextMenuAtPositionCommand}" />

                <!--  Expand/collapse for other albums card list  -->
                <Border Grid.Row="2"
                    Margin="0,8,0,0"
                    behaviors:HoverBehavior.EnableScaleHover="True"
                    behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                    BackgroundColor="Transparent"
                    HeightRequest="24"
                    HorizontalOptions="Center"
                    IsVisible="{Binding Source={x:Reference OtherAlbumsRowView}, Path=CanToggleExpand}"
                    StrokeThickness="0"
                    WidthRequest="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={x:Reference OtherAlbumsRowView}, Path=ToggleExpandCommand}" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Label FontSize="12"
                            HorizontalOptions="Center"
                            IsVisible="{Binding Source={x:Reference OtherAlbumsRowView}, Path=IsExpanded, Converter={StaticResource InvertedBoolConverter}}"
                            Text="{mi:Fluent Icon=ChevronDown24,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconPrimary}"
                            VerticalOptions="Center" />
                        <Label FontSize="12"
                            HorizontalOptions="Center"
                            IsVisible="{Binding Source={x:Reference OtherAlbumsRowView}, Path=IsExpanded}"
                            Text="{mi:Fluent Icon=ChevronUp24,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconPrimary}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>
            </Grid>

            <!--  Similar Artists Section  -->
            <Grid Grid.Row="5"
                Margin="{StaticResource DesktopSectionTopMargin}"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="0">
                <Grid Grid.Row="0"
                    ColumnDefinitions="Auto,Auto,*,Auto"
                    ColumnSpacing="16">
                    <Label Grid.Column="0"
                        Style="{StaticResource LabelSectionTitle}"
                        Text="Ähnliche Interpreten"
                        VerticalOptions="Center" />

                    <Border Grid.Column="1"
                        BackgroundColor="Transparent"
                        HeightRequest="22"
                        Margin="-6,0,0,0"
                        Padding="6,0"
                        Stroke="{DynamicResource BorderPrimary}"
                        StrokeThickness="1"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="3" />
                        </Border.StrokeShape>
                        <Label FontAttributes="Bold"
                            FontSize="10"
                            HorizontalOptions="Center"
                            Text="{Binding SimilarArtistItems.Count}"
                            TextColor="{DynamicResource TextPrimary}"
                            VerticalOptions="Center" />
                    </Border>

                    <BoxView Grid.Column="2"
                        HeightRequest="1"
                        HorizontalOptions="Fill"
                        Opacity="0.75"
                        VerticalOptions="Center" />

                    <Grid Grid.Column="3"
                        ColumnDefinitions="Auto,Auto,Auto,Auto,Auto"
                        ColumnSpacing="8"
                        VerticalOptions="Center">
                        <!--  Play button for similar artists section  -->
                        <Border Grid.Column="0"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PlaySimilarArtistsCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=Play16,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>

                        <!--  Shuffle button for similar artists section  -->
                        <Border Grid.Column="1"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShuffleSimilarArtistsCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ArrowShuffle16,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>

                        <!--  Separator between section actions and paging  -->
                        <BoxView Grid.Column="2"
                            HeightRequest="18"
                            Margin="4,0"
                            Opacity="0.75"
                            VerticalOptions="Center"
                            WidthRequest="1" />

                        <!--  Previous page in RowView  -->
                        <Border Grid.Column="3"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            InputTransparent="{Binding Source={x:Reference AlbumSimilarArtistsRowView}, Path=CanGoPrev, Converter={StaticResource InvertedBoolConverter}}"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Reference AlbumSimilarArtistsRowView}, Path=CanGoPrev}"
                                    TargetType="Border"
                                    Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference AlbumSimilarArtistsRowView}, Path=PrevPageCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ChevronLeft24,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>

                        <!--  Next page in RowView  -->
                        <Border Grid.Column="4"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            InputTransparent="{Binding Source={x:Reference AlbumSimilarArtistsRowView}, Path=CanGoNext, Converter={StaticResource InvertedBoolConverter}}"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Reference AlbumSimilarArtistsRowView}, Path=CanGoNext}"
                                    TargetType="Border"
                                    Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference AlbumSimilarArtistsRowView}, Path=NextPageCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ChevronRight24,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Grid>

                <!--  Similar Artists  -->
                <controls:RowView x:Name="AlbumSimilarArtistsRowView"
                    Grid.Row="1"
                    Margin="0,16,0,0"
                    ItemCornerRadius="100"
                    ItemsSource="{Binding SimilarArtistItems}"
                    UserDataService="{Binding UserDataService}"
                    PrimaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    SecondaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    ShowContextMenuAtAnchorCommand="{Binding ShowArtistContextMenuAtAnchorCommand}"
                    ShowContextMenuAtPositionCommand="{Binding ShowArtistContextMenuAtPositionCommand}" />

                <!--  Expand/collapse for similar artists card list  -->
                <Border Grid.Row="2"
                    Margin="0,8,0,0"
                    behaviors:HoverBehavior.EnableScaleHover="True"
                    behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                    BackgroundColor="Transparent"
                    HeightRequest="24"
                    HorizontalOptions="Center"
                    IsVisible="{Binding Source={x:Reference AlbumSimilarArtistsRowView}, Path=CanToggleExpand}"
                    StrokeThickness="0"
                    WidthRequest="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={x:Reference AlbumSimilarArtistsRowView}, Path=ToggleExpandCommand}" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Label FontSize="12"
                            HorizontalOptions="Center"
                            IsVisible="{Binding Source={x:Reference AlbumSimilarArtistsRowView}, Path=IsExpanded, Converter={StaticResource InvertedBoolConverter}}"
                            Text="{mi:Fluent Icon=ChevronDown24,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconPrimary}"
                            VerticalOptions="Center" />
                        <Label FontSize="12"
                            HorizontalOptions="Center"
                            IsVisible="{Binding Source={x:Reference AlbumSimilarArtistsRowView}, Path=IsExpanded}"
                            Text="{mi:Fluent Icon=ChevronUp24,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconPrimary}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </ScrollView>
</ContentPage>

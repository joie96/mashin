<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="mashin.Views.Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:mashin.Views.Desktop.Behaviors"
    xmlns:controls="clr-namespace:mashin.Views.Desktop.Controls"
    xmlns:desktopControls="clr-namespace:mashin.Views.Desktop.Controls;assembly=mashin"
    xmlns:converters="clr-namespace:mashin.Converters"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:models="clr-namespace:mashin.Models"
    xmlns:vm="clr-namespace:mashin.ViewModels"
    x:DataType="vm:MainViewModel"
    BackgroundColor="{DynamicResource BackgroundPrimary}">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        <converters:PlayStateToBoolConverter x:Key="PlayStateToBoolConverter" />
    </ContentPage.Resources>

    <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,*,90">

        <!--  Sidebar  -->
        <Grid Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            BackgroundColor="{DynamicResource BackgroundSecondary}">
            <ScrollView>
                <VerticalStackLayout Spacing="0">

                    <!--  Header  -->
                    <Grid Padding="20,30,20,20" HeightRequest="80">
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Label FontAttributes="Bold"
                                FontSize="18"
                                Text="Music Assistant"
                                TextColor="{DynamicResource TextPrimary}" />
                        </HorizontalStackLayout>
                    </Grid>

                    <!--  Navigation Items  -->
                    <VerticalStackLayout Padding="8,10" Spacing="2">

                        <!--  Home  -->
                        <Border Padding="12,10"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="44">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToHomeCommand}" />
                            </Border.GestureRecognizers>

                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                                <Label FontSize="18"
                                    Text="{mi:Fluent Icon=Home24,
                                                     FontOverride=True}"
                                    TextColor="{DynamicResource IconSecondary}" />
                                <Label FontSize="14"
                                    Text="Home"
                                    TextColor="{DynamicResource TextSecondary}" />
                            </HorizontalStackLayout>
                        </Border>

                        <!--  Entdecken  -->
                        <Border Padding="12,10"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="44">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToExploreCommand}" />
                            </Border.GestureRecognizers>

                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                                <Label FontSize="18"
                                    Text="{mi:Fluent Icon=CompassNorthwest24,
                                                     FontOverride=True}"
                                    TextColor="{DynamicResource IconSecondary}" />
                                <Label FontSize="14"
                                    Text="Entdecken"
                                    TextColor="{DynamicResource TextSecondary}" />
                            </HorizontalStackLayout>
                        </Border>

                        <!--  Favoriten  -->
                        <Border Padding="12,10"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="44">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToFavoritesCommand}" />
                            </Border.GestureRecognizers>

                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                                <Label FontSize="18"
                                    Text="{mi:Fluent Icon=Heart24,
                                                     FontOverride=True}"
                                    TextColor="{DynamicResource IconSecondary}" />
                                <Label FontSize="14"
                                    Text="Favoriten"
                                    TextColor="{DynamicResource TextSecondary}" />
                            </HorizontalStackLayout>
                        </Border>

                    </VerticalStackLayout>

                    <!--  Separator  -->
                    <BoxView Margin="12,15"
                        BackgroundColor="{DynamicResource SeparatorColor}"
                        HeightRequest="1" />

                    <!--  Playlists Header  -->
                    <Grid Padding="12,8" HeightRequest="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Label FontAttributes="Bold"
                            FontSize="13"
                            Text="Playlists"
                            TextColor="{DynamicResource TextSecondary}"
                            VerticalOptions="Center" />
                        <HorizontalStackLayout Grid.Column="1"
                            Spacing="6"
                            VerticalOptions="Center">
                            <Border behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                                BackgroundColor="Transparent"
                                HeightRequest="24"
                                StrokeThickness="0"
                                WidthRequest="24">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowCreatePlaylistOverlayCommand}" />
                                </Border.GestureRecognizers>
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label FontSize="12"
                                    HorizontalOptions="Center"
                                    Text="{mi:Fluent Icon=Add24,
                                                     FontOverride=True}"
                                    TextColor="{DynamicResource IconSecondary}"
                                    VerticalOptions="Center" />
                            </Border>

                            <Border behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                                BackgroundColor="Transparent"
                                HeightRequest="24"
                                StrokeThickness="0"
                                WidthRequest="24">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnNavigatePlaylistsTapped" />
                                </Border.GestureRecognizers>
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label FontSize="12"
                                    HorizontalOptions="Center"
                                    Text="{mi:Fluent Icon=TextBulletListLtr24,
                                                     FontOverride=True}"
                                    TextColor="{DynamicResource IconSecondary}"
                                    VerticalOptions="Center" />
                            </Border>

                            <ActivityIndicator HeightRequest="16"
                                IsRunning="{Binding IsLoadingPlaylists}"
                                IsVisible="{Binding IsLoadingPlaylists}"
                                WidthRequest="16"
                                Color="{DynamicResource IconSecondary}" />
                        </HorizontalStackLayout>
                    </Grid>

                    <!--  Playlists List  -->
                    <CollectionView Margin="0,0,0,10"
                        ItemsSource="{Binding Playlists}"
                        SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Playlist">
                                <Border Margin="4,2"
                                    Padding="8,4"
                                    behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                                    BackgroundColor="Transparent"
                                    HeightRequest="60">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.NavigateToPlaylistCommand}" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="40,*" ColumnSpacing="10">
                                        <Border Grid.Column="0"
                                            BackgroundColor="{DynamicResource BackgroundTertiary}"
                                            HeightRequest="40"
                                            StrokeThickness="0"
                                            WidthRequest="40">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="2" />
                                            </Border.StrokeShape>
                                            <Image Aspect="AspectFill" Source="{Binding ImageUrl}" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1"
                                            Spacing="4"
                                            VerticalOptions="Center">
                                            <Label FontSize="13"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1"
                                                Text="{Binding DisplayName}"
                                                TextColor="{DynamicResource TextPrimary}" />
                                            <Label FontSize="11"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1"
                                                Text="{Binding ProviderName}"
                                                TextColor="{DynamicResource TextTertiary}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>
            <BoxView HorizontalOptions="End"
                WidthRequest="1"
                Color="{DynamicResource BorderSecondary}" />
        </Grid>

        <!--  Top Bar  -->
        <Grid Grid.Row="0"
            Grid.Column="1"
            BackgroundColor="{DynamicResource BackgroundPrimary}"
            RowDefinitions="Auto,1">
            <Grid Grid.Row="0"
                Padding="24,16,24,20"
                ColumnDefinitions="*,Auto,Auto">
                <HorizontalStackLayout HorizontalOptions="Start" Spacing="12">

                    <!--  Back Button  -->
                    <Border behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                        BackgroundColor="Transparent"
                        HeightRequest="32"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="32">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Label FontSize="16"
                            HorizontalOptions="Center"
                            Text="{mi:Fluent Icon=ArrowLeft24,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconSecondary}"
                            VerticalOptions="Center" />
                    </Border>

                    <!--  Search Bar  -->
                    <Border Padding="12,0"
                        BackgroundColor="{DynamicResource BackgroundSecondary}"
                        HeightRequest="36"
                        HorizontalOptions="Start"
                        StrokeThickness="0"
                        WidthRequest="420">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label FontSize="16"
                                Text="{mi:Fluent Icon=Search24,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                            <Entry Grid.Column="1"
                                Margin="0,-2,-15,1"
                                BackgroundColor="Transparent"
                                FontSize="13"
                                HeightRequest="36"
                                Placeholder="Künstler:innen, Songs, Alben ..."
                                PlaceholderColor="{DynamicResource TextTertiary}"
                                ReturnCommand="{Binding SearchCommand}"
                                ReturnType="Search"
                                Text="{Binding SearchQuery}"
                                TextColor="{DynamicResource TextPrimary}"
                                VerticalOptions="Center"
                                VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>
                </HorizontalStackLayout>

                <!--  Theme Toggle Button  -->
                <Border Grid.Column="1"
                    Margin="12,0,0,0"
                    behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                    BackgroundColor="Transparent"
                    HeightRequest="32"
                    HorizontalOptions="End"
                    StrokeThickness="0"
                    ToolTipProperties.Text="Theme wechseln"
                    VerticalOptions="Center"
                    WidthRequest="32">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleThemeCommand}" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Grid>
                        <Label FontSize="16"
                            HorizontalOptions="Center"
                            IsVisible="{Binding IsDarkTheme}"
                            Text="{mi:FluentFilled Icon=WeatherSunny24Filled,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconSecondary}"
                            VerticalOptions="Center" />
                        <Label FontSize="16"
                            HorizontalOptions="Center"
                            IsVisible="{Binding IsDarkTheme, Converter={StaticResource InvertedBoolConverter}}"
                            Text="{mi:FluentFilled Icon=WeatherMoon24Filled,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconSecondary}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!--!-  User Profile Button  -->
                <Border x:Name="UserProfileButton"
                    Grid.Column="2"
                    Margin="12,0,0,0"
                    behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                    BackgroundColor="Transparent"
                    HeightRequest="32"
                    HorizontalOptions="End"
                    StrokeThickness="0"
                    VerticalOptions="Center"
                    WidthRequest="32">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowUserMenuCommand}"
                            CommandParameter="{x:Reference UserProfileButton}" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Label FontSize="16"
                        HorizontalOptions="Center"
                        Text="{mi:Fluent Icon=Person24,
                                         FontOverride=True}"
                        TextColor="{DynamicResource IconSecondary}"
                        VerticalOptions="Center" />
                </Border>
            </Grid>

            <BoxView Grid.Row="1"
                HeightRequest="1"
                Color="{DynamicResource BorderSecondary}" />
        </Grid>

        <!--  Content Area  -->
        <Grid Grid.Row="1" Grid.Column="1">
            <ContentView x:Name="ContentContainer" BackgroundColor="{DynamicResource BackgroundPrimary}" />

            <Grid BackgroundColor="Transparent" IsVisible="{Binding IsNavigating}">
                <BoxView BackgroundColor="#80000000" />
                <ActivityIndicator HeightRequest="48"
                    HorizontalOptions="Center"
                    IsRunning="{Binding IsNavigating}"
                    VerticalOptions="Center"
                    WidthRequest="48"
                    Color="{DynamicResource AccentColor}" />
            </Grid>
        </Grid>

        <!--  Player Bar  -->
        <Grid Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            BackgroundColor="{DynamicResource BackgroundSecondary}"
            RowDefinitions="1,*">
            <BoxView Grid.Row="0"
                HeightRequest="1"
                Color="{DynamicResource BorderSecondary}" />
            <Grid Grid.Row="1"
                Padding="20,0"
                ColumnDefinitions="300,*,300"
                HeightRequest="90">

                <!--  Left: Track Info  -->
                <Grid Grid.Column="0"
                    ColumnDefinitions="Auto,*,Auto,Auto"
                    ColumnSpacing="12"
                    IsClippedToBounds="True"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="0"
                    VerticalOptions="Center">
                    <Border Grid.RowSpan="2"
                        BackgroundColor="{DynamicResource BackgroundTertiary}"
                        HeightRequest="60"
                        StrokeShape="RoundRectangle 4"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="60">
                        <Image Aspect="AspectFill" Source="{Binding CurrentTrack.ImageUrl}" />
                    </Border>

                    <Grid Grid.Column="1"
                        IsClippedToBounds="True">
                        <desktopControls:MarqueeLabel FontSize="13"
                            LineBreakMode="TailTruncation"
                            MaxLines="1"
                            Text="{Binding CurrentTrack.Name}"
                            TextColor="{DynamicResource TextPrimary}"
                            VerticalOptions="End" />
                    </Grid>

                    <Grid Grid.Row="1"
                        Grid.Column="1"
                        IsClippedToBounds="True">
                        <desktopControls:MarqueeLabel Margin="0,4,0,0"
                            FontSize="12"
                            LineBreakMode="TailTruncation"
                            MaxLines="1"
                            Text="{Binding CurrentTrack.ArtistName}"
                            TextColor="{DynamicResource TextSecondary}"
                            VerticalOptions="Start">
                            <desktopControls:MarqueeLabel.Behaviors>
                                <behaviors:LinkLabelBehavior Command="{Binding ArtistTappedCommand}"
                                    CommandParameter="{Binding CurrentTrackPrimaryArtist}"
                                    HoverTextColor="{DynamicResource TextPrimary}" />
                            </desktopControls:MarqueeLabel.Behaviors>
                        </desktopControls:MarqueeLabel>
                    </Grid>

                    <Border Grid.Column="2"
                        Grid.RowSpan="2"
                        behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                        BackgroundColor="Transparent"
                        HeightRequest="32"
                        StrokeThickness="0"
                        ToolTipProperties.Text="Favorit"
                        VerticalOptions="Center"
                        WidthRequest="32">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleCurrentTrackFavoriteCommand}" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Grid>
                            <Label FontSize="18"
                                HorizontalOptions="Center"
                                IsVisible="{Binding CurrentTrack.Favorite, Converter={StaticResource InvertedBoolConverter}}"
                                Text="{mi:Fluent Icon=Heart24,
                                             FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                            <Label FontSize="18"
                                HorizontalOptions="Center"
                                IsVisible="{Binding CurrentTrack.Favorite}"
                                Text="{mi:FluentFilled Icon=Heart48Filled,
                                             FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border x:Name="CurrentTrackAddToPlaylistButton"
                        Grid.Column="3"
                        Grid.RowSpan="2"
                        behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                        BackgroundColor="Transparent"
                        HeightRequest="32"
                        StrokeThickness="0"
                        ToolTipProperties.Text="Zu Wiedergabeliste hinzufügen"
                        VerticalOptions="Center"
                        WidthRequest="32">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowCurrentTrackContextMenuCommand}"
                                CommandParameter="{x:Reference CurrentTrackAddToPlaylistButton}" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Label FontSize="18"
                            HorizontalOptions="Center"
                            Text="{mi:Fluent Icon=Add24,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconSecondary}"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!--  Center: Controls  -->
                <VerticalStackLayout Grid.Column="1"
                    Spacing="0"
                    VerticalOptions="Center">
                    <HorizontalStackLayout HeightRequest="36"
                        HorizontalOptions="Center"
                        Spacing="12">
                        <!--  Shuffle  -->
                        <Border behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="32"
                            StrokeThickness="0"
                            ToolTipProperties.Text="Zufallswiedergabe"
                            VerticalOptions="Center"
                            WidthRequest="32">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleShuffleCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Label FontSize="16"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ArrowShuffle24,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger Binding="{Binding IsShuffleActive}"
                                        TargetType="Label"
                                        Value="True">
                                        <Setter Property="TextColor" Value="{DynamicResource AccentColor}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>

                        <!--  Previous  -->
                        <Border behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="32"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            WidthRequest="32">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PreviousTrackCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Label FontSize="18"
                                HorizontalOptions="Center"
                                Text="{mi:FluentFilled Icon=Previous48Filled,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconPrimary}"
                                VerticalOptions="Center" />
                        </Border>

                        <!--  Play/Pause  -->
                        <Border behaviors:HoverBehavior.EnableScaleHover="True"
                            BackgroundColor="{DynamicResource IconPrimary}"
                            HeightRequest="36"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            WidthRequest="36">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding TogglePlayPauseCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Grid>
                                <Label FontSize="18"
                                    HorizontalOptions="Center"
                                    IsVisible="{Binding PlayState, Converter={StaticResource PlayStateToBoolConverter}, ConverterParameter=show-play-icon}"
                                    Text="{mi:FluentFilled Icon=Play48Filled,
                                                     FontOverride=True}"
                                    TextColor="{DynamicResource BackgroundPrimary}"
                                    VerticalOptions="Center" />
                                <Label FontSize="18"
                                    HorizontalOptions="Center"
                                    IsVisible="{Binding PlayState, Converter={StaticResource PlayStateToBoolConverter}, ConverterParameter=show-pause-icon}"
                                    Text="{mi:FluentFilled Icon=Pause48Filled,
                                                     FontOverride=True}"
                                    TextColor="{DynamicResource BackgroundPrimary}"
                                    VerticalOptions="Center" />
                                <ActivityIndicator HeightRequest="16"
                                    IsRunning="{Binding PlayState, Converter={StaticResource PlayStateToBoolConverter}, ConverterParameter=buffering}"
                                    IsVisible="{Binding PlayState, Converter={StaticResource PlayStateToBoolConverter}, ConverterParameter=buffering}"
                                    Scale="1.5"
                                    WidthRequest="16"
                                    Color="{DynamicResource BackgroundPrimary}" />
                            </Grid>
                        </Border>

                        <!--  Next  -->
                        <Border behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="32"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            WidthRequest="32">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NextTrackCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Label FontSize="18"
                                HorizontalOptions="Center"
                                Text="{mi:FluentFilled Icon=Next48Filled,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconPrimary}"
                                VerticalOptions="Center" />
                        </Border>

                        <!--  Repeat  -->
                        <Border behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="32"
                            StrokeThickness="0"
                            ToolTipProperties.Text="Wiederholungsmodus"
                            VerticalOptions="Center"
                            WidthRequest="32">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleRepeatModeCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Grid>
                                <Label FontSize="16"
                                    HorizontalOptions="Center"
                                    Text="{mi:Fluent Icon=ArrowRepeatAll24,
                                                     FontOverride=True}"
                                    TextColor="{DynamicResource IconSecondary}"
                                    VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger Binding="{Binding IsRepeatEnabled}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource AccentColor}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label FontAttributes="Bold"
                                    FontSize="9"
                                    HorizontalOptions="End"
                                    IsVisible="{Binding IsRepeatOne}"
                                    Margin="0,0,3,4"
                                    Text="1"
                                    TextColor="{DynamicResource AccentColor}"
                                    VerticalOptions="End" />
                            </Grid>
                        </Border>
                    </HorizontalStackLayout>

                    <!--  Position Slider  -->
                    <Grid ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="10"
                        HorizontalOptions="Center"
                        MaximumWidthRequest="600">
                        <Label FontSize="11"
                            Text="{Binding PositionText}"
                            TextColor="{DynamicResource TextTertiary}"
                            VerticalOptions="Center" />
                        <Slider Grid.Column="1"
                            Maximum="{Binding Duration}"
                            MaximumTrackColor="{DynamicResource BackgroundTertiary}"
                            Minimum="0"
                            MinimumTrackColor="{DynamicResource IconSecondary}"
                            MinimumWidthRequest="300"
                            ThumbColor="{DynamicResource IconPrimary}"
                            VerticalOptions="Center"
                            Value="{Binding SliderPosition, Mode=TwoWay}">
                            <Slider.Behaviors>
                                <behaviors:SliderDragCompletedBehavior StartedCommand="{Binding BeginSeekCommand}" Command="{Binding SeekCommand}" />
                            </Slider.Behaviors>
                        </Slider>
                        <Label Grid.Column="2"
                            FontSize="11"
                            Text="{Binding DurationText}"
                            TextColor="{DynamicResource TextTertiary}"
                            VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>

                <!--  Right: Queue  -->
                <Grid Grid.Column="2"
                    ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                    ColumnSpacing="12"
                    HorizontalOptions="End"
                    IsClippedToBounds="True"
                    VerticalOptions="Center">
                    <Border Grid.Column="0"
                        behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                        BackgroundColor="Transparent"
                        HeightRequest="32"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        ToolTipProperties.Text="Warteschlange"
                        WidthRequest="32">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnQueueTapped" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Label FontSize="16"
                            x:Name="QueueIconLabel"
                            HorizontalOptions="Center"
                            Text="{mi:Fluent Icon=RowTriple24,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconSecondary}"
                            VerticalOptions="Center" />
                    </Border>

                    <!--  Don't Stop The Music  -->
                    <Border Grid.Column="1"
                        behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                        BackgroundColor="Transparent"
                        HeightRequest="32"
                        StrokeThickness="0"
                        ToolTipProperties.Text="Don't stop the music"
                        VerticalOptions="Center"
                        WidthRequest="32">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleDontStopTheMusicCommand}" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Label FontSize="16"
                            HorizontalOptions="Center"
                            Text="{mi:Fluent Icon=MusicNote216,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconSecondary}"
                            VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger Binding="{Binding IsDontStopTheMusicEnabled}"
                                    TargetType="Label"
                                    Value="True">
                                    <Setter Property="TextColor" Value="{DynamicResource AccentColor}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                    
                    <!--  Device Selection  -->
                    <Border Grid.Column="2"
                        behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                        BackgroundColor="Transparent"
                        HeightRequest="32"
                        StrokeThickness="0"
                        ToolTipProperties.Text="Gerätewahl"
                        VerticalOptions="Center"
                        WidthRequest="32">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Label FontSize="16"
                            HorizontalOptions="Center"
                            Text="{mi:Fluent Icon=PhoneDesktop24,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconSecondary}"
                            VerticalOptions="Center" />
                    </Border>

                    <!--  Volume  -->
                    <Border Grid.Column="3"
                        behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                        BackgroundColor="Transparent"
                        HeightRequest="32"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="32">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleMuteCommand}" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Grid>
                            <Label FontSize="16"
                                HorizontalOptions="Center"
                                IsVisible="{Binding IsMuted}"
                                Text="{mi:Fluent Icon=SpeakerMute24,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource AccentColor}"
                                VerticalOptions="Center" />
                            <Label FontSize="16"
                                HorizontalOptions="Center"
                                IsVisible="{Binding IsMuted, Converter={StaticResource InvertedBoolConverter}}"
                                Text="{mi:Fluent Icon=Speaker224,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Slider Grid.Column="4"
                        Maximum="100"
                        MaximumTrackColor="{DynamicResource BackgroundTertiary}"
                        Minimum="0"
                        MinimumTrackColor="{DynamicResource IconSecondary}"
                        ThumbColor="{DynamicResource IconPrimary}"
                        VerticalOptions="Center"
                        WidthRequest="90"
                        Value="{Binding Volume, Mode=TwoWay}" />

                    <!--  Options  -->
                    <Border Grid.Column="5"
                        behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                        BackgroundColor="Transparent"
                        HeightRequest="32"
                        StrokeThickness="0"
                        ToolTipProperties.Text="Optionen"
                        VerticalOptions="Center"
                        WidthRequest="32">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleAudioOptionsFlyoutCommand}" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Label FontSize="16"
                            HorizontalOptions="Center"
                            Text="{mi:Fluent Icon=Options24,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconSecondary}"
                            VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger Binding="{Binding IsAudioOptionsFlyoutOpen}"
                                    TargetType="Label"
                                    Value="True">
                                    <Setter Property="TextColor" Value="{DynamicResource AccentColor}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!--  Audio Options Flyout  -->
        <Grid Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            IsVisible="{Binding IsAudioOptionsFlyoutOpen}">
            <BoxView BackgroundColor="Transparent">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseAudioOptionsFlyoutCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border Margin="0,0,10,70"
                Padding="12"
                BackgroundColor="{DynamicResource BackgroundSecondary}"
                HorizontalOptions="End"
                VerticalOptions="End"
                WidthRequest="200"
                Stroke="{DynamicResource SeparatorColor}"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{DynamicResource ShadowColorStrong}"
                        Opacity="{DynamicResource ShadowOpacityStrong}"
                        Radius="20"
                        Offset="0,8" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="10">

                    <Label 
                        FontSize="14"
                        Text="Klangqualität"
                        Margin="0,0,0,8"
                        TextColor="{DynamicResource TextPrimary}" />

                    <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="10"
                        RowDefinitions="Auto,Auto">
                        <VerticalStackLayout Grid.Row="0"
                            Grid.Column="0"
                            Spacing="0">
                            <Label FontSize="14"
                                Text="Standard"
                                TextColor="{DynamicResource TextPrimary}" />
                            <Label FontSize="12"
                                Text="Opus 256 kb/s"
                                TextColor="{DynamicResource TextSecondary}" />
                        </VerticalStackLayout>

                        <RadioButton Grid.RowSpan="2"
                            Grid.Column="1"
                            GroupName="AudioQuality"
                            HorizontalOptions="End"
                            IsChecked="{Binding IsAudioQualityOpus, Mode=TwoWay}"
                            VerticalOptions="Center" 
                            MinimumWidthRequest="0"/>
                    </Grid>


                    <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="10"
                        RowDefinitions="Auto,Auto">
                        <Label Grid.Row="0"
                            Grid.Column="0"
                            FontSize="14"
                            Text="High Fidelity"
                            TextColor="{DynamicResource TextPrimary}" />
                        <Label Grid.Row="1"
                            Grid.Column="0"
                            FontSize="12"
                            Text="FLAC"
                            TextColor="{DynamicResource TextSecondary}" />
                        <RadioButton Grid.RowSpan="2"
                            Grid.Column="1"
                            GroupName="AudioQuality"
                            HorizontalOptions="End"
                            IsChecked="{Binding IsAudioQualityFlac, Mode=TwoWay}"
                            VerticalOptions="Center"
                            MinimumWidthRequest="0"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="10"
                        RowDefinitions="Auto,Auto">
                        <Label Grid.Row="0"
                            Grid.Column="0"
                            FontSize="14"
                            Text="Studio"
                            TextColor="{DynamicResource TextPrimary}" />
                        <Label Grid.Row="1"
                            Grid.Column="0"
                            FontSize="12"
                            Text="PCM"
                            TextColor="{DynamicResource TextSecondary}" />
                        <RadioButton Grid.RowSpan="2"
                            Grid.Column="1"
                            GroupName="AudioQuality"
                            HorizontalOptions="End"
                            IsChecked="{Binding IsAudioQualityPcm, Mode=TwoWay}"
                            VerticalOptions="Center"
                            MinimumWidthRequest="0"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!--  Queue Overlay Host  -->
        <controls:QueueOverlay x:Name="QueueOverlay"
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Grid.ColumnSpan="2" />

        <!--! Overlay Host  -->
        <Grid x:Name="OverlayHost"
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            BackgroundColor="Transparent"
            InputTransparent="False"
            IsVisible="False">
            <Grid>
                <BoxView BackgroundColor="#80000000">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOverlayBackdropTapped" />
                    </BoxView.GestureRecognizers>
                </BoxView>
                <ContentPresenter x:Name="OverlayContent"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Grid>
        </Grid>

    </Grid>
</ContentPage>

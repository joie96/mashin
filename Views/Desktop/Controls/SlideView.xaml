<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="mashin.Views.Desktop.Controls.SlideView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:mashin.Views.Desktop.Behaviors"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    x:Name="self">

    <Grid>
        <Border x:Name="SlideCardBorder"
            Padding="20"
            HeightRequest="200"
            StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>

            <Grid x:Name="SlideContentHost"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="20">

                <Border Grid.Column="0"
                    HeightRequest="{Binding Source={x:Reference self}, Path=CoverSize}"
                    HorizontalOptions="Start"
                    StrokeThickness="0"
                    VerticalOptions="Center"
                    WidthRequest="{Binding Source={x:Reference self}, Path=CoverSize}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{Binding Source={x:Reference self}, Path=ItemCornerRadius}" />
                    </Border.StrokeShape>

                    <Grid behaviors:HoverBehavior.ShowOnHoverTarget="{x:Reference CoverHoverOverlay}">
                        <Grid.GestureRecognizers>
                            <PointerGestureRecognizer Buttons="Secondary" PointerPressed="OnCoverSecondaryPointerPressed" />
                        </Grid.GestureRecognizers>

                        <Image Aspect="AspectFill"
                            Source="{Binding ImageUrl}" />

                        <Border x:Name="CoverHoverOverlay"
                            BackgroundColor="#80000000"
                            Opacity="0"
                            StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="{Binding Source={x:Reference self}, Path=ItemCornerRadius}" />
                            </Border.StrokeShape>

                            <Grid RowDefinitions="Auto,*,Auto">
                                <Border Grid.RowSpan="3"
                                    behaviors:HoverBehavior.BaseBackgroundColor="{DynamicResource IconPrimary75}"
                                    behaviors:HoverBehavior.EnableScaleHover="True"
                                    behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource IconPrimary}"
                                    BackgroundColor="{DynamicResource IconPrimary75}"
                                    HeightRequest="56"
                                    HorizontalOptions="Center"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    WidthRequest="56">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPlayOverlayClicked" />
                                    </Border.GestureRecognizers>
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="28" />
                                    </Border.StrokeShape>
                                    <Label FontSize="28"
                                        HorizontalOptions="Center"
                                        Text="{mi:FluentFilled Icon=Play48Filled,
                                                         FontOverride=True}"
                                        TextColor="{DynamicResource BackgroundPrimary}"
                                        VerticalOptions="Center" />
                                </Border>

                                <Grid Grid.Row="2"
                                    Margin="8"
                                    ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                        Margin="0,0,12,0"
                                        behaviors:HoverBehavior.BaseTextColor="{DynamicResource IconSecondary}"
                                        behaviors:HoverBehavior.EnableScaleHover="True"
                                        behaviors:HoverBehavior.HoverTextColor="{DynamicResource IconPrimary}"
                                        FontSize="18"
                                        HorizontalOptions="End"
                                        IsVisible="{Binding Favorite, Converter={StaticResource InvertedBoolConverter}}"
                                        Text="{mi:Fluent Icon=Heart48,
                                                         FontOverride=True}"
                                        TextColor="{DynamicResource IconSecondary}"
                                        VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnFavoriteIconTapped" />
                                        </Label.GestureRecognizers>
                                    </Label>

                                    <Label Grid.Column="0"
                                        Margin="0,0,12,0"
                                        behaviors:HoverBehavior.BaseTextColor="{DynamicResource IconSecondary}"
                                        behaviors:HoverBehavior.EnableScaleHover="True"
                                        behaviors:HoverBehavior.HoverTextColor="{DynamicResource IconPrimary}"
                                        FontSize="18"
                                        HorizontalOptions="End"
                                        IsVisible="{Binding Favorite}"
                                        Text="{mi:FluentFilled Icon=Heart48Filled,
                                                                       FontOverride=True}"
                                        TextColor="{DynamicResource IconSecondary}"
                                        VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnFavoriteIconTapped" />
                                        </Label.GestureRecognizers>
                                    </Label>

                                    <Label x:Name="MoreIconLabel"
                                        Grid.Column="1"
                                        behaviors:HoverBehavior.BaseTextColor="{DynamicResource IconSecondary}"
                                        behaviors:HoverBehavior.EnableScaleHover="True"
                                        behaviors:HoverBehavior.HoverTextColor="{DynamicResource IconPrimary}"
                                        FontSize="18"
                                        HorizontalOptions="End"
                                        Text="{mi:Fluent Icon=MoreHorizontal48,
                                                                 FontOverride=True}"
                                        TextColor="{DynamicResource IconSecondary}"
                                        VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnMoreIconTapped" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1"
                    RowDefinitions="Auto,Auto,Auto"
                    RowSpacing="6"
                    VerticalOptions="Center">
                    <Label Grid.Row="0"
                        FontAttributes="Bold"
                        FontSize="56"
                        LineBreakMode="TailTruncation"
                        MaxLines="2"
                        Text="{Binding DisplayName}"
                        TextColor="{DynamicResource TextSecondary}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPrimaryInfoTapped" />
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Grid.Row="1"
                        FontAttributes="Bold"
                        FontSize="24"
                        LineBreakMode="TailTruncation"
                        MaxLines="1"
                        Text="{Binding ArtistName}"
                        TextColor="{DynamicResource TextSecondary}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPrimaryInfoTapped" />
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Grid.Row="2"
                        FontAttributes="Bold"
                        FontSize="20"
                        Text="{Binding Album.Year}"
                        TextColor="{DynamicResource TextTertiary}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentView>

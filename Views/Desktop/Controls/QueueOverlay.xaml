<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="mashin.Views.Desktop.Controls.QueueOverlay"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:mashin.Views.Desktop.Behaviors"
    xmlns:controls="clr-namespace:mashin.Views.Desktop.Controls"
    xmlns:converters="clr-namespace:mashin.Converters"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:vm="clr-namespace:mashin.ViewModels"
    x:Name="Root"
    x:DataType="vm:MainViewModel"
    BackgroundColor="Transparent"
    InputTransparent="False"
    IsClippedToBounds="True"
    IsVisible="False">

    <ContentView.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentView.Resources>

    <Grid IsClippedToBounds="True">
        <!--  Overlay Backdrop  -->
        <BoxView x:Name="OverlayBackdrop"
            BackgroundColor="#80000000"
            Opacity="0" />

        <!--  Queue Overlay Panel  -->
        <Border x:Name="OverlayPanel"
            BackgroundColor="{DynamicResource BackgroundSecondary}"
            HeightRequest="{Binding Source={x:Reference Root}, Path=Height}"
            StrokeThickness="0"
            VerticalOptions="Fill"
            TranslationY="2000">
            <Grid Padding="48,52,48,10"
                ColumnDefinitions="300,*"
                ColumnSpacing="40">
                
                <!--  Current Track Column  -->
                <VerticalStackLayout Margin="0,50,0,0"
                    Spacing="16"
                    VerticalOptions="Start">
                    <!--  Cover Art  -->
                    <Border BackgroundColor="{DynamicResource BackgroundTertiary}"
                        HeightRequest="300"
                        StrokeThickness="0"
                        WidthRequest="300">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6" />
                        </Border.StrokeShape>
                        <Grid>
                            <ffimageloading:CachedImage Aspect="AspectFill"
                                IsVisible="{Binding CurrentQueueItem.MediaItem.ImageUri, Converter={StaticResource StringNullOrWhiteSpaceToBoolConverter}, ConverterParameter=invert}"
                                Source="{Binding CurrentQueueItem.MediaItem.ImageUri}" />
                            <Image Aspect="AspectFill"
                                IsVisible="{Binding CurrentQueueItem.MediaItem.ImageUri, Converter={StaticResource StringNullOrWhiteSpaceToBoolConverter}}"
                                Source="{AppThemeBinding Light=placeholders/track_light.png, Dark=placeholders/track_dark.png}" />
                        </Grid>
                    </Border>

                    <!--  Track Actions  -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="22">
                        <Border
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="36"
                            StrokeThickness="0"
                            ToolTipProperties.Text="Favorit"
                            WidthRequest="36">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleCurrentTrackFavoriteCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Grid>
                                <Label FontSize="24"
                                    HorizontalOptions="Center"
                                    IsVisible="{Binding CurrentQueueItem.MediaItem.Favorite, Converter={StaticResource InvertedBoolConverter}}"
                                    Text="{mi:Fluent Icon=Heart24,
                                                 FontOverride=True}"
                                    TextColor="{DynamicResource IconSecondary}"
                                    VerticalOptions="Center" />
                                <Label FontSize="24"
                                    HorizontalOptions="Center"
                                    IsVisible="{Binding CurrentQueueItem.MediaItem.Favorite}"
                                    Text="{mi:FluentFilled Icon=Heart48Filled,
                                                       FontOverride=True}"
                                    TextColor="{DynamicResource IconSecondary}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        
                        <Border x:Name="QueueOverlayAddToPlaylistButton"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="36"
                            StrokeThickness="0"
                            ToolTipProperties.Text="Zu Wiedergabeliste hinzufügen"
                            WidthRequest="36">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowCurrentTrackContextMenuCommand}"
                                    CommandParameter="{x:Reference QueueOverlayAddToPlaylistButton}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Label FontSize="24"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=Add24,
                                             FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>                       
                    </HorizontalStackLayout>

                    <!--  Track Meta  -->
                    <VerticalStackLayout Spacing="4">
                        <Label FontAttributes="Bold"
                            FontSize="16"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="TailTruncation"
                            MaxLines="1"
                            Text="{Binding CurrentQueueItem.MediaItem.Name}"
                            TextColor="{DynamicResource TextPrimary}" />
                        <Label FontSize="14"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="TailTruncation"
                            MaxLines="1"
                            Text="{Binding CurrentQueueItem.MediaItem.ArtistName}"
                            TextColor="{DynamicResource TextSecondary}">
                            <Label.Behaviors>
                                <behaviors:LinkLabelBehavior Command="{Binding ArtistTappedCommand}"
                                    CommandParameter="{Binding CurrentQueueItemPrimaryArtist}"
                                    HoverTextColor="{DynamicResource TextPrimary}" />
                            </Label.Behaviors>
                        </Label>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!--  Queue Content Column  -->
                <Grid Grid.Column="1"
                    HorizontalOptions="Fill"
                    RowDefinitions="Auto,*"
                    RowSpacing="16">
                    <!--  Queue Header  -->
                    <Grid Padding="0,0,0,0"
                        HorizontalOptions="Fill">
                        <!--  Queue Summary  -->
                        <HorizontalStackLayout
                            HorizontalOptions="Start"
                            Spacing="8"
                            VerticalOptions="Center">
                            <Label FontAttributes="Bold"
                                FontSize="14"
                                Text="Warteschlange"
                                TextColor="{DynamicResource TextSecondary}"
                                VerticalOptions="Center" />
                            <Label FontSize="14"
                                Text="•"
                                TextColor="{DynamicResource TextTertiary}"
                                VerticalOptions="Center" />
                            <Label FontSize="14"
                                Text="{Binding QueueTrackCountText}"
                                TextColor="{DynamicResource TextTertiary}"
                                VerticalOptions="Center" />
                            <Label FontSize="14"
                                Text="•"
                                TextColor="{DynamicResource TextTertiary}"
                                VerticalOptions="Center" />
                            <Label FontSize="14"
                                Text="{Binding QueueTotalDurationText}"
                                TextColor="{DynamicResource TextTertiary}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!--  Auto Recommendations Toggle  -->
                        <Grid
                            ColumnDefinitions="Auto,Auto"
                            ColumnSpacing="6"
                            HorizontalOptions="End"
                            VerticalOptions="Center">
                            <Label Grid.Column="0"
                                FontSize="14"
                                Text="Automatische Empfehlungen:"
                                TextColor="{DynamicResource TextSecondary}"
                                VerticalOptions="Center" />

                            <Switch Grid.Column="1"
                                IsToggled="{Binding IsDontStopTheMusicEnabled, Mode=TwoWay}"
                                OnColor="{DynamicResource AccentColor}"
                                Scale="0.8"
                                MinimumWidthRequest="0"
                                VerticalOptions="Center" />
                        </Grid>
                    </Grid>

                    <!--  Queue Table  -->
                    <controls:TableView Grid.Row="1"
                        Margin="0,0,0,0"
                        PageSize="0"
                        ItemsSource="{Binding CurrentQueueItems}"
                        MediaActions="{Binding MediaActions}"
                        PlaybackContextItem="{Binding CurrentQueueItems}"
                        PrimaryInfoTappedCommand="{Binding AlbumTappedCommand}"
                        SecondaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                        ShowContextMenuAtAnchorCommand="{Binding ShowQueueContextMenuAtAnchorCommand}"
                        ShowContextMenuAtPositionCommand="{Binding ShowQueueContextMenuAtPositionCommand}"
                        VerticalOptions="Fill" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentView>

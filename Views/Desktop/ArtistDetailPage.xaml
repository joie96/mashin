<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="mashin.Views.Desktop.ArtistDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:mashin.Views.Desktop.Behaviors"
    xmlns:controls="clr-namespace:mashin.Views.Desktop.Controls"
    xmlns:converters="clr-namespace:mashin.Converters"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:vm="clr-namespace:mashin.ViewModels"
    x:DataType="vm:ArtistDetailViewModel"
    BackgroundColor="{DynamicResource BackgroundPrimary}">

    <ContentPage.Resources>
        <converters:IntToBoolConverter x:Key="IntToBoolConverter" />
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        <converters:RemoveBlankLinesConverter x:Key="RemoveBlankLinesConverter" />
    </ContentPage.Resources>

    <ScrollView>
            <Grid Padding="{StaticResource DesktopPagePadding}"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
            RowSpacing="0">

            <!--  Artist Header  -->
            <Grid Grid.Row="0"
                ColumnDefinitions="200,*"
                ColumnSpacing="30">

                <!--  Artist Image - Loading State  -->
                <Border Grid.Column="0"
                    HeightRequest="200"
                    IsVisible="{Binding IsLoadingMetadata}"
                    StrokeThickness="0"
                    WidthRequest="200">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="100" />
                    </Border.StrokeShape>
                    <controls:SkeletonLoader CornerRadius="100" HeightRequest="200" WidthRequest="200" />
                </Border>

                <!--  Artist Image - Actual  -->
                <Border Grid.Column="0"
                    BackgroundColor="Transparent"
                    HeightRequest="200"
                    IsVisible="{Binding IsLoadingMetadata, Converter={StaticResource InvertedBoolConverter}}"
                    StrokeThickness="0"
                    WidthRequest="200">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="100" />
                    </Border.StrokeShape>

                    <Grid>
                        <ffimageloading:CachedImage Aspect="AspectFill"
                            HeightRequest="200"
                            HorizontalOptions="Center"
                            IsVisible="{Binding ImageUri, Converter={StaticResource StringNullOrWhiteSpaceToBoolConverter}, ConverterParameter=invert}"
                            Source="{Binding ImageUri}"
                            VerticalOptions="Center"
                            WidthRequest="200">
                            <ffimageloading:CachedImage.Clip>
                                <RoundRectangleGeometry CornerRadius="100" Rect="0,0,200,200" />
                            </ffimageloading:CachedImage.Clip>
                        </ffimageloading:CachedImage>
                        <Image Aspect="AspectFill"
                            HeightRequest="200"
                            HorizontalOptions="Center"
                            IsVisible="{Binding ImageUri, Converter={StaticResource StringNullOrWhiteSpaceToBoolConverter}}"
                            Source="{AppThemeBinding Light=placeholders/artist_light.png, Dark=placeholders/artist_dark.png}"
                            VerticalOptions="Center"
                            WidthRequest="200">
                            <Image.Clip>
                                <RoundRectangleGeometry CornerRadius="100" Rect="0,0,200,200" />
                            </Image.Clip>
                        </Image>
                    </Grid>
                </Border>

                <!--  Artist Info - Loading State  -->
                <Grid Grid.Column="1"
                    HeightRequest="200"
                    IsVisible="{Binding IsLoadingMetadata}"
                    RowDefinitions="*,Auto,Auto,Auto,40"
                    VerticalOptions="Fill">
                    <controls:SkeletonLoader Grid.Row="1"
                        HeightRequest="12"
                        HorizontalOptions="Start"
                        Margin="0,0,0,16"
                        WidthRequest="120" />
                    <controls:SkeletonLoader Grid.Row="2"
                        HeightRequest="32"
                        HorizontalOptions="Start"
                        Margin="0,0,0,8"
                        WidthRequest="320" />
                    <controls:SkeletonLoader Grid.Row="3"
                        HeightRequest="14"
                        HorizontalOptions="Start"
                        Margin="0,0,0,16"
                        WidthRequest="150" />
                </Grid>

                <!--  Artist Info - Actual  -->
                <Grid Grid.Column="1"
                    HeightRequest="200"
                    IsVisible="{Binding IsLoadingMetadata, Converter={StaticResource InvertedBoolConverter}}"
                    RowDefinitions="*,Auto,Auto,Auto,Auto"
                    VerticalOptions="Fill">

                    <Label Grid.Row="1"
                        Margin="0,0,0,16"
                        Style="{StaticResource LabelSecondary}"
                        FontAttributes="Bold"
                        FontSize="12"
                        Text="ARTIST/INTERPRET" />

                    <!--  Artist Name + Provider Icon  -->
                    <HorizontalStackLayout Grid.Row="2"
                        Margin="0,0,0,8"
                        Spacing="16"
                        VerticalOptions="Center">
                        <Label FontAttributes="Bold"
                            FontSize="32"
                            LineBreakMode="WordWrap"
                            MaxLines="2"
                            Text="{Binding ArtistName}"
                            TextColor="{DynamicResource TextPrimary}" />
                        <ffimageloading:SvgCachedImage HeightRequest="28"
                            Source="{Binding Artist.ProviderManifest.IconSvg}"
                            ToolTipProperties.Text="{Binding Artist.ProviderName}"
                            VerticalOptions="Center"
                            WidthRequest="28">
                            <ffimageloading:SvgCachedImage.Triggers>
                                <DataTrigger Binding="{Binding Artist.ProviderManifest.IconSvg}"
                                    TargetType="ffimageloading:SvgCachedImage"
                                    Value="{x:Null}">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </ffimageloading:SvgCachedImage.Triggers>
                        </ffimageloading:SvgCachedImage>
                    </HorizontalStackLayout>

                    <Label Grid.Row="3"
                        Margin="0,0,0,16"
                        Style="{StaticResource LabelSecondary}"
                        Text="{Binding Albums.Count, StringFormat='{0} Alben'}" />

                    <Grid Grid.Row="4"
                        ColumnDefinitions="Auto,Auto,Auto,Auto"
                        ColumnSpacing="12">
                        <Border Grid.Column="0"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource ActionButtonsHoverBackground}"
                            Style="{StaticResource ActionButtonBorder}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PlayArtistCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout HorizontalOptions="Center"
                                Spacing="8"
                                VerticalOptions="Center">
                                <Label Style="{StaticResource ActionButtonIconLabel}"
                                    Text="{mi:FluentFilled Icon=Play16Filled,
                                                     FontOverride=True}" />
                                <Label Style="{StaticResource ActionButtonTextLabel}"
                                    Text="Abspielen" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border Grid.Column="1"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource ActionButtonsHoverBackground}"
                            Style="{StaticResource ActionButtonBorder}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShuffleArtistCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout HorizontalOptions="Center"
                                Spacing="8"
                                VerticalOptions="Center">
                                <Label Style="{StaticResource ActionButtonIconLabel}"
                                    Text="{mi:FluentFilled Icon=ArrowShuffle16Filled,
                                                     FontOverride=True}" />
                                <Label Style="{StaticResource ActionButtonTextLabel}"
                                    Text="Zufällig" />
                            </HorizontalStackLayout>
                        </Border>

                        <Label Grid.Column="2"
                            Margin="12,0,0,0"
                            behaviors:HoverBehavior.BaseTextColor="{DynamicResource IconSecondary}"
                            behaviors:HoverBehavior.EnableScaleHover="True"
                            behaviors:HoverBehavior.HoverTextColor="{DynamicResource IconPrimary}"
                            FontSize="18"
                            HorizontalOptions="Center"
                            IsVisible="{Binding IsArtistFavorite, Converter={StaticResource InvertedBoolConverter}}"
                            Text="{mi:Fluent Icon=Heart48,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconSecondary}"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleArtistFavoriteCommand}" />
                            </Label.GestureRecognizers>
                        </Label>

                        <Label Grid.Column="2"
                            Margin="12,0,0,0"
                            behaviors:HoverBehavior.BaseTextColor="{DynamicResource IconSecondary}"
                            behaviors:HoverBehavior.EnableScaleHover="True"
                            behaviors:HoverBehavior.HoverTextColor="{DynamicResource IconPrimary}"
                            FontSize="18"
                            HorizontalOptions="Center"
                            IsVisible="{Binding IsArtistFavorite}"
                            Text="{mi:FluentFilled Icon=Heart48Filled,
                                           FontOverride=True}"
                            TextColor="{DynamicResource IconSecondary}"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleArtistFavoriteCommand}" />
                            </Label.GestureRecognizers>
                        </Label>

                        <Label x:Name="ArtistHeaderMoreIconLabel"
                            Grid.Column="3"
                            Margin="6,0,0,0"
                            behaviors:HoverBehavior.BaseTextColor="{DynamicResource IconSecondary}"
                            behaviors:HoverBehavior.EnableScaleHover="True"
                            behaviors:HoverBehavior.HoverTextColor="{DynamicResource IconPrimary}"
                            FontSize="18"
                            HorizontalOptions="Center"
                            Text="{mi:Fluent Icon=MoreHorizontal48,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconSecondary}"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowHeaderContextMenuAtAnchorCommand}"
                                                      CommandParameter="{x:Reference ArtistHeaderMoreIconLabel}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                </Grid>
            </Grid>

            <!--  Description - Loading State  -->
            <Grid Grid.Row="1"
                Margin="{StaticResource DesktopSectionTopMargin}"
                IsVisible="{Binding IsLoadingMetadata}"
                RowDefinitions="Auto,Auto,Auto,Auto"
                RowSpacing="0">
                <controls:SkeletonLoader Grid.Row="0" HeightRequest="18" HorizontalOptions="Start" WidthRequest="200" />
                <controls:SkeletonLoader Grid.Row="1" Margin="0,16,0,0" HeightRequest="14" HorizontalOptions="Fill" />
                <controls:SkeletonLoader Grid.Row="2" Margin="0,16,0,0" HeightRequest="14" HorizontalOptions="Fill" />
                <controls:SkeletonLoader Grid.Row="3" Margin="0,16,0,0" HeightRequest="14" HorizontalOptions="Fill" />
            </Grid>

            <!--  Description - Actual  -->
            <Grid Grid.Row="2"
                Margin="{StaticResource DesktopSectionTopMargin}"
                IsVisible="{Binding HasDescription}"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="0">
                <Grid.Triggers>
                    <DataTrigger Binding="{Binding IsLoadingMetadata}"
                        TargetType="Grid"
                        Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Grid.Triggers>
                <Label Grid.Row="0"
                    Style="{StaticResource LabelSectionTitle}"
                    Text="{Binding ArtistName, StringFormat='Über {0}'}" />
                <Label Grid.Row="1"
                    Style="{StaticResource LabelSecondary}"
                    Margin="0,16,0,0"
                    LineBreakMode="WordWrap"
                    MaxLines="{Binding DescriptionMaxLines}"
                    Text="{Binding Artist.Metadata.Description, Converter={StaticResource RemoveBlankLinesConverter}}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleDescriptionCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Border Grid.Row="2"
                    Margin="0,8,0,-36"
                    behaviors:HoverBehavior.EnableScaleHover="True"
                    behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                    BackgroundColor="Transparent"
                    HeightRequest="24"
                    HorizontalOptions="Center"
                    StrokeThickness="0"
                    WidthRequest="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleDescriptionCommand}" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Label FontSize="12"
                            HorizontalOptions="Center"
                            IsVisible="{Binding IsDescriptionExpanded, Converter={StaticResource InvertedBoolConverter}}"
                            Text="{mi:Fluent Icon=ChevronDown24,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconPrimary}"
                            VerticalOptions="Center" />
                        <Label FontSize="12"
                            HorizontalOptions="Center"
                            IsVisible="{Binding IsDescriptionExpanded}"
                            Text="{mi:Fluent Icon=ChevronUp24,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconPrimary}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>
            </Grid>

            <!--  Albums/Releases Section  -->
            <Grid Grid.Row="3"
                Margin="{StaticResource DesktopSectionTopMargin}"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="0">
                <Grid Grid.Row="0"
                    ColumnDefinitions="Auto,Auto,*,Auto"
                    ColumnSpacing="16">
                    <Label Grid.Column="0"
                        Style="{StaticResource LabelSectionTitle}"
                        Text="Veröffentlichungen"
                        VerticalOptions="Center" />

                    <Border Grid.Column="1"
                        BackgroundColor="Transparent"
                        HeightRequest="22"
                        Margin="-6,0,0,0"
                        Padding="6,0"
                        Stroke="{DynamicResource BorderPrimary}"
                        StrokeThickness="1"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="3" />
                        </Border.StrokeShape>
                        <Label FontAttributes="Bold"
                            FontSize="10"
                            HorizontalOptions="Center"
                            Text="{Binding AlbumItems.Count}"
                            TextColor="{DynamicResource TextPrimary}"
                            VerticalOptions="Center" />
                    </Border>

                    <BoxView Grid.Column="2"
                        HeightRequest="1"
                        HorizontalOptions="Fill"
                        Opacity="0.75"
                        VerticalOptions="Center" />

                    <Grid Grid.Column="3"
                        ColumnDefinitions="Auto,Auto,Auto,Auto,Auto"
                        ColumnSpacing="8"
                        VerticalOptions="Center">
                        <!--  Play button for the whole releases section  -->
                        <Border Grid.Column="0"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PlayAlbumsCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=Play16,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>

                            <!--  Shuffle button for the whole releases section  -->
                        <Border Grid.Column="1"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShuffleAlbumsCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ArrowShuffle16,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>

                        <!--  Separator between section actions and paging  -->
                        <BoxView Grid.Column="2"
                            HeightRequest="18"
                            Margin="4,0"
                            Opacity="0.75"
                            VerticalOptions="Center"
                            WidthRequest="1" />

                        <!--  Previous page in RowView  -->
                        <Border Grid.Column="3"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            InputTransparent="{Binding Source={x:Reference AlbumsRowView}, Path=CanGoPrev, Converter={StaticResource InvertedBoolConverter}}"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Reference AlbumsRowView}, Path=CanGoPrev}"
                                    TargetType="Border"
                                    Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference AlbumsRowView}, Path=PrevPageCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ChevronLeft24,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>

                            <!--  Next page in RowView  -->
                        <Border Grid.Column="4"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            InputTransparent="{Binding Source={x:Reference AlbumsRowView}, Path=CanGoNext, Converter={StaticResource InvertedBoolConverter}}"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Reference AlbumsRowView}, Path=CanGoNext}"
                                    TargetType="Border"
                                    Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference AlbumsRowView}, Path=NextPageCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ChevronRight24,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Grid>

                <!--  Albums  -->
                <controls:RowView x:Name="AlbumsRowView"
                    Grid.Row="1"
                    Margin="0,16,0,0"
                    ItemCornerRadius="8"
                    ItemsSource="{Binding AlbumItems}"
                    UserDataService="{Binding UserDataService}"
                    PrimaryInfoTappedCommand="{Binding AlbumTappedCommand}"
                    SecondaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    ShowContextMenuAtAnchorCommand="{Binding ShowAlbumContextMenuAtAnchorCommand}"
                    ShowContextMenuAtPositionCommand="{Binding ShowAlbumContextMenuAtPositionCommand}" />

                <!--  Expand/collapse for the releases card list  -->
                <Border Grid.Row="2"
                    Margin="0,8,0,0"
                    behaviors:HoverBehavior.EnableScaleHover="True"
                    behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                    BackgroundColor="Transparent"
                    HeightRequest="24"
                    HorizontalOptions="Center"
                    IsVisible="{Binding Source={x:Reference AlbumsRowView}, Path=CanToggleExpand}"
                    StrokeThickness="0"
                    WidthRequest="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={x:Reference AlbumsRowView}, Path=ToggleExpandCommand}" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Label FontSize="12"
                            HorizontalOptions="Center"
                            IsVisible="{Binding Source={x:Reference AlbumsRowView}, Path=IsExpanded, Converter={StaticResource InvertedBoolConverter}}"
                            Text="{mi:Fluent Icon=ChevronDown24,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconPrimary}"
                            VerticalOptions="Center" />
                        <Label FontSize="12"
                            HorizontalOptions="Center"
                            IsVisible="{Binding Source={x:Reference AlbumsRowView}, Path=IsExpanded}"
                            Text="{mi:Fluent Icon=ChevronUp24,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconPrimary}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>
            </Grid>

            <!--  Similar Artists Section  -->
            <Grid Grid.Row="4"
                Margin="{StaticResource DesktopSectionTopMargin}"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="0">
                <Grid Grid.Row="0"
                    ColumnDefinitions="Auto,Auto,*,Auto"
                    ColumnSpacing="16">
                    <Label Grid.Column="0"
                        Style="{StaticResource LabelSectionTitle}"
                        Text="Ähnliche Interpreten"
                        VerticalOptions="Center" />

                    <Border Grid.Column="1"
                        BackgroundColor="Transparent"
                        HeightRequest="22"
                        Margin="-6,0,0,0"
                        Padding="6,0"
                        Stroke="{DynamicResource BorderPrimary}"
                        StrokeThickness="1"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="3" />
                        </Border.StrokeShape>
                        <Label FontAttributes="Bold"
                            FontSize="10"
                            HorizontalOptions="Center"
                            Text="{Binding SimilarArtistItems.Count}"
                            TextColor="{DynamicResource TextPrimary}"
                            VerticalOptions="Center" />
                    </Border>

                    <BoxView Grid.Column="2"
                        HeightRequest="1"
                        HorizontalOptions="Fill"
                        Opacity="0.75"
                        VerticalOptions="Center" />

                    <Grid Grid.Column="3"
                        ColumnDefinitions="Auto,Auto,Auto,Auto,Auto"
                        ColumnSpacing="8"
                        VerticalOptions="Center">
                        <!--  Play button for the similar artists section  -->
                        <Border Grid.Column="0"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PlaySimilarArtistsCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=Play16,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>

                            <!--  Shuffle button for the similar artists section  -->
                        <Border Grid.Column="1"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShuffleSimilarArtistsCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ArrowShuffle16,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>

                        <!--  Separator between section actions and paging  -->
                        <BoxView Grid.Column="2"
                            HeightRequest="18"
                            Margin="4,0"
                            Opacity="0.75"
                            VerticalOptions="Center"
                            WidthRequest="1" />

                        <!--  Previous page in RowView  -->
                        <Border Grid.Column="3"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            InputTransparent="{Binding Source={x:Reference SimilarArtistsRowView}, Path=CanGoPrev, Converter={StaticResource InvertedBoolConverter}}"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Reference SimilarArtistsRowView}, Path=CanGoPrev}"
                                    TargetType="Border"
                                    Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference SimilarArtistsRowView}, Path=PrevPageCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ChevronLeft24,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>

                            <!--  Next page in RowView  -->
                        <Border Grid.Column="4"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            InputTransparent="{Binding Source={x:Reference SimilarArtistsRowView}, Path=CanGoNext, Converter={StaticResource InvertedBoolConverter}}"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Reference SimilarArtistsRowView}, Path=CanGoNext}"
                                    TargetType="Border"
                                    Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference SimilarArtistsRowView}, Path=NextPageCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ChevronRight24,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Grid>

                <!--  Similar Artists  -->
                <controls:RowView x:Name="SimilarArtistsRowView"
                    Grid.Row="1"
                    Margin="0,16,0,0"
                    ItemCornerRadius="100"
                    ItemsSource="{Binding SimilarArtistItems}"
                    UserDataService="{Binding UserDataService}"
                    PrimaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    SecondaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    ShowContextMenuAtAnchorCommand="{Binding ShowArtistContextMenuAtAnchorCommand}"
                    ShowContextMenuAtPositionCommand="{Binding ShowArtistContextMenuAtPositionCommand}" />

                <!--  Expand/collapse for the similar artists card list  -->
                <Border Grid.Row="2"
                    Margin="0,8,0,0"
                    behaviors:HoverBehavior.EnableScaleHover="True"
                    behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                    BackgroundColor="Transparent"
                    HeightRequest="24"
                    HorizontalOptions="Center"
                    IsVisible="{Binding Source={x:Reference SimilarArtistsRowView}, Path=CanToggleExpand}"
                    StrokeThickness="0"
                    WidthRequest="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={x:Reference SimilarArtistsRowView}, Path=ToggleExpandCommand}" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Label FontSize="12"
                            HorizontalOptions="Center"
                            IsVisible="{Binding Source={x:Reference SimilarArtistsRowView}, Path=IsExpanded, Converter={StaticResource InvertedBoolConverter}}"
                            Text="{mi:Fluent Icon=ChevronDown24,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconPrimary}"
                            VerticalOptions="Center" />
                        <Label FontSize="12"
                            HorizontalOptions="Center"
                            IsVisible="{Binding Source={x:Reference SimilarArtistsRowView}, Path=IsExpanded}"
                            Text="{mi:Fluent Icon=ChevronUp24,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconPrimary}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>
            </Grid>

            <!--  Top Tracks Section  -->
            <Grid Grid.Row="5"
                Margin="{StaticResource DesktopSectionTopMargin}"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="0">
                <Grid Grid.Row="0"
                    ColumnDefinitions="Auto,Auto,*,Auto"
                    ColumnSpacing="16">
                    <Label Grid.Column="0"
                        Style="{StaticResource LabelSectionTitle}"
                        Text="Toplieder"
                        VerticalOptions="Center" />

                    <Border Grid.Column="1"
                        BackgroundColor="Transparent"
                        HeightRequest="22"
                        Margin="-6,0,0,0"
                        Padding="6,0"
                        Stroke="{DynamicResource BorderPrimary}"
                        StrokeThickness="1"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="3" />
                        </Border.StrokeShape>
                        <Label FontAttributes="Bold"
                            FontSize="10"
                            HorizontalOptions="Center"
                            Text="{Binding TopTrackItems.Count}"
                            TextColor="{DynamicResource TextPrimary}"
                            VerticalOptions="Center" />
                    </Border>

                    <BoxView Grid.Column="2"
                        HeightRequest="1"
                        HorizontalOptions="Fill"
                        Opacity="0.75"
                        VerticalOptions="Center" />

                    <Grid Grid.Column="3"
                        ColumnDefinitions="Auto,Auto,Auto,Auto,Auto"
                        ColumnSpacing="8"
                        VerticalOptions="Center">
                        <!--  Play button for top tracks section  -->
                        <Border Grid.Column="0"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PlayArtistCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=Play16,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>

                        <!--  Shuffle button for top tracks section  -->
                        <Border Grid.Column="1"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShuffleArtistCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ArrowShuffle16,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>

                        <!--  Separator between section actions and paging  -->
                        <BoxView Grid.Column="2"
                            HeightRequest="18"
                            Margin="4,0"
                            Opacity="0.75"
                            VerticalOptions="Center"
                            WidthRequest="1" />

                        <!--  Previous page in TableView  -->
                        <Border Grid.Column="3"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            InputTransparent="{Binding Source={x:Reference TopTracksTableView}, Path=CanGoPrev, Converter={StaticResource InvertedBoolConverter}}"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Reference TopTracksTableView}, Path=CanGoPrev}"
                                    TargetType="Border"
                                    Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference TopTracksTableView}, Path=PrevPageCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ChevronLeft24,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>

                        <!--  Next page in TableView  -->
                        <Border Grid.Column="4"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            InputTransparent="{Binding Source={x:Reference TopTracksTableView}, Path=CanGoNext, Converter={StaticResource InvertedBoolConverter}}"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Reference TopTracksTableView}, Path=CanGoNext}"
                                    TargetType="Border"
                                    Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference TopTracksTableView}, Path=NextPageCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ChevronRight24,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Grid>

                <controls:TableView x:Name="TopTracksTableView"
                    Grid.Row="1"
                    Margin="0,16,0,0"
                    PageSize="15"
                    ItemsSource="{Binding TopTrackItems}"
                    UserDataService="{Binding UserDataService}"
                    PrimaryInfoTappedCommand="{Binding AlbumTappedCommand}"
                    SecondaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    ShowContextMenuAtAnchorCommand="{Binding ShowTrackContextMenuAtAnchorCommand}"
                    ShowContextMenuAtPositionCommand="{Binding ShowTrackContextMenuAtPositionCommand}" />

                <!--  Expand/collapse for top tracks list  -->
                <Border Grid.Row="2"
                    Margin="0,8,0,0"
                    behaviors:HoverBehavior.EnableScaleHover="True"
                    behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                    BackgroundColor="Transparent"
                    HeightRequest="24"
                    HorizontalOptions="Center"
                    IsVisible="{Binding Source={x:Reference TopTracksTableView}, Path=CanToggleExpand}"
                    StrokeThickness="0"
                    WidthRequest="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={x:Reference TopTracksTableView}, Path=ToggleExpandCommand}" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Label FontSize="12"
                            HorizontalOptions="Center"
                            IsVisible="{Binding Source={x:Reference TopTracksTableView}, Path=IsExpanded, Converter={StaticResource InvertedBoolConverter}}"
                            Text="{mi:Fluent Icon=ChevronDown24,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconPrimary}"
                            VerticalOptions="Center" />
                        <Label FontSize="12"
                            HorizontalOptions="Center"
                            IsVisible="{Binding Source={x:Reference TopTracksTableView}, Path=IsExpanded}"
                            Text="{mi:Fluent Icon=ChevronUp24,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconPrimary}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </ScrollView>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="mashin.Views.Desktop.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:mashin.Views.Desktop.Behaviors"
    xmlns:controls="clr-namespace:mashin.Views.Desktop.Controls"
    xmlns:converters="clr-namespace:mashin.Converters"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:vm="clr-namespace:mashin.ViewModels"
    x:DataType="vm:HomeViewModel"
    BackgroundColor="{DynamicResource BackgroundPrimary}">
    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <ScrollView x:Name="scrollView">
        <Grid
            Padding="{StaticResource PagePaddingDesktop}"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
            RowSpacing="0">

            <!--  Header  -->
            <VerticalStackLayout Grid.Row="0" Spacing="6">
                <Label Style="{StaticResource LabelPageTitle}"
                    Text="Willkommen zurück!" />
            </VerticalStackLayout>

            <!--  Recommendations Slide (incl. Skeletons)  -->
            <Grid Grid.Row="1"
                Margin="{StaticResource SectionTopMargin}"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="0">
                <Grid Grid.Row="0"
                    ColumnDefinitions="Auto,Auto,*,Auto"
                    ColumnSpacing="16">
                    <Label Grid.Column="0"
                        Style="{StaticResource LabelSectionTitle}"
                        Text="Unsere Empfehlungen für dich"
                        VerticalOptions="Center" />
                    <Border Grid.Column="1"
                        BackgroundColor="Transparent"
                        HeightRequest="22"
                        Margin="-6,0,0,0"
                        Padding="6,0"
                        Stroke="{DynamicResource BorderPrimary}"
                        StrokeThickness="1"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="3" />
                        </Border.StrokeShape>
                        <Label FontAttributes="Bold"
                            FontSize="10"
                            HorizontalOptions="Center"
                            Text="{Binding RecommendationTrackItems.Count}"
                            TextColor="{DynamicResource TextPrimary}"
                            VerticalOptions="Center" />
                    </Border>
                    <BoxView Grid.Column="2"
                        HeightRequest="1"
                        HorizontalOptions="Fill"
                        Opacity="0.75"
                        VerticalOptions="Center" />
                    <Grid Grid.Column="3"
                        ColumnDefinitions="Auto,Auto"
                        ColumnSpacing="8"
                        VerticalOptions="Center">
                        <Border Grid.Column="0"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            InputTransparent="{Binding Source={x:Reference RecommendationFolderSlideView}, Path=CanGoPrev, Converter={StaticResource InvertedBoolConverter}}"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Reference RecommendationFolderSlideView}, Path=CanGoPrev}"
                                    TargetType="Border"
                                    Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference RecommendationFolderSlideView}, Path=PrevPageCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ChevronLeft24,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>
                        <Border Grid.Column="1"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            InputTransparent="{Binding Source={x:Reference RecommendationFolderSlideView}, Path=CanGoNext, Converter={StaticResource InvertedBoolConverter}}"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Reference RecommendationFolderSlideView}, Path=CanGoNext}"
                                    TargetType="Border"
                                    Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference RecommendationFolderSlideView}, Path=NextPageCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ChevronRight24,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Grid>

                <Label Grid.Row="1"
                    Margin="0,16,0,0"
                    IsVisible="{Binding ShowNoRecommendationFolderMessage}"
                    Style="{StaticResource LabelTertiary}"
                    Text="Keine ListenBrainz-Recommendation-Folder verfuegbar." />

                <controls:SlideView x:Name="RecommendationFolderSlideView"
                    Grid.Row="2"
                    Margin="0,16,0,0"
                    CoverSize="175"
                    IsVisible="{Binding ShowRecommendationFolderSlideView}"
                    ItemCornerRadius="8"
                    ItemsSource="{Binding RecommendationTrackItems}"
                    MediaActions="{Binding MediaActions}"
                    PrimaryInfoTappedCommand="{Binding AlbumTappedCommand}"
                    SecondaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    ShowContextMenuAtAnchorCommand="{Binding ShowTrackContextMenuAtAnchorCommand}"
                    ShowContextMenuAtPositionCommand="{Binding ShowTrackContextMenuAtPositionCommand}" />
            </Grid>

            <!--  Genre Playlists List (incl. Skeletons)  -->
            <Grid Grid.Row="2"
                Margin="{StaticResource SectionTopMargin}"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="0">
                <Grid Grid.Row="0"
                    ColumnDefinitions="Auto,Auto,*"
                    ColumnSpacing="16">
                    <Label Grid.Column="0"
                        Style="{StaticResource LabelSectionTitle}"
                        Text="Genres, die du liebst"
                        VerticalOptions="Center" />
                    <Border Grid.Column="1"
                        BackgroundColor="Transparent"
                        HeightRequest="22"
                        Margin="-6,0,0,0"
                        Padding="6,0"
                        Stroke="{DynamicResource BorderPrimary}"
                        StrokeThickness="1"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="3" />
                        </Border.StrokeShape>
                        <Label FontAttributes="Bold"
                            FontSize="10"
                            HorizontalOptions="Center"
                            Text="{Binding GenrePlaylistItems.Count}"
                            TextColor="{DynamicResource TextPrimary}"
                            VerticalOptions="Center" />
                    </Border>
                    <BoxView Grid.Column="2"
                        HeightRequest="1"
                        HorizontalOptions="Fill"
                        Opacity="0.75"
                        VerticalOptions="Center" />
                </Grid>

                <Label Grid.Row="1"
                    Margin="0,16,0,0"
                    IsVisible="{Binding ShowNoGenrePlaylistsMessage}"
                    Style="{StaticResource LabelTertiary}"
                    Text="Keine Genre-Playlists verfuegbar." />

                <controls:ListView Grid.Row="2"
                    Margin="0,16,0,0"
                    IsVisible="{Binding ShowGenrePlaylistsListView}"
                    ItemsSource="{Binding GenrePlaylistItems}"
                    MaxItems="9"
                    MediaActions="{Binding MediaActions}"
                    PrimaryInfoTappedCommand="{Binding PlaylistTappedCommand}" />
            </Grid>

            <!--  Genre Artists 1  -->
            <Grid Grid.Row="3"
                Margin="{StaticResource SectionTopMargin}"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="0"
                IsVisible="{Binding GenreArtistSections[0].IsVisible}">
                <controls:RowView
                    Grid.Row="2"
                    Margin="0,16,0,0"
                    IsVisible="{Binding GenreArtistSections[0].ShowRowView}"
                    ItemCornerRadius="100"
                    ItemsSource="{Binding GenreArtistSections[0].Items}"
                    MediaActions="{Binding MediaActions}"
                    PrimaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    SecondaryInfoTappedCommand="{Binding ArtistTappedCommand}" />

                <Grid Grid.Row="0"
                    ColumnDefinitions="Auto,Auto,*"
                    ColumnSpacing="16">
                    <Label Grid.Column="0"
                        Style="{StaticResource LabelSectionTitle}"
                        Text="{Binding GenreArtistSections[0].Title}"
                        VerticalOptions="Center" />
                    <Border Grid.Column="1"
                        BackgroundColor="Transparent"
                        HeightRequest="22"
                        Margin="-6,0,0,0"
                        Padding="6,0"
                        Stroke="{DynamicResource BorderPrimary}"
                        StrokeThickness="1"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="3" />
                        </Border.StrokeShape>
                        <Label FontAttributes="Bold"
                            FontSize="10"
                            HorizontalOptions="Center"
                            Text="{Binding GenreArtistSections[0].ItemCount}"
                            TextColor="{DynamicResource TextPrimary}"
                            VerticalOptions="Center" />
                    </Border>
                    <BoxView Grid.Column="2"
                        HeightRequest="1"
                        HorizontalOptions="Fill"
                        Opacity="0.75"
                        VerticalOptions="Center" />
                </Grid>

                <Label Grid.Row="1"
                    Margin="0,16,0,0"
                    IsVisible="{Binding GenreArtistSections[0].ShowEmptyMessage}"
                    Style="{StaticResource LabelTertiary}"
                    Text="Keine Genre-Artists verfuegbar." />
            </Grid>

            <!--  Genre Artists 2  -->
            <Grid Grid.Row="4"
                Margin="{StaticResource SectionTopMargin}"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="0"
                IsVisible="{Binding GenreArtistSections[1].IsVisible}">
                <controls:RowView Grid.Row="2"
                    Margin="0,16,0,0"
                    IsVisible="{Binding GenreArtistSections[1].ShowRowView}"
                    ItemCornerRadius="100"
                    ItemsSource="{Binding GenreArtistSections[1].Items}"
                    MediaActions="{Binding MediaActions}"
                    PrimaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    SecondaryInfoTappedCommand="{Binding ArtistTappedCommand}" />

                <Grid Grid.Row="0"
                    ColumnDefinitions="Auto,Auto,*"
                    ColumnSpacing="16">
                    <Label Grid.Column="0"
                        Style="{StaticResource LabelSectionTitle}"
                        Text="{Binding GenreArtistSections[1].Title}"
                        VerticalOptions="Center" />
                    <Border Grid.Column="1"
                        BackgroundColor="Transparent"
                        HeightRequest="22"
                        Margin="-6,0,0,0"
                        Padding="6,0"
                        Stroke="{DynamicResource BorderPrimary}"
                        StrokeThickness="1"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="3" />
                        </Border.StrokeShape>
                        <Label FontAttributes="Bold"
                            FontSize="10"
                            HorizontalOptions="Center"
                            Text="{Binding GenreArtistSections[1].ItemCount}"
                            TextColor="{DynamicResource TextPrimary}"
                            VerticalOptions="Center" />
                    </Border>
                    <BoxView Grid.Column="2"
                        HeightRequest="1"
                        HorizontalOptions="Fill"
                        Opacity="0.75"
                        VerticalOptions="Center" />
                </Grid>

                <Label Grid.Row="1"
                    Margin="0,16,0,0"
                    IsVisible="{Binding GenreArtistSections[1].ShowEmptyMessage}"
                    Style="{StaticResource LabelTertiary}"
                    Text="Keine Genre-Artists verfuegbar." />
            </Grid>

            <!--  Genre Artists 3  -->
            <Grid Grid.Row="5"
                Margin="{StaticResource SectionTopMargin}"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="0"
                IsVisible="{Binding GenreArtistSections[2].IsVisible}">
                <controls:RowView Grid.Row="2"
                    Margin="0,16,0,0"
                    IsVisible="{Binding GenreArtistSections[2].ShowRowView}"
                    ItemCornerRadius="100"
                    ItemsSource="{Binding GenreArtistSections[2].Items}"
                    MediaActions="{Binding MediaActions}"
                    PrimaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    SecondaryInfoTappedCommand="{Binding ArtistTappedCommand}" />

                <Grid Grid.Row="0"
                    ColumnDefinitions="Auto,Auto,*"
                    ColumnSpacing="16">
                    <Label Grid.Column="0"
                        Style="{StaticResource LabelSectionTitle}"
                        Text="{Binding GenreArtistSections[2].Title}"
                        VerticalOptions="Center" />
                    <Border Grid.Column="1"
                        BackgroundColor="Transparent"
                        HeightRequest="22"
                        Margin="-6,0,0,0"
                        Padding="6,0"
                        Stroke="{DynamicResource BorderPrimary}"
                        StrokeThickness="1"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="3" />
                        </Border.StrokeShape>
                        <Label FontAttributes="Bold"
                            FontSize="10"
                            HorizontalOptions="Center"
                            Text="{Binding GenreArtistSections[2].ItemCount}"
                            TextColor="{DynamicResource TextPrimary}"
                            VerticalOptions="Center" />
                    </Border>
                    <BoxView Grid.Column="2"
                        HeightRequest="1"
                        HorizontalOptions="Fill"
                        Opacity="0.75"
                        VerticalOptions="Center" />
                </Grid>

                <Label Grid.Row="1"
                    Margin="0,16,0,0"
                    IsVisible="{Binding GenreArtistSections[2].ShowEmptyMessage}"
                    Style="{StaticResource LabelTertiary}"
                    Text="Keine Genre-Artists verfuegbar." />
            </Grid>

            <!--  Genre Artists 4  -->
            <Grid Grid.Row="6"
                Margin="{StaticResource SectionTopMargin}"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="0"
                IsVisible="{Binding GenreArtistSections[3].IsVisible}">
                <controls:RowView Grid.Row="2"
                    Margin="0,16,0,0"
                    IsVisible="{Binding GenreArtistSections[3].ShowRowView}"
                    ItemCornerRadius="100"
                    ItemsSource="{Binding GenreArtistSections[3].Items}"
                    MediaActions="{Binding MediaActions}"
                    PrimaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    SecondaryInfoTappedCommand="{Binding ArtistTappedCommand}" />

                <Grid Grid.Row="0"
                    ColumnDefinitions="Auto,Auto,*"
                    ColumnSpacing="16">
                    <Label Grid.Column="0"
                        Style="{StaticResource LabelSectionTitle}"
                        Text="{Binding GenreArtistSections[3].Title}"
                        VerticalOptions="Center" />
                    <Border Grid.Column="1"
                        BackgroundColor="Transparent"
                        HeightRequest="22"
                        Margin="-6,0,0,0"
                        Padding="6,0"
                        Stroke="{DynamicResource BorderPrimary}"
                        StrokeThickness="1"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="3" />
                        </Border.StrokeShape>
                        <Label FontAttributes="Bold"
                            FontSize="10"
                            HorizontalOptions="Center"
                            Text="{Binding GenreArtistSections[3].ItemCount}"
                            TextColor="{DynamicResource TextPrimary}"
                            VerticalOptions="Center" />
                    </Border>
                    <BoxView Grid.Column="2"
                        HeightRequest="1"
                        HorizontalOptions="Fill"
                        Opacity="0.75"
                        VerticalOptions="Center" />
                </Grid>

                <Label Grid.Row="1"
                    Margin="0,16,0,0"
                    IsVisible="{Binding GenreArtistSections[3].ShowEmptyMessage}"
                    Style="{StaticResource LabelTertiary}"
                    Text="Keine Genre-Artists verfuegbar." />
            </Grid>

            <!--  Genre Artists 5  -->
            <Grid Grid.Row="7"
                Margin="{StaticResource SectionTopMargin}"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="0"
                IsVisible="{Binding GenreArtistSections[4].IsVisible}">
                <controls:RowView Grid.Row="2"
                    Margin="0,16,0,0"
                    IsVisible="{Binding GenreArtistSections[4].ShowRowView}"
                    ItemCornerRadius="100"
                    ItemsSource="{Binding GenreArtistSections[4].Items}"
                    MediaActions="{Binding MediaActions}"
                    PrimaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    SecondaryInfoTappedCommand="{Binding ArtistTappedCommand}" />

                <Grid Grid.Row="0"
                    ColumnDefinitions="Auto,Auto,*"
                    ColumnSpacing="16">
                    <Label Grid.Column="0"
                        Style="{StaticResource LabelSectionTitle}"
                        Text="{Binding GenreArtistSections[4].Title}"
                        VerticalOptions="Center" />
                    <Border Grid.Column="1"
                        BackgroundColor="Transparent"
                        HeightRequest="22"
                        Margin="-6,0,0,0"
                        Padding="6,0"
                        Stroke="{DynamicResource BorderPrimary}"
                        StrokeThickness="1"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="3" />
                        </Border.StrokeShape>
                        <Label FontAttributes="Bold"
                            FontSize="10"
                            HorizontalOptions="Center"
                            Text="{Binding GenreArtistSections[4].ItemCount}"
                            TextColor="{DynamicResource TextPrimary}"
                            VerticalOptions="Center" />
                    </Border>
                    <BoxView Grid.Column="2"
                        HeightRequest="1"
                        HorizontalOptions="Fill"
                        Opacity="0.75"
                        VerticalOptions="Center" />
                </Grid>

                <Label Grid.Row="1"
                    Margin="0,16,0,0"
                    IsVisible="{Binding GenreArtistSections[4].ShowEmptyMessage}"
                    Style="{StaticResource LabelTertiary}"
                    Text="Keine Genre-Artists verfuegbar." />
            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>
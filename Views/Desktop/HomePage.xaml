<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="mashin.Views.Desktop.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:mashin.Views.Desktop.Behaviors"
    xmlns:controls="clr-namespace:mashin.Views.Desktop.Controls"
    xmlns:converters="clr-namespace:mashin.Converters"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:vm="clr-namespace:mashin.ViewModels"
    x:Name="HomePageRoot"
    x:DataType="vm:HomeViewModel"
    BackgroundColor="{DynamicResource BackgroundPrimary}">
    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <ScrollView x:Name="scrollView">
        <Grid
            Padding="{StaticResource PagePaddingDesktop}"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
            RowSpacing="0">

            <!--  Header  -->
            <VerticalStackLayout Grid.Row="0" Spacing="6">
                <Label Style="{StaticResource LabelPageTitle}"
                    Text="Willkommen zurück!" />
            </VerticalStackLayout>

            <!--  Genre-Playlists  -->
            <Grid Grid.Row="1"
                Margin="{StaticResource SectionTopMargin}"
                RowDefinitions="Auto,Auto,Auto,Auto"
                RowSpacing="0">
                <Grid Grid.Row="0"
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="16">
                    <Label Grid.Column="0"
                        Style="{StaticResource LabelSectionTitle}"
                        Text="Playlists, die du lieben wirst"
                        VerticalOptions="Center" />
                    <BoxView Grid.Column="1"
                        HeightRequest="1"
                        HorizontalOptions="Fill"
                        Opacity="0.75"
                        VerticalOptions="Center" />
                    <Grid Grid.Column="2"
                        ColumnDefinitions="Auto,Auto"
                        ColumnSpacing="8"
                        VerticalOptions="Center">
                        <Border Grid.Column="0"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            InputTransparent="{Binding Source={x:Reference GenrePlaylistsRowView}, Path=CanGoPrev, Converter={StaticResource InvertedBoolConverter}}"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Reference GenrePlaylistsRowView}, Path=CanGoPrev}"
                                    TargetType="Border"
                                    Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference GenrePlaylistsRowView}, Path=PrevPageCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ChevronLeft24,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>
                        <Border Grid.Column="1"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            InputTransparent="{Binding Source={x:Reference GenrePlaylistsRowView}, Path=CanGoNext, Converter={StaticResource InvertedBoolConverter}}"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Reference GenrePlaylistsRowView}, Path=CanGoNext}"
                                    TargetType="Border"
                                    Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference GenrePlaylistsRowView}, Path=NextPageCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ChevronRight24,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Grid>
                <Label Grid.Row="1"
                    Margin="0,16,0,0"
                    IsVisible="{Binding ShowNoGenrePlaylistsMessage}"
                    Style="{StaticResource LabelTertiary}"
                    Text="Keine Genre-Playlists verfügbar." />
                <controls:RowView x:Name="GenrePlaylistsRowView"
                    Grid.Row="2"
                    Margin="0,16,0,0"
                    IsVisible="{Binding ShowGenrePlaylists}"
                    ItemCornerRadius="8"
                    ItemsSource="{Binding GenrePlaylistItems}"
                    MediaActions="{Binding MediaActions}"
                    PrimaryInfoTappedCommand="{Binding PlaylistTappedCommand}"
                    ShowContextMenuAtAnchorCommand="{Binding ShowPlaylistContextMenuAtAnchorCommand}"
                    ShowContextMenuAtPositionCommand="{Binding ShowPlaylistContextMenuAtPositionCommand}" />
            </Grid>

            <!--  Lieblings-Playlists  -->
            <Grid Grid.Row="2"
                Margin="{StaticResource SectionTopMargin}"
                RowDefinitions="Auto,Auto,Auto,Auto"
                RowSpacing="0">
                <Grid Grid.Row="0"
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="16">
                    <Label Grid.Column="0"
                        Style="{StaticResource LabelSectionTitle}"
                        Text="Playlists, die du liebst"
                        VerticalOptions="Center" />
                    <BoxView Grid.Column="1"
                        HeightRequest="1"
                        HorizontalOptions="Fill"
                        Opacity="0.75"
                        VerticalOptions="Center" />
                    <Grid Grid.Column="2"
                        ColumnDefinitions="Auto,Auto"
                        ColumnSpacing="8"
                        VerticalOptions="Center">
                        <Border Grid.Column="0"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            InputTransparent="{Binding Source={x:Reference FavoritePlaylistsRowView}, Path=CanGoPrev, Converter={StaticResource InvertedBoolConverter}}"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Reference FavoritePlaylistsRowView}, Path=CanGoPrev}"
                                    TargetType="Border"
                                    Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference FavoritePlaylistsRowView}, Path=PrevPageCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ChevronLeft24,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>
                        <Border Grid.Column="1"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            InputTransparent="{Binding Source={x:Reference FavoritePlaylistsRowView}, Path=CanGoNext, Converter={StaticResource InvertedBoolConverter}}"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Reference FavoritePlaylistsRowView}, Path=CanGoNext}"
                                    TargetType="Border"
                                    Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference FavoritePlaylistsRowView}, Path=NextPageCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ChevronRight24,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Grid>
                <Label Grid.Row="1"
                    Margin="0,16,0,0"
                    IsVisible="{Binding ShowNoFavoritePlaylistsMessage}"
                    Style="{StaticResource LabelTertiary}"
                    Text="Keine favorisierten Playlists gefunden." />
                <controls:RowView x:Name="FavoritePlaylistsRowView"
                    Grid.Row="2"
                    Margin="0,16,0,0"
                    IsVisible="{Binding ShowFavoritePlaylists}"
                    ItemCornerRadius="8"
                    ItemsSource="{Binding FavoritePlaylistItems}"
                    MediaActions="{Binding MediaActions}"
                    PrimaryInfoTappedCommand="{Binding PlaylistTappedCommand}"
                    ShowContextMenuAtAnchorCommand="{Binding ShowPlaylistContextMenuAtAnchorCommand}"
                    ShowContextMenuAtPositionCommand="{Binding ShowPlaylistContextMenuAtPositionCommand}" />
            </Grid>

            <!--  Mixe  -->
            <Grid Grid.Row="3"
                Margin="{StaticResource SectionTopMargin}"
                RowDefinitions="Auto,Auto,Auto,Auto"
                RowSpacing="0">
                <Grid Grid.Row="0"
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="16">
                    <Label Grid.Column="0"
                        Style="{StaticResource LabelSectionTitle}"
                        Text="Mixe, inspiriert von"
                        VerticalOptions="Center" />
                    <BoxView Grid.Column="1"
                        HeightRequest="1"
                        HorizontalOptions="Fill"
                        Opacity="0.75"
                        VerticalOptions="Center" />
                    <Grid Grid.Column="2"
                        ColumnDefinitions="Auto,Auto"
                        ColumnSpacing="8"
                        VerticalOptions="Center">
                        <Border Grid.Column="0"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            InputTransparent="{Binding Source={x:Reference MixTracksRowView}, Path=CanGoPrev, Converter={StaticResource InvertedBoolConverter}}"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Reference MixTracksRowView}, Path=CanGoPrev}"
                                    TargetType="Border"
                                    Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference MixTracksRowView}, Path=PrevPageCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ChevronLeft24,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>
                        <Border Grid.Column="1"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            InputTransparent="{Binding Source={x:Reference MixTracksRowView}, Path=CanGoNext, Converter={StaticResource InvertedBoolConverter}}"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Reference MixTracksRowView}, Path=CanGoNext}"
                                    TargetType="Border"
                                    Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference MixTracksRowView}, Path=NextPageCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ChevronRight24,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Grid>
                <Label Grid.Row="1"
                    Margin="0,16,0,0"
                    IsVisible="{Binding ShowNoMixTracksMessage}"
                    Style="{StaticResource LabelTertiary}"
                    Text="Keine Mixe verfügbar." />
                <controls:RowView x:Name="MixTracksRowView"
                    Grid.Row="2"
                    Margin="0,16,0,0"
                    IsVisible="{Binding ShowMixTracks}"
                    ItemCornerRadius="8"
                    ItemsSource="{Binding MixTrackItems}"
                    MediaActions="{Binding MediaActions}"
                    PrimaryInfoTappedCommand="{Binding MixTrackTappedCommand}"
                    ShowContextMenuAtAnchorCommand="{Binding ShowMixTrackContextMenuAtAnchorCommand}"
                    ShowContextMenuAtPositionCommand="{Binding ShowMixTrackContextMenuAtPositionCommand}" />
            </Grid>

            <!--  Künstler-Playlists  -->
            <Grid Grid.Row="4"
                Margin="{StaticResource SectionTopMargin}"
                RowDefinitions="Auto,Auto,Auto,Auto"
                RowSpacing="0">
                <Grid Grid.Row="0"
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="16">
                    <Label Grid.Column="0"
                        Style="{StaticResource LabelSectionTitle}"
                        Text="Für dich erstellt"
                        VerticalOptions="Center" />
                    <BoxView Grid.Column="1"
                        HeightRequest="1"
                        HorizontalOptions="Fill"
                        Opacity="0.75"
                        VerticalOptions="Center" />
                    <Grid Grid.Column="2"
                        ColumnDefinitions="Auto,Auto"
                        ColumnSpacing="8"
                        VerticalOptions="Center">
                        <Border Grid.Column="0"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            InputTransparent="{Binding Source={x:Reference ArtistPlaylistsRowView}, Path=CanGoPrev, Converter={StaticResource InvertedBoolConverter}}"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Reference ArtistPlaylistsRowView}, Path=CanGoPrev}"
                                    TargetType="Border"
                                    Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference ArtistPlaylistsRowView}, Path=PrevPageCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ChevronLeft24,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>
                        <Border Grid.Column="1"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            InputTransparent="{Binding Source={x:Reference ArtistPlaylistsRowView}, Path=CanGoNext, Converter={StaticResource InvertedBoolConverter}}"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Reference ArtistPlaylistsRowView}, Path=CanGoNext}"
                                    TargetType="Border"
                                    Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference ArtistPlaylistsRowView}, Path=NextPageCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ChevronRight24,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Grid>
                <Label Grid.Row="1"
                    Margin="0,16,0,0"
                    IsVisible="{Binding ShowNoArtistPlaylistsMessage}"
                    Style="{StaticResource LabelTertiary}"
                    Text="Keine Künstler-Playlists verfügbar." />
                <controls:RowView x:Name="ArtistPlaylistsRowView"
                    Grid.Row="2"
                    Margin="0,16,0,0"
                    IsVisible="{Binding ShowArtistPlaylists}"
                    ItemCornerRadius="8"
                    ItemsSource="{Binding ArtistPlaylistItems}"
                    MediaActions="{Binding MediaActions}"
                    PrimaryInfoTappedCommand="{Binding PlaylistTappedCommand}"
                    ShowContextMenuAtAnchorCommand="{Binding ShowPlaylistContextMenuAtAnchorCommand}"
                    ShowContextMenuAtPositionCommand="{Binding ShowPlaylistContextMenuAtPositionCommand}" />
            </Grid>

            <!--  Top-Künstler  -->
            <Grid Grid.Row="5"
                Margin="{StaticResource SectionTopMargin}"
                RowDefinitions="Auto,Auto,Auto,Auto"
                RowSpacing="0">
                <Grid Grid.Row="0"
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="16">
                    <Label Grid.Column="0"
                        Style="{StaticResource LabelSectionTitle}"
                        Text="In letzter Zeit liebst du"
                        VerticalOptions="Center" />
                    <BoxView Grid.Column="1"
                        HeightRequest="1"
                        HorizontalOptions="Fill"
                        Opacity="0.75"
                        VerticalOptions="Center" />
                    <Grid Grid.Column="2"
                        ColumnDefinitions="Auto,Auto"
                        ColumnSpacing="8"
                        VerticalOptions="Center">
                        <Border Grid.Column="0"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            InputTransparent="{Binding Source={x:Reference TopArtistsRowView}, Path=CanGoPrev, Converter={StaticResource InvertedBoolConverter}}"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Reference TopArtistsRowView}, Path=CanGoPrev}"
                                    TargetType="Border"
                                    Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference TopArtistsRowView}, Path=PrevPageCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ChevronLeft24,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>
                        <Border Grid.Column="1"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                            BackgroundColor="Transparent"
                            HeightRequest="28"
                            InputTransparent="{Binding Source={x:Reference TopArtistsRowView}, Path=CanGoNext, Converter={StaticResource InvertedBoolConverter}}"
                            StrokeThickness="0"
                            WidthRequest="28">
                            <Border.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Reference TopArtistsRowView}, Path=CanGoNext}"
                                    TargetType="Border"
                                    Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference TopArtistsRowView}, Path=NextPageCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label FontSize="14"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=ChevronRight24,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Grid>
                <Label Grid.Row="1"
                    Margin="0,16,0,0"
                    IsVisible="{Binding ShowNoTopArtistsMessage}"
                    Style="{StaticResource LabelTertiary}"
                    Text="Keine Top-Künstler verfügbar." />
                <controls:RowView x:Name="TopArtistsRowView"
                    Grid.Row="2"
                    Margin="0,16,0,0"
                    IsVisible="{Binding ShowTopArtists}"
                    ItemCornerRadius="100"
                    ItemsSource="{Binding TopArtistItems}"
                    MediaActions="{Binding MediaActions}"
                    PrimaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    SecondaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    ShowContextMenuAtAnchorCommand="{Binding ShowArtistContextMenuAtAnchorCommand}"
                    ShowContextMenuAtPositionCommand="{Binding ShowArtistContextMenuAtPositionCommand}" />
            </Grid>

            <!--  Empfehlungen  -->
            <Grid Grid.Row="6"
                Margin="{StaticResource SectionTopMargin}"
                RowDefinitions="Auto,Auto,Auto,Auto"
                RowSpacing="0">
                <Grid Grid.Row="0"
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="16">
                    <Label Grid.Column="0"
                        Style="{StaticResource LabelSectionTitle}"
                        Text="Neuheiten für dich"
                        VerticalOptions="Center" />
                    <BoxView Grid.Column="1"
                        HeightRequest="1"
                        HorizontalOptions="Fill"
                        Opacity="0.75"
                        VerticalOptions="Center" />
                </Grid>
                <Label Grid.Row="1"
                    Margin="0,16,0,0"
                    IsVisible="{Binding ShowNoRecommendationTracksMessage}"
                    Style="{StaticResource LabelTertiary}"
                    Text="Keine Empfehlungen gefunden." />
                <controls:TableView Grid.Row="2"
                    Margin="0,16,0,0"
                    IsVisible="{Binding ShowRecommendationTracks}"
                    ItemsSource="{Binding RecommendationTrackItems}"
                    MediaActions="{Binding MediaActions}"
                    PageSize="10"
                    PrimaryInfoTappedCommand="{Binding AlbumTappedCommand}"
                    SecondaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    ShowContextMenuAtAnchorCommand="{Binding ShowTrackContextMenuAtAnchorCommand}"
                    ShowContextMenuAtPositionCommand="{Binding ShowTrackContextMenuAtPositionCommand}" />
            </Grid>

            <!--  Genre-Künstler-Sektionen  -->
            <Grid Grid.Row="7"
                Margin="{StaticResource SectionTopMargin}"
                RowDefinitions="Auto,Auto"
                RowSpacing="0">
                <Label Grid.Row="0"
                    Margin="0,16,0,0"
                    IsVisible="{Binding ShowNoGenreArtistSectionsMessage}"
                    Style="{StaticResource LabelTertiary}"
                    Text="Keine Genre-Künstler-Sektionen verfügbar." />
                <VerticalStackLayout Grid.Row="1"
                    IsVisible="{Binding ShowGenreArtistSections}"
                    BindableLayout.ItemsSource="{Binding GenreArtistSections}"
                    Spacing="24">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:HomeArtistSection">
                            <Grid RowDefinitions="Auto,Auto"
                                RowSpacing="0">
                                <Grid Grid.Row="0"
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="16">
                                    <Label Grid.Column="0"
                                        Style="{StaticResource LabelSectionTitle}"
                                        Text="{Binding Title}"
                                        VerticalOptions="Center" />
                                    <BoxView Grid.Column="1"
                                        HeightRequest="1"
                                        HorizontalOptions="Fill"
                                        Opacity="0.75"
                                        VerticalOptions="Center" />
                                </Grid>
                                <controls:RowView Grid.Row="1"
                                    Margin="0,16,0,0"
                                    ItemCornerRadius="100"
                                    ItemsSource="{Binding ArtistItems}"
                                    MediaActions="{Binding Source={x:Reference HomePageRoot}, Path=BindingContext.MediaActions}"
                                    PrimaryInfoTappedCommand="{Binding Source={x:Reference HomePageRoot}, Path=BindingContext.ArtistTappedCommand}"
                                    SecondaryInfoTappedCommand="{Binding Source={x:Reference HomePageRoot}, Path=BindingContext.ArtistTappedCommand}"
                                    ShowContextMenuAtAnchorCommand="{Binding Source={x:Reference HomePageRoot}, Path=BindingContext.ShowArtistContextMenuAtAnchorCommand}"
                                    ShowContextMenuAtPositionCommand="{Binding Source={x:Reference HomePageRoot}, Path=BindingContext.ShowArtistContextMenuAtPositionCommand}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Grid>

            <!--  Ähnliche-Künstler-Sektionen  -->
            <Grid Grid.Row="8"
                Margin="{StaticResource SectionTopMargin}"
                RowDefinitions="Auto,Auto"
                RowSpacing="0">
                <Label Grid.Row="0"
                    Margin="0,16,0,0"
                    IsVisible="{Binding ShowNoSimilarArtistSectionsMessage}"
                    Style="{StaticResource LabelTertiary}"
                    Text="Keine ähnliche-Künstler-Sektionen verfügbar." />
                <VerticalStackLayout Grid.Row="1"
                    IsVisible="{Binding ShowSimilarArtistSections}"
                    BindableLayout.ItemsSource="{Binding SimilarArtistSections}"
                    Spacing="24">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:HomeArtistSection">
                            <Grid RowDefinitions="Auto,Auto"
                                RowSpacing="0">
                                <Grid Grid.Row="0"
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="16">
                                    <Label Grid.Column="0"
                                        Style="{StaticResource LabelSectionTitle}"
                                        Text="{Binding Title}"
                                        VerticalOptions="Center" />
                                    <BoxView Grid.Column="1"
                                        HeightRequest="1"
                                        HorizontalOptions="Fill"
                                        Opacity="0.75"
                                        VerticalOptions="Center" />
                                </Grid>
                                <controls:RowView Grid.Row="1"
                                    Margin="0,16,0,0"
                                    ItemCornerRadius="100"
                                    ItemsSource="{Binding ArtistItems}"
                                    MediaActions="{Binding Source={x:Reference HomePageRoot}, Path=BindingContext.MediaActions}"
                                    PrimaryInfoTappedCommand="{Binding Source={x:Reference HomePageRoot}, Path=BindingContext.ArtistTappedCommand}"
                                    SecondaryInfoTappedCommand="{Binding Source={x:Reference HomePageRoot}, Path=BindingContext.ArtistTappedCommand}"
                                    ShowContextMenuAtAnchorCommand="{Binding Source={x:Reference HomePageRoot}, Path=BindingContext.ShowArtistContextMenuAtAnchorCommand}"
                                    ShowContextMenuAtPositionCommand="{Binding Source={x:Reference HomePageRoot}, Path=BindingContext.ShowArtistContextMenuAtPositionCommand}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Grid>

        </Grid>
    </ScrollView>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="mashin.Views.Desktop.PlaylistDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:mashin.Views.Desktop.Behaviors"
    xmlns:controls="clr-namespace:mashin.Views.Desktop.Controls"
    xmlns:converters="clr-namespace:mashin.Converters"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:vm="clr-namespace:mashin.ViewModels"
    x:DataType="vm:PlaylistDetailViewModel"
    BackgroundColor="{DynamicResource BackgroundPrimary}">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <Grid Padding="40,20,40,0"
        RowDefinitions="Auto,*"
        RowSpacing="0">
        <!--  Playlist Header  -->
        <Grid Grid.Row="0"
            RowDefinitions="Auto,Auto"
            RowSpacing="0">

            <!--  Expanded Header  -->
            <Grid Grid.Row="0"
                IsVisible="{Binding IsHeaderCollapsed, Converter={StaticResource InvertedBoolConverter}}"
                ColumnDefinitions="200,*,Auto"
                    ColumnSpacing="30">

                    <!--  Playlist Cover - Loading State  -->
                    <Border Grid.Column="0"
                        HeightRequest="200"
                        IsVisible="{Binding IsLoadingMetadata}"
                        StrokeThickness="0"
                        WidthRequest="200">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <controls:SkeletonLoader CornerRadius="8" HeightRequest="200" WidthRequest="200" />
                    </Border>

                    <!--  Playlist Cover - Actual  -->
                    <Border Grid.Column="0"
                        BackgroundColor="{DynamicResource BackgroundTertiary}"
                        HeightRequest="200"
                        IsVisible="{Binding IsLoadingMetadata, Converter={StaticResource InvertedBoolConverter}}"
                        StrokeThickness="0"
                        WidthRequest="200">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid>
                            <ffimageloading:CachedImage Aspect="AspectFill"
                                HeightRequest="200"
                                HorizontalOptions="Center"
                                IsVisible="{Binding ImageUri, Converter={StaticResource StringNullOrWhiteSpaceToBoolConverter}, ConverterParameter=invert}"
                                Source="{Binding ImageUri}"
                                VerticalOptions="Center"
                                WidthRequest="200" />
                            <Image Aspect="AspectFill"
                                HeightRequest="200"
                                HorizontalOptions="Center"
                                IsVisible="{Binding ImageUri, Converter={StaticResource StringNullOrWhiteSpaceToBoolConverter}}"
                                Source="{AppThemeBinding Light=placeholders/playlist_light.png, Dark=placeholders/playlist_dark.png}"
                                VerticalOptions="Center"
                                WidthRequest="200" />
                        </Grid>
                    </Border>

                    <!--  Playlist Info - Loading State  -->
                    <Grid Grid.Column="1"
                        HeightRequest="200"
                        IsVisible="{Binding IsLoadingMetadata}"
                        RowDefinitions="*,Auto,Auto,Auto,40"
                        VerticalOptions="Fill">
                        <controls:SkeletonLoader Grid.Row="1"
                            HeightRequest="12"
                            HorizontalOptions="Start"
                            Margin="0,0,0,16"
                            WidthRequest="120" />
                        <controls:SkeletonLoader Grid.Row="2"
                            HeightRequest="32"
                            HorizontalOptions="Start"
                            Margin="0,0,0,8"
                            WidthRequest="320" />
                        <controls:SkeletonLoader Grid.Row="3"
                            HeightRequest="14"
                            HorizontalOptions="Start"
                            Margin="0,0,0,16"
                            WidthRequest="170" />
                    </Grid>

                    <!--  Playlist Info - Actual  -->
                    <Grid Grid.Column="1"
                        HeightRequest="200"
                        IsVisible="{Binding IsLoadingMetadata, Converter={StaticResource InvertedBoolConverter}}"
                        RowDefinitions="*,Auto,Auto,Auto,Auto"
                        VerticalOptions="Fill">
                        <Label Grid.Row="1"
                            Margin="0,0,0,16"
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="WIEDERGABELISTE"
                            TextColor="{DynamicResource TextSecondary}" />

                        <Label Grid.Row="2"
                            Margin="0,0,0,8"
                            FontAttributes="Bold"
                            FontSize="32"
                            LineBreakMode="WordWrap"
                            MaxLines="2"
                            Text="{Binding PlaylistName}"
                            TextColor="{DynamicResource TextPrimary}" />

                        <HorizontalStackLayout Grid.Row="3"
                            Margin="0,0,0,16"
                            Spacing="8">
                            <Label Style="{StaticResource LabelSecondary}"
                                Text="{Binding Tracks.Count, StringFormat='{0} Titel'}" />
                            <Label Style="{StaticResource LabelSecondary}"
                                Text="•" />
                            <Label Style="{StaticResource LabelSecondary}"
                                Text="{Binding PlaylistTotalDurationText}" />
                        </HorizontalStackLayout>

                        <Grid Grid.Row="4"
                            ColumnDefinitions="Auto,Auto,Auto,Auto"
                            ColumnSpacing="12">
                            <Border Grid.Column="0"
                                behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource ActionButtonsHoverBackground}"
                                Style="{StaticResource ActionButtonBorder}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding PlayPlaylistCommand}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout HorizontalOptions="Center"
                                    Spacing="8"
                                    VerticalOptions="Center">
                                    <Label Style="{StaticResource ActionButtonIconLabel}"
                                        Text="{mi:FluentFilled Icon=Play16Filled,
                                                               FontOverride=True}" />
                                    <Label Style="{StaticResource ActionButtonTextLabel}"
                                        Text="Abspielen" />
                                </HorizontalStackLayout>
                            </Border>

                            <Border Grid.Column="1"
                                behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource ActionButtonsHoverBackground}"
                                Style="{StaticResource ActionButtonBorder}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShufflePlaylistCommand}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout HorizontalOptions="Center"
                                    Spacing="8"
                                    VerticalOptions="Center">
                                    <Label Style="{StaticResource ActionButtonIconLabel}"
                                        Text="{mi:FluentFilled Icon=ArrowShuffle16Filled,
                                                         FontOverride=True}" />
                                    <Label Style="{StaticResource ActionButtonTextLabel}"
                                        Text="Zufällig" />
                                </HorizontalStackLayout>
                            </Border>

                            <Label Grid.Column="2"
                                Margin="12,0,0,0"
                                behaviors:HoverBehavior.BaseTextColor="{DynamicResource IconSecondary}"
                                behaviors:HoverBehavior.EnableScaleHover="True"
                                behaviors:HoverBehavior.HoverTextColor="{DynamicResource IconPrimary}"
                                FontSize="18"
                                HorizontalOptions="Center"
                                IsVisible="{Binding IsPlaylistFavorite, Converter={StaticResource InvertedBoolConverter}}"
                                Text="{mi:Fluent Icon=Heart48,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TogglePlaylistFavoriteCommand}" />
                                </Label.GestureRecognizers>
                            </Label>

                            <Label Grid.Column="2"
                                Margin="12,0,0,0"
                                behaviors:HoverBehavior.BaseTextColor="{DynamicResource IconSecondary}"
                                behaviors:HoverBehavior.EnableScaleHover="True"
                                behaviors:HoverBehavior.HoverTextColor="{DynamicResource IconPrimary}"
                                FontSize="18"
                                HorizontalOptions="Center"
                                IsVisible="{Binding IsPlaylistFavorite}"
                                Text="{mi:FluentFilled Icon=Heart48Filled,
                                                       FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TogglePlaylistFavoriteCommand}" />
                                </Label.GestureRecognizers>
                            </Label>

                            <Label x:Name="ExpandedMoreIconLabel"
                                Grid.Column="3"
                                Margin="12,0,0,0"
                                behaviors:HoverBehavior.BaseTextColor="{DynamicResource IconSecondary}"
                                behaviors:HoverBehavior.EnableScaleHover="True"
                                behaviors:HoverBehavior.HoverTextColor="{DynamicResource IconPrimary}"
                                FontSize="18"
                                HorizontalOptions="Center"
                                Text="{mi:Fluent Icon=MoreHorizontal48,
                                                 FontOverride=True}"
                                TextColor="{DynamicResource IconSecondary}"
                                VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowHeaderContextMenuAtAnchorCommand}"
                                                          CommandParameter="{x:Reference ExpandedMoreIconLabel}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </Grid>
                <Border Grid.Column="2"
                    behaviors:HoverBehavior.EnableScaleHover="True"
                    behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                    BackgroundColor="Transparent"
                    HeightRequest="24"
                    HorizontalOptions="End"
                    StrokeThickness="0"
                    VerticalOptions="End"
                    WidthRequest="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleHeaderCollapsedCommand}" />
                    </Border.GestureRecognizers>
                    <Label FontSize="12"
                        HorizontalOptions="Center"
                        Text="{mi:Fluent Icon=ChevronUp24,
                                         FontOverride=True}"
                        TextColor="{DynamicResource IconPrimary}"
                        VerticalOptions="Center" />
                </Border>
            </Grid>

            <!--  Collapsed Header  -->
            <Grid Grid.Row="1"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="12"
                IsVisible="{Binding IsHeaderCollapsed}"
                MinimumHeightRequest="40"
                Padding="0">
                <HorizontalStackLayout Grid.Column="0"
                    Spacing="12"
                    HorizontalOptions="Start"
                    VerticalOptions="Center">

                    <Border BackgroundColor="{DynamicResource BackgroundTertiary}"
                        HeightRequest="48"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="48">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="4" />
                        </Border.StrokeShape>
                        <Grid>
                            <ffimageloading:CachedImage Aspect="AspectFill"
                                HeightRequest="48"
                                HorizontalOptions="Center"
                                IsVisible="{Binding ImageUri, Converter={StaticResource StringNullOrWhiteSpaceToBoolConverter}, ConverterParameter=invert}"
                                Source="{Binding ImageUri}"
                                VerticalOptions="Center"
                                WidthRequest="48" />
                            <Image Aspect="AspectFill"
                                HeightRequest="48"
                                HorizontalOptions="Center"
                                IsVisible="{Binding ImageUri, Converter={StaticResource StringNullOrWhiteSpaceToBoolConverter}}"
                                Source="{AppThemeBinding Light=placeholders/playlist_light.png, Dark=placeholders/playlist_dark.png}"
                                VerticalOptions="Center"
                                WidthRequest="48" />
                        </Grid>
                    </Border>

                    <Label FontAttributes="Bold"
                        FontSize="20"
                        LineBreakMode="TailTruncation"
                        MaxLines="1"
                        Text="{Binding PlaylistName}"
                        TextColor="{DynamicResource TextPrimary}"
                        VerticalOptions="Center" />

                    <HorizontalStackLayout Spacing="8"
                        VerticalOptions="Center">
                        <Label Style="{StaticResource LabelSecondary}"
                            VerticalOptions="Center"
                            Text="•" />
                        <Label Style="{StaticResource LabelSecondary}"
                            VerticalOptions="Center"
                            Text="{Binding Tracks.Count, StringFormat='{0} Titel'}" />
                        <Label Style="{StaticResource LabelSecondary}"
                            VerticalOptions="Center"
                            Text="•" />
                        <Label Style="{StaticResource LabelSecondary}"
                            VerticalOptions="Center"
                            Text="{Binding PlaylistTotalDurationText}" />
                    </HorizontalStackLayout>

                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto"
                        ColumnSpacing="12"
                        VerticalOptions="Center">
                        <Border Grid.Column="0"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource ActionButtonsHoverBackground}"
                            Style="{StaticResource ActionButtonBorder}"
                            VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PlayPlaylistCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout HorizontalOptions="Center"
                                Spacing="8"
                                VerticalOptions="Center">
                                <Label Style="{StaticResource ActionButtonIconLabel}"
                                    Text="{mi:FluentFilled Icon=Play16Filled,
                                                           FontOverride=True}" />
                                <Label Style="{StaticResource ActionButtonTextLabel}"
                                    FontAttributes="None"
                                    FontSize="12"
                                    Text="Abspielen" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border Grid.Column="1"
                            behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource ActionButtonsHoverBackground}"
                            Style="{StaticResource ActionButtonBorder}"
                            VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShufflePlaylistCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout HorizontalOptions="Center"
                                Spacing="8"
                                VerticalOptions="Center">
                                <Label Style="{StaticResource ActionButtonIconLabel}"
                                    Text="{mi:FluentFilled Icon=ArrowShuffle16Filled,
                                                     FontOverride=True}" />
                                <Label Style="{StaticResource ActionButtonTextLabel}"
                                    FontAttributes="None"
                                    FontSize="12"
                                    Text="Zufällig" />
                            </HorizontalStackLayout>
                        </Border>

                        <Label Grid.Column="2"
                            Margin="12,0,0,0"
                            behaviors:HoverBehavior.BaseTextColor="{DynamicResource IconSecondary}"
                            behaviors:HoverBehavior.EnableScaleHover="True"
                            behaviors:HoverBehavior.HoverTextColor="{DynamicResource IconPrimary}"
                            FontSize="18"
                            HorizontalOptions="Center"
                            IsVisible="{Binding IsPlaylistFavorite, Converter={StaticResource InvertedBoolConverter}}"
                            Text="{mi:Fluent Icon=Heart48,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconSecondary}"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding TogglePlaylistFavoriteCommand}" />
                            </Label.GestureRecognizers>
                        </Label>

                        <Label Grid.Column="2"
                            Margin="12,0,0,0"
                            behaviors:HoverBehavior.BaseTextColor="{DynamicResource IconSecondary}"
                            behaviors:HoverBehavior.EnableScaleHover="True"
                            behaviors:HoverBehavior.HoverTextColor="{DynamicResource IconPrimary}"
                            FontSize="18"
                            HorizontalOptions="Center"
                            IsVisible="{Binding IsPlaylistFavorite}"
                            Text="{mi:FluentFilled Icon=Heart48Filled,
                                                   FontOverride=True}"
                            TextColor="{DynamicResource IconSecondary}"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding TogglePlaylistFavoriteCommand}" />
                            </Label.GestureRecognizers>
                        </Label>

                        <Label x:Name="CollapsedMoreIconLabel"
                            Grid.Column="3"
                            Margin="6,0,0,0"
                            behaviors:HoverBehavior.BaseTextColor="{DynamicResource IconSecondary}"
                            behaviors:HoverBehavior.EnableScaleHover="True"
                            behaviors:HoverBehavior.HoverTextColor="{DynamicResource IconPrimary}"
                            FontSize="18"
                            HorizontalOptions="Center"
                            Text="{mi:Fluent Icon=MoreHorizontal48,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconSecondary}"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowHeaderContextMenuAtAnchorCommand}"
                                                      CommandParameter="{x:Reference CollapsedMoreIconLabel}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </HorizontalStackLayout>

                <Border Grid.Column="1"
                    behaviors:HoverBehavior.EnableScaleHover="True"
                    behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                    BackgroundColor="Transparent"
                    HeightRequest="24"
                    HorizontalOptions="End"
                    StrokeThickness="0"
                    VerticalOptions="End"
                    WidthRequest="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleHeaderCollapsedCommand}" />
                    </Border.GestureRecognizers>
                    <Label FontSize="12"
                        HorizontalOptions="Center"
                        Text="{mi:Fluent Icon=ChevronDown24,
                                         FontOverride=True}"
                        TextColor="{DynamicResource IconPrimary}"
                        VerticalOptions="Center" />
                </Border>
            </Grid>
        </Grid>

        <!--  Playlist Tracks  -->
        <Grid Grid.Row="1" Margin="0,24,0,0">
            <Grid>
                <controls:TableView Margin="0,0,0,0"
                    IsVisible="{Binding ShowTrackTable}"
                    ItemsSource="{Binding TrackItems}"
                    UserDataService="{Binding UserDataService}"
                    PageSize="500"
                    PlaybackContextItem="{Binding Playlist}"
                    PrimaryInfoTappedCommand="{Binding AlbumTappedCommand}"
                    SecondaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    ShowContextMenuAtAnchorCommand="{Binding ShowContentContextMenuAtAnchorCommand}"
                    ShowContextMenuAtPositionCommand="{Binding ShowContentContextMenuAtPositionCommand}" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="mashin.Views.Desktop.Controls.DeletePlaylistOverlay"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:mashin.Views.Desktop.Behaviors"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons">

    <Border BackgroundColor="{DynamicResource BackgroundSecondary}"
        Padding="24,20"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        WidthRequest="400">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>

        <VerticalStackLayout Spacing="16">
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <Label FontAttributes="Bold"
                    FontSize="18"
                    Text="Wiedergabeliste loeschen"
                    TextColor="{DynamicResource TextPrimary}" />
                <Border Grid.Column="1"
                    behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                    BackgroundColor="Transparent"
                    HeightRequest="28"
                    StrokeThickness="0"
                    WidthRequest="28">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCancelTapped" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Label FontSize="12"
                        HorizontalOptions="Center"
                        Text="{mi:Fluent Icon=Dismiss24,
                                         FontOverride=True}"
                        TextColor="{DynamicResource IconSecondary}"
                        VerticalOptions="Center" />
                </Border>
            </Grid>

            <Label x:Name="PlaylistNameLabel"
                FontSize="14"
                HorizontalOptions="Center"
                TextColor="{DynamicResource TextPrimary}" />
            <Label FontSize="13"
                HorizontalOptions="Center"
                Text="Moechtest du diese Wiedergabeliste wirklich loeschen?"
                TextColor="{DynamicResource TextSecondary}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border HorizontalOptions="Center"
                    WidthRequest="150"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    behaviors:HoverBehavior.BaseBackgroundColor="Transparent"
                    behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <Button Text="Abbrechen"
                        BackgroundColor="Transparent"
                        Clicked="OnCancelClicked"
                        TextColor="{DynamicResource TextSecondary}" />
                </Border>
                <Border Grid.Column="1"
                    HorizontalOptions="Center"
                    WidthRequest="150"
                    BackgroundColor="{DynamicResource AccentColor}"
                    StrokeThickness="0"
                    IsEnabled="{Binding Source={x:Reference DeletePlaylistButton}, Path=IsEnabled}"
                    behaviors:HoverBehavior.BaseBackgroundColor="{DynamicResource AccentColor}"
                    behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource AccentHover}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <Button x:Name="DeletePlaylistButton"
                        Text="Loeschen"
                        BackgroundColor="Transparent"
                        Clicked="OnDeleteClicked"
                        IsEnabled="True"
                        TextColor="White" />
                </Border>
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>

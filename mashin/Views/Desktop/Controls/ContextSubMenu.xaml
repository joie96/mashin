<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="mashin.Views.Desktop.Controls.ContextSubMenu"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:mashin.Converters"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:models="clr-namespace:mashin.Models"
    x:Name="self"
    BackgroundColor="Transparent">

    <ContentView.Resources>
        <ResourceDictionary>
            <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <Border
        Padding="4"
        BackgroundColor="{DynamicResource BackgroundSecondary}"
        MaximumWidthRequest="300"
        MinimumWidthRequest="180"
        Stroke="{DynamicResource SeparatorColor}"
        StrokeThickness="1">
        <Border.GestureRecognizers>
            <PointerGestureRecognizer PointerEntered="OnSubMenuPointerEntered" PointerExited="OnSubMenuPointerExited" />
        </Border.GestureRecognizers>
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="8" />
        </Border.StrokeShape>

        <Border.Shadow>
            <Shadow
                Brush="Black"
                Opacity="0.3"
                Radius="16"
                Offset="4,4" />
        </Border.Shadow>

        <ScrollView MaximumHeightRequest="400" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding MenuItems, Source={x:Reference self}}" Spacing="0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:ContextMenuItem">
                        <Border
                            Padding="12,10"
                            BackgroundColor="Transparent"
                            Opacity="{Binding IsEnabled, Converter={StaticResource BoolToOpacityConverter}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="4" />
                            </Border.StrokeShape>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSubMenuItemTapped" />
                                <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                                <!--  Icon  -->
                                <Label
                                    Grid.Column="0"
                                    FontSize="16"
                                    IsVisible="{Binding HasIcon}"
                                    mi:MauiIcon.Value="{mi:Fluent Icon={Binding Icon},
                                                                  FontOverride=True,
                                                                  IconSize=16,
                                                                  IconColor={DynamicResource IconSecondary}}"
                                    TextColor="{DynamicResource IconSecondary}"
                                    VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger Binding="{Binding IconIsFilled}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label
                                    Grid.Column="0"
                                    FontSize="16"
                                    IsVisible="False"
                                    mi:MauiIcon.Value="{mi:FluentFilled Icon={Binding Icon},
                                                                  FontOverride=True,
                                                                  IconSize=16,
                                                                  IconColor={DynamicResource IconSecondary}}"
                                    TextColor="{DynamicResource IconSecondary}"
                                    VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger Binding="{Binding IconIsFilled}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="IsVisible" Value="True" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasIcon}"
                                            TargetType="Label"
                                            Value="False">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <!--  Text  -->
                                <Label
                                    Grid.Column="1"
                                    FontSize="13"
                                    Text="{Binding Text}"
                                    TextColor="{DynamicResource TextSecondary}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>
    </Border>
</ContentView>
<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="mashin.Views.Desktop.Controls.ContextMenu"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:mashin.Converters"
    xmlns:local="clr-namespace:mashin.Views.Desktop.Controls"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:models="clr-namespace:mashin.Models"
    x:Name="self"
    BackgroundColor="Transparent">

    <ContentView.Resources>
        <ResourceDictionary>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <Border
        Padding="4"
        BackgroundColor="{DynamicResource BackgroundSecondary}"
        MaximumWidthRequest="320"
        MinimumWidthRequest="220"
        Stroke="{DynamicResource SeparatorColor}"
        StrokeThickness="1">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="8" />
        </Border.StrokeShape>

        <Border.Shadow>
            <Shadow
                Brush="Black"
                Opacity="0.4"
                Radius="24"
                Offset="0,8" />
        </Border.Shadow>

        <ScrollView MaximumHeightRequest="500" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding MenuItems, Source={x:Reference self}}" Spacing="0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:ContextMenuItem">
                        <Grid>
                            <!--  Separator  -->
                            <BoxView
                                Margin="8,4"
                                BackgroundColor="{DynamicResource SeparatorColor}"
                                HeightRequest="1"
                                IsVisible="{Binding IsSeparator}" />

                            <!--  Menu Item  -->
                            <Border
                                x:Name="MenuItemBorder"
                                Padding="12,10"
                                BackgroundColor="Transparent"
                                IsVisible="{Binding IsSeparator, Converter={StaticResource InvertedBoolConverter}}"
                                Opacity="{Binding IsEnabled, Converter={StaticResource BoolToOpacityConverter}}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="4" />
                                </Border.StrokeShape>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnMenuItemTapped" />
                                    <PointerGestureRecognizer
                                        PointerEntered="OnPointerEntered"
                                        PointerExited="OnPointerExited"
                                        PointerMoved="OnPointerMoved" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="12">
                                    <!--  Icon  -->
                                    <Label
                                        Grid.Column="0"
                                        FontSize="18"
                                        IsVisible="{Binding HasIcon}"
                                        Text="{mi:Fluent Icon={Binding Icon},
                                                         FontOverride=True,
                                                         IconSize=18,
                                                         IconColor={DynamicResource IconSecondary}}"
                                        TextColor="{DynamicResource IconSecondary}"
                                        VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger Binding="{Binding IconIsFilled}"
                                                TargetType="Label"
                                                Value="True">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label
                                        Grid.Column="0"
                                        FontSize="18"
                                        IsVisible="False"
                                        Text="{mi:FluentFilled Icon={Binding Icon},
                                                               FontOverride=True,
                                                               IconSize=18,
                                                               IconColor={DynamicResource IconSecondary}}"
                                        TextColor="{DynamicResource IconSecondary}"
                                        VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger Binding="{Binding IconIsFilled}"
                                                TargetType="Label"
                                                Value="True">
                                                <Setter Property="IsVisible" Value="True" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasIcon}"
                                                TargetType="Label"
                                                Value="False">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <!--  Text  -->
                                    <Label
                                        Grid.Column="1"
                                        FontSize="14"
                                        Text="{Binding Text}"
                                        TextColor="{DynamicResource TextSecondary}"
                                        VerticalOptions="Center" />

                                    <!--  Keyboard Shortcut  -->
                                    <Label
                                        Grid.Column="2"
                                        Margin="16,0,0,0"
                                        FontSize="11"
                                        IsVisible="{Binding HasKeyboardShortcut}"
                                        Text="{Binding KeyboardShortcut}"
                                        TextColor="{DynamicResource TextTertiary}"
                                        VerticalOptions="Center" />

                                    <!--  Submenu Arrow  -->
                                    <Label
                                        Grid.Column="2"
                                        FontSize="12"
                                        IsVisible="{Binding HasSubItems}"
                                        Text="{mi:Fluent Icon=ChevronRight24,
                                                     FontOverride=True}"
                                        TextColor="{DynamicResource TextTertiary}"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>

                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>
    </Border>
</ContentView>
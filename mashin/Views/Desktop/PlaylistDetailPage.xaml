<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="mashin.Views.Desktop.PlaylistDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:mashin.Views.Desktop.Controls"
    xmlns:converters="clr-namespace:mashin.Converters"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:vm="clr-namespace:mashin.ViewModels"
    x:DataType="vm:PlaylistDetailViewModel"
    BackgroundColor="{DynamicResource BackgroundPrimary}">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <Grid Padding="40,30,40,0"
        RowDefinitions="Auto,*"
        RowSpacing="0">
        <!--  Playlist Header  -->
        <Grid Grid.Row="0">
            <Grid ColumnDefinitions="200,*" ColumnSpacing="30">

                <!--  Playlist Cover - Loading State  -->
                <Border Grid.Column="0"
                    HeightRequest="200"
                    IsVisible="{Binding IsLoadingMetadata}"
                    StrokeThickness="0"
                    WidthRequest="200">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <controls:SkeletonLoader CornerRadius="8" HeightRequest="200" WidthRequest="200" />
                </Border>

                <!--  Playlist Cover - Actual  -->
                <Border Grid.Column="0"
                    BackgroundColor="{DynamicResource BackgroundTertiary}"
                    HeightRequest="200"
                    IsVisible="{Binding IsLoadingMetadata, Converter={StaticResource InvertedBoolConverter}}"
                    StrokeThickness="0"
                    WidthRequest="200">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Grid>
                        <Grid.GestureRecognizers>
                            <PointerGestureRecognizer Buttons="Secondary" PointerPressed="OnPlaylistCoverSecondaryPointerPressed" />
                        </Grid.GestureRecognizers>
                        <Image Aspect="AspectFill"
                            HeightRequest="200"
                            HorizontalOptions="Center"
                            Source="{Binding ImageUrl}"
                            VerticalOptions="Center"
                            WidthRequest="200" />
                    </Grid>
                </Border>

                <!--  Playlist Info - Loading State  -->
                <VerticalStackLayout Grid.Column="1"
                    IsVisible="{Binding IsLoadingMetadata}"
                    Spacing="12"
                    VerticalOptions="Center">
                    <controls:SkeletonLoader HeightRequest="12" HorizontalOptions="Start" WidthRequest="120" />
                    <controls:SkeletonLoader HeightRequest="28" HorizontalOptions="Start" WidthRequest="280" />
                    <controls:SkeletonLoader HeightRequest="14" HorizontalOptions="Start" WidthRequest="150" />
                </VerticalStackLayout>

                <!--  Playlist Info - Actual  -->
                <Grid Grid.Column="1"
                    HeightRequest="200"
                    IsVisible="{Binding IsLoadingMetadata, Converter={StaticResource InvertedBoolConverter}}"
                    RowDefinitions="*,Auto,Auto,Auto,Auto"
                    VerticalOptions="Fill">

                    <!--  Type Label  -->
                    <Label Grid.Row="1"
                        Margin="0,0,0,16"
                        FontAttributes="Bold"
                        FontSize="12"
                        Text="WIEDERGABELISTE"
                        TextColor="{DynamicResource TextSecondary}" />

                    <!--  Playlist Name  -->
                    <Label Grid.Row="2"
                        Margin="0,0,0,8"
                        FontAttributes="Bold"
                        FontSize="28"
                        LineBreakMode="WordWrap"
                        MaxLines="2"
                        Text="{Binding PlaylistName}"
                        TextColor="{DynamicResource TextPrimary}" />

                    <!--  Track Count  -->
                    <HorizontalStackLayout Grid.Row="3"
                        Margin="0,0,0,16"
                        Spacing="8">
                        <Label FontSize="14"
                            Text="{Binding Tracks.Count, StringFormat='{0} Titel'}"
                            TextColor="{DynamicResource TextSecondary}" />
                        <Label FontSize="14"
                            Text="•"
                            TextColor="{DynamicResource TextSecondary}" />
                        <Label FontSize="14"
                            Text="{Binding PlaylistTotalDurationText}"
                            TextColor="{DynamicResource TextSecondary}" />
                    </HorizontalStackLayout>

                    <!--  Buttons  -->
                    <Grid Grid.Row="4"
                        ColumnDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="12">
                        <Border Grid.Column="0"
                            Padding="20,8"
                            BackgroundColor="{DynamicResource TextPrimary}"
                            StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <HorizontalStackLayout HorizontalOptions="Center"
                                Spacing="8"
                                VerticalOptions="Center">
                                <Label FontSize="14"
                                    Text="{mi:FluentFilled Icon=Play16Filled,
                                                           FontOverride=True}"
                                    TextColor="{DynamicResource BackgroundPrimary}"
                                    VerticalTextAlignment="Center" />
                                <Label FontAttributes="Bold"
                                    FontSize="14"
                                    Text="Abspielen"
                                    TextColor="{DynamicResource BackgroundPrimary}"
                                    VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border Grid.Column="1"
                            Padding="20,8"
                            BackgroundColor="{DynamicResource TextPrimary}"
                            StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <HorizontalStackLayout HorizontalOptions="Center"
                                Spacing="8"
                                VerticalOptions="Center">
                                <Label FontSize="14"
                                    Text="{mi:Fluent Icon=ArrowShuffle16,
                                                     FontOverride=True}"
                                    TextColor="{DynamicResource BackgroundPrimary}"
                                    VerticalTextAlignment="Center" />
                                <Label FontAttributes="Bold"
                                    FontSize="14"
                                    Text="Zufällig"
                                    TextColor="{DynamicResource BackgroundPrimary}"
                                    VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border Grid.Column="2"
                            Padding="20,8"
                            BackgroundColor="{DynamicResource TextPrimary}"
                            StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <HorizontalStackLayout HorizontalOptions="Center"
                                Spacing="8"
                                VerticalOptions="Center">
                                <Label FontSize="14"
                                    Text="{mi:Fluent Icon=MoreHorizontal16,
                                                     FontOverride=True}"
                                    TextColor="{DynamicResource BackgroundPrimary}"
                                    VerticalTextAlignment="Center" />
                                <Label FontAttributes="Bold"
                                    FontSize="14"
                                    Text="Mehr"
                                    TextColor="{DynamicResource BackgroundPrimary}"
                                    VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!--  Playlist Tracks  -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid>
                <controls:TableView Margin="0,40,0,0"
                    IsVisible="{Binding ShowTrackTable}"
                    ItemsSource="{Binding TrackItems}"
                    MediaActions="{Binding MediaActions}"
                    PageSize="500"
                    PlaybackContextItem="{Binding Playlist}"
                    PrimaryInfoTappedCommand="{Binding AlbumTappedCommand}"
                    SecondaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    ShowContextMenuAtAnchorCommand="{Binding ShowContentContextMenuAtAnchorCommand}"
                    ShowContextMenuAtPositionCommand="{Binding ShowContentContextMenuAtPositionCommand}" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>

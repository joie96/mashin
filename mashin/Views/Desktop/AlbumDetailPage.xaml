<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="mashin.Views.Desktop.AlbumDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:mashin.Views.Desktop.Behaviors"
    xmlns:controls="clr-namespace:mashin.Views.Desktop.Controls"
    xmlns:converters="clr-namespace:mashin.Converters"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:vm="clr-namespace:mashin.ViewModels"
    x:DataType="vm:AlbumDetailViewModel"
    BackgroundColor="{DynamicResource BackgroundPrimary}">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        <converters:RemoveBlankLinesConverter x:Key="RemoveBlankLinesConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <Grid Padding="40,30,40,30"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
            RowSpacing="0">

            <!--  Album Header  -->
            <Grid Grid.Row="0"
                ColumnDefinitions="150,*"
                ColumnSpacing="30">

                <!--  Album Cover - Loading State  -->
                <Border Grid.Column="0"
                    HeightRequest="150"
                    IsVisible="{Binding IsLoadingMetadata}"
                    StrokeThickness="0"
                    WidthRequest="150">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <controls:SkeletonLoader WidthRequest="150" HeightRequest="150" CornerRadius="8" />
                </Border>

                <!--  Album Cover - Actual  -->
                <Border Grid.Column="0"
                    BackgroundColor="{DynamicResource BackgroundTertiary}"
                    HeightRequest="150"
                    IsVisible="{Binding IsLoadingMetadata, Converter={StaticResource InvertedBoolConverter}}"
                    StrokeThickness="0"
                    WidthRequest="150">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Image Aspect="AspectFill"
                        HeightRequest="150"
                        HorizontalOptions="Center"
                        Source="{Binding ImageUrl}"
                        VerticalOptions="Center"
                        WidthRequest="150" />
                </Border>

                <!--  Album Info - Loading State  -->
                <VerticalStackLayout Grid.Column="1"
                    IsVisible="{Binding IsLoadingMetadata}"
                    Spacing="12"
                    VerticalOptions="Center">
                    <controls:SkeletonLoader WidthRequest="120" HeightRequest="12" HorizontalOptions="Start" />
                    <controls:SkeletonLoader WidthRequest="300" HeightRequest="32" HorizontalOptions="Start" />
                    <controls:SkeletonLoader WidthRequest="220" HeightRequest="14" HorizontalOptions="Start" />
                </VerticalStackLayout>

                <!--  Album Info - Actual  -->
                <VerticalStackLayout Grid.Column="1"
                    IsVisible="{Binding IsLoadingMetadata, Converter={StaticResource InvertedBoolConverter}}"
                    Spacing="12"
                    VerticalOptions="Center">

                    <Label Margin="0,0,0,8"
                        FontAttributes="Bold"
                        FontSize="12"
                        Text="ALBUM"
                        TextColor="{DynamicResource TextSecondary}" />

                    <HorizontalStackLayout Spacing="16" VerticalOptions="Center">
                        <Label FontAttributes="Bold"
                            FontSize="32"
                            LineBreakMode="WordWrap"
                            MaxLines="2"
                            Text="{Binding AlbumName}"
                            TextColor="{DynamicResource TextPrimary}" />
                        <ffimageloading:SvgCachedImage HeightRequest="28"
                            Source="{Binding Album.ProviderManifest.IconSvg}"
                            ToolTipProperties.Text="{Binding Album.ProviderName}"
                            VerticalOptions="Center"
                            WidthRequest="28">
                            <ffimageloading:SvgCachedImage.Triggers>
                                <DataTrigger Binding="{Binding Album.ProviderManifest.IconSvg}"
                                    TargetType="ffimageloading:SvgCachedImage"
                                    Value="{x:Null}">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </ffimageloading:SvgCachedImage.Triggers>
                        </ffimageloading:SvgCachedImage>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="8">
                        <Label FontSize="14"
                            Text="{Binding ArtistName}"
                            TextColor="{DynamicResource TextSecondary}" />
                        <Label FontSize="14"
                            Text="•"
                            TextColor="{DynamicResource TextSecondary}" />
                        <Label FontSize="14"
                            Text="{Binding AlbumYearText}"
                            TextColor="{DynamicResource TextSecondary}" />
                        <Label FontSize="14"
                            Text="•"
                            TextColor="{DynamicResource TextSecondary}" />
                        <Label FontSize="14"
                            Text="{Binding Tracks.Count, StringFormat='{0} Titel'}"
                            TextColor="{DynamicResource TextSecondary}" />
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Grid>

            <!--  Description - Loading State  -->
            <Grid Grid.Row="1"
                Margin="0,36,0,0"
                IsVisible="{Binding IsLoadingMetadata}"
                RowDefinitions="Auto,Auto,Auto,Auto"
                RowSpacing="16">
                <controls:SkeletonLoader Grid.Row="0" WidthRequest="200" HeightRequest="18" HorizontalOptions="Start" />
                <controls:SkeletonLoader Grid.Row="1" HeightRequest="14" HorizontalOptions="Fill" />
                <controls:SkeletonLoader Grid.Row="2" HeightRequest="14" HorizontalOptions="Fill" />
                <controls:SkeletonLoader Grid.Row="3" HeightRequest="14" HorizontalOptions="Fill" />
            </Grid>

            <!--  Description - Actual  -->
            <Grid Grid.Row="2"
                Margin="0,36,0,0"
                IsVisible="{Binding HasDescription}"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="16">
                <Grid.Triggers>
                    <DataTrigger Binding="{Binding IsLoadingMetadata}"
                        TargetType="Grid"
                        Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Grid.Triggers>
                <Label Grid.Row="0"
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="{Binding AlbumName, StringFormat='Über {0}'}"
                    TextColor="{DynamicResource TextPrimary}" />
                <Label Grid.Row="1"
                    FontSize="14"
                    LineBreakMode="WordWrap"
                    MaxLines="{Binding DescriptionMaxLines}"
                    Text="{Binding AlbumDescription, Converter={StaticResource RemoveBlankLinesConverter}}"
                    TextColor="{DynamicResource TextSecondary}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleDescriptionCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Border Grid.Row="2"
                    Margin="0,-8,0,0"
                    behaviors:HoverBehavior.EnableScaleHover="True"
                    behaviors:HoverBehavior.HoverBackgroundColor="{DynamicResource HoverBackground}"
                    BackgroundColor="Transparent"
                    HeightRequest="24"
                    HorizontalOptions="Center"
                    StrokeThickness="0"
                    WidthRequest="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleDescriptionCommand}" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Label FontSize="12"
                            HorizontalOptions="Center"
                            IsVisible="{Binding IsDescriptionExpanded, Converter={StaticResource InvertedBoolConverter}}"
                            Text="{mi:Fluent Icon=ChevronDown24,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconPrimary}"
                            VerticalOptions="Center" />
                        <Label FontSize="12"
                            HorizontalOptions="Center"
                            IsVisible="{Binding IsDescriptionExpanded}"
                            Text="{mi:Fluent Icon=ChevronUp24,
                                             FontOverride=True}"
                            TextColor="{DynamicResource IconPrimary}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>
            </Grid>

            <!--  Tracks Section  -->
            <Grid Grid.Row="3"
                Margin="0,36,0,0"
                RowDefinitions="Auto,*"
                RowSpacing="16">
                <Label Grid.Row="0"
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Titel"
                    TextColor="{DynamicResource TextPrimary}" />

                <controls:TableView Grid.Row="1" ContextMenuItems="{Binding ContextMenuItems}"
                    ItemsSource="{Binding TrackItems}"
                    MediaActions="{Binding MediaActions}"
                    PrimaryInfoTappedCommand="{Binding AlbumTappedCommand}"
                    SecondaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    ShowContextMenuAtAnchorCommand="{Binding ShowContextMenuAtAnchorCommand}"
                    ShowContextMenuAtPositionCommand="{Binding ShowContextMenuAtPositionCommand}" />
            </Grid>

            <!--  Other Albums Section  -->
            <Grid Grid.Row="4"
                Margin="0,36,0,0"
                RowDefinitions="Auto,*"
                RowSpacing="16">
                <Label Grid.Row="0"
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="{Binding ArtistName, StringFormat='Weitere Alben von {0}'}"
                    TextColor="{DynamicResource TextPrimary}" />

                <!--  Other Albums  -->
                <controls:RowView Grid.Row="1"
                    ItemCornerRadius="8"
                    ItemsSource="{Binding OtherAlbumItems}"
                    MediaActions="{Binding MediaActions}"
                    PrimaryInfoTappedCommand="{Binding AlbumTappedCommand}"
                    SecondaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    ShowContextMenuAtAnchorCommand="{Binding ShowContextMenuAtAnchorCommand}"
                    ShowContextMenuAtPositionCommand="{Binding ShowContextMenuAtPositionCommand}" />
            </Grid>

            <!--  Similar Artists Section  -->
            <Grid Grid.Row="5"
                Margin="0,36,0,0"
                RowDefinitions="Auto,*"
                RowSpacing="16">
                <Label Grid.Row="0"
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Ähnliche Interpreten"
                    TextColor="{DynamicResource TextPrimary}" />

                <!--  Similar Artists  -->
                <controls:RowView Grid.Row="1"
                    ItemCornerRadius="100"
                    ItemsSource="{Binding SimilarArtistItems}"
                    MediaActions="{Binding MediaActions}"
                    PrimaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    SecondaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    ShowContextMenuAtAnchorCommand="{Binding ShowContextMenuAtAnchorCommand}"
                    ShowContextMenuAtPositionCommand="{Binding ShowContextMenuAtPositionCommand}" />
            </Grid>

        </Grid>
    </ScrollView>
</ContentPage>

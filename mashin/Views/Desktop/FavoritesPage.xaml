<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="mashin.Views.Desktop.FavoritesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:mashin.Views.Desktop.Behaviors"
    xmlns:controls="clr-namespace:mashin.Views.Desktop.Controls"
    xmlns:converters="clr-namespace:mashin.Converters"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:vm="clr-namespace:mashin.ViewModels"
    x:DataType="vm:FavoritesViewModel"
    BackgroundColor="{DynamicResource BackgroundPrimary}">
    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <ScrollView x:Name="scrollView">
        <Grid 
            Padding="40,30,40,30"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto"
            RowSpacing="0">

            <!--  Header  -->
            <VerticalStackLayout Grid.Row="0" Spacing="6">
                <Label FontAttributes="Bold"
                    FontSize="24"
                    Text="Favoriten"
                    TextColor="{DynamicResource TextPrimary}" />
            </VerticalStackLayout>

            <!--  Tracks  (incl. Skeletons)  -->
            <Grid Grid.Row="1"
                Margin="0,36,0,0"
                RowDefinitions="Auto,Auto,*"
                RowSpacing="0">
                <Label Grid.Row="0"
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Titel"
                    TextColor="{DynamicResource TextPrimary}" />
                <Label Grid.Row="1"
                    Margin="0,16,0,0"
                    FontSize="14"
                    IsVisible="{Binding ShowNoTracksMessage}"
                    Text="Keine favorisierten Titel."
                    TextColor="{DynamicResource TextTertiary}" />
                <controls:TableView Grid.Row="2"
                    Margin="0,16,0,0"
                    PageSize="10"
                    IsVisible="True"
                    ItemsSource="{Binding TrackItems}"
                    MediaActions="{Binding MediaActions}"
                    PrimaryInfoTappedCommand="{Binding AlbumTappedCommand}"
                    SecondaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    ShowContextMenuAtAnchorCommand="{Binding ShowTrackContextMenuAtAnchorCommand}"
                    ShowContextMenuAtPositionCommand="{Binding ShowTrackContextMenuAtPositionCommand}"
                    VerticalOptions="Fill" />
            </Grid>

            <!--  Albums  (incl. Skeletons) -->
            <Grid Grid.Row="2"
                Margin="0,36,0,0"
                RowDefinitions="Auto,Auto,*"
                RowSpacing="0">
                <Label Grid.Row="0"
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Alben"
                    TextColor="{DynamicResource TextPrimary}" />
                <Label Grid.Row="1"
                    Margin="0,16,0,0"
                    FontSize="14"
                    IsVisible="{Binding ShowNoAlbumsMessage}"
                    Text="Keine favorisierten Alben."
                    TextColor="{DynamicResource TextTertiary}" />
                <controls:RowView Grid.Row="2"
                    Margin="0,16,0,0"
                    IsVisible="True"
                    ItemCornerRadius="8"
                    ItemsSource="{Binding AlbumItems}"
                    MediaActions="{Binding MediaActions}"
                    PrimaryInfoTappedCommand="{Binding AlbumTappedCommand}"
                    SecondaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    ShowContextMenuAtAnchorCommand="{Binding ShowAlbumContextMenuAtAnchorCommand}"
                    ShowContextMenuAtPositionCommand="{Binding ShowAlbumContextMenuAtPositionCommand}" />
            </Grid>

            <!--  Playlists  (incl. Skeletons) -->
            <Grid Grid.Row="3"
                Margin="0,36,0,0"
                RowDefinitions="Auto,Auto,*"
                RowSpacing="0">
                <Label Grid.Row="0"
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Playlists"
                    TextColor="{DynamicResource TextPrimary}" />
                <Label Grid.Row="1"
                    Margin="0,16,0,0"
                    FontSize="14"
                    IsVisible="{Binding ShowNoPlaylistsMessage}"
                    Text="Keine favorisierten Playlists."
                    TextColor="{DynamicResource TextTertiary}" />
                <controls:RowView Grid.Row="2"
                    Margin="0,16,0,0"
                    IsVisible="True"
                    ItemCornerRadius="8"
                    ItemsSource="{Binding PlaylistItems}"
                    MediaActions="{Binding MediaActions}"
                    PrimaryInfoTappedCommand="{Binding PlaylistTappedCommand}"
                    ShowContextMenuAtAnchorCommand="{Binding ShowPlaylistContextMenuAtAnchorCommand}"
                    ShowContextMenuAtPositionCommand="{Binding ShowPlaylistContextMenuAtPositionCommand}" />
            </Grid>

            <!--  Artists  (incl. Skeletons) -->
            <Grid Grid.Row="4"
                Margin="0,36,0,0"
                RowDefinitions="Auto,Auto,*"
                RowSpacing="0">
                <Label Grid.Row="0"
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Artists"
                    TextColor="{DynamicResource TextPrimary}" />
                <Label Grid.Row="1"
                    Margin="0,16,0,0"
                    FontSize="14"
                    IsVisible="{Binding ShowNoArtistsMessage}"
                    Text="Keine favorisierten Artists."
                    TextColor="{DynamicResource TextTertiary}" />
                <controls:RowView Grid.Row="2"
                    Margin="0,16,0,0"
                    IsVisible="True"
                    ItemCornerRadius="100"
                    ItemsSource="{Binding ArtistItems}"
                    MediaActions="{Binding MediaActions}"
                    PrimaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    SecondaryInfoTappedCommand="{Binding ArtistTappedCommand}"
                    ShowContextMenuAtAnchorCommand="{Binding ShowArtistContextMenuAtAnchorCommand}"
                    ShowContextMenuAtPositionCommand="{Binding ShowArtistContextMenuAtPositionCommand}" />
            </Grid>

        </Grid>
    </ScrollView>
</ContentPage>

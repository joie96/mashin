<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mashin.Views.Desktop.ExplorePage"
             BackgroundColor="{DynamicResource BackgroundPrimary}">
    <ScrollView Padding="30,20">
        <VerticalStackLayout Spacing="30">
            <Label Text="Entdecken"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource TextPrimary}"/>
            <Label Text="Hier kannst du neue Musik entdecken."
                   FontSize="18"
                   TextColor="{DynamicResource TextTertiary}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
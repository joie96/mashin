<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- TOKENS -->
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeSectionTitle">18</x:Double>
    <x:Double x:Key="FontSizePageTitle">24</x:Double>

    <x:Double x:Key="Spacing4">4</x:Double>
    <x:Double x:Key="Spacing8">8</x:Double>
    <x:Double x:Key="Spacing12">12</x:Double>
    <x:Double x:Key="Spacing16">16</x:Double>
    <x:Double x:Key="Spacing24">24</x:Double>
    <x:Double x:Key="Spacing36">36</x:Double>

    <Thickness x:Key="PagePaddingDesktop">40,20,40,20</Thickness>
    <Thickness x:Key="SectionTopMargin">0,36,0,0</Thickness>

    <!-- PAGE -->
    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{DynamicResource BackgroundPrimary}" />
    </Style>


    <!-- LABEL -->
    <Style x:Key="BaseLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="PoppinsRegular" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>

    <Style TargetType="Label" BasedOn="{StaticResource BaseLabelStyle}" />

    <Style x:Key="LabelPageTitle" TargetType="Label" BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="FontFamily" Value="PoppinsSemibold" />
        <Setter Property="FontSize" Value="{StaticResource FontSizePageTitle}" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style x:Key="LabelSectionTitle" TargetType="Label" BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="FontFamily" Value="PoppinsSemibold" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSectionTitle}" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style x:Key="LabelSecondary" TargetType="Label" BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
    </Style>

    <Style x:Key="LabelTertiary" TargetType="Label" BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="TextColor" Value="{DynamicResource TextTertiary}" />
    </Style>

    <Style x:Key="ActionButtonIconLabel" TargetType="Label" BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="TextColor" Value="{DynamicResource BackgroundTertiary}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="ActionButtonTextLabel" TargetType="Label" BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="FontFamily" Value="PoppinsSemibold" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="TextColor" Value="{DynamicResource BackgroundTertiary}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>


    <!-- ENTRY -->
    <Style x:Key="BaseEntryStyle" TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="PoppinsRegular"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextTertiary}" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
    </Style>

    <Style TargetType="Entry" BasedOn="{StaticResource BaseEntryStyle}" />

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextTertiary}" />
        <Setter Property="CancelButtonColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="PoppinsRegular" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
    </Style>


    <!-- BUTTON -->
    <Style x:Key="BaseButtonStyle" TargetType="Button">
        <Setter Property="TextColor" Value="{DynamicResource BackgroundPrimary}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="PoppinsSemibold"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="20,8"/>
        <Setter Property="MinimumHeightRequest" Value="40"/>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}" />

    <!-- BORDER STYLES -->
    <Style x:Key="BaseBorderStyle" TargetType="Border">
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeShape" Value="Rectangle"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="BackgroundColor" Value="Transparent"/>
    </Style>

    <Style TargetType="Border" BasedOn="{StaticResource BaseBorderStyle}" />

    <Style x:Key="SurfaceBorder" TargetType="Border" BasedOn="{StaticResource BaseBorderStyle}">
        <Setter Property="BackgroundColor" Value="{DynamicResource BackgroundTertiary}" />
    </Style>

    <Style x:Key="ActionButtonBorder" TargetType="Border" BasedOn="{StaticResource BaseBorderStyle}">
        <Setter Property="BackgroundColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Padding" Value="20,8" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
    </Style>


    <!-- BOX VIEW (Separators) -->
    <Style TargetType="BoxView">
        <Setter Property="BackgroundColor" Value="{DynamicResource SeparatorColor}" />
    </Style>


    <!-- SCROLL VIEW -->
    <Style TargetType="ScrollView">
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>


    <!-- ACTIVITY INDICATOR (Loading) -->
    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource AccentColor}" />
    </Style>


    <!-- COLLECTION VIEW -->
    <Style TargetType="CollectionView">
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>


    <!-- IMAGE -->
    <Style TargetType="Image">
        <Setter Property="Aspect" Value="AspectFill" />
    </Style>

</ResourceDictionary>
<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:mashin.Views.Desktop.Behaviors">

    <!-- ============================================ -->
    <!-- BASE PAGE & SHELL STYLES                     -->
    <!-- ============================================ -->

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{DynamicResource BackgroundPrimary}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource BackgroundSecondary}" />
        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Shell.TitleColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Shell.DisabledColor" Value="{DynamicResource TextTertiary}" />
        <Setter Property="Shell.UnselectedColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{DynamicResource BackgroundSecondary}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource AccentColor}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{DynamicResource TextSecondary}" />
    </Style>

    <!-- ============================================ -->
    <!-- NAV (SIDEBAR) STYLES                         -->
    <!-- ============================================ -->

    <Style TargetType="Border" x:Key="NavItemBorder">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="behaviors:HoverBehavior.HoverBackgroundColor" Value="{DynamicResource HoverBackground}" />
        <Setter Property="behaviors:HoverBehavior.BaseBackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="Label" x:Key="NavItemText">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- ============================================ -->
    <!-- LABEL STYLES                                 -->
    <!-- ============================================ -->

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Label" x:Key="Headline">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>

    <Style TargetType="Label" x:Key="SubHeadline">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>

    <Style TargetType="Label" x:Key="SidebarItem">
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- ============================================ -->
    <!-- ENTRY & SEARCH STYLES                        -->
    <!-- ============================================ -->

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="14" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextTertiary}" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextTertiary}" />
        <Setter Property="CancelButtonColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
    </Style>

    <!-- ============================================ -->
    <!-- BUTTON STYLES                                -->
    <!-- ============================================ -->

    <Style TargetType="Button">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BackgroundColor" Value="{StaticResource AccentColor}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
    </Style>

    <!-- ============================================ -->
    <!-- BORDER STYLES                                -->
    <!-- ============================================ -->

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeShape" Value="Rectangle"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="BackgroundColor" Value="Transparent"/>
    </Style>

    <!-- ============================================ -->
    <!-- BOX VIEW (Separators)                        -->
    <!-- ============================================ -->

    <Style TargetType="BoxView">
        <Setter Property="BackgroundColor" Value="{DynamicResource SeparatorColor}" />
    </Style>

    <!-- ============================================ -->
    <!-- SCROLL VIEW                                  -->
    <!-- ============================================ -->

    <Style TargetType="ScrollView">
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <!-- ============================================ -->
    <!-- ACTIVITY INDICATOR (Loading)                 -->
    <!-- ============================================ -->

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource AccentColor}" />
    </Style>

    <!-- ============================================ -->
    <!-- COLLECTION VIEW                              -->
    <!-- ============================================ -->

    <Style TargetType="CollectionView">
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <!-- ============================================ -->
    <!-- IMAGE                                        -->
    <!-- ============================================ -->

    <Style TargetType="Image">
        <Setter Property="Aspect" Value="AspectFill" />
    </Style>

</ResourceDictionary>